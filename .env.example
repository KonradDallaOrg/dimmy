# Telemetry secrets — copy this file to `.env.local` for local dev and
# fill in the real values. `.env.local` is gitignored.
#
# In CI these come from GitHub Secrets, never from a checked-in file.

# PostHog write-only project key (phc_…). EU region.
# Without this, the telemetry client compiles but stays disabled at
# runtime (logs "telemetry disabled: no API key compiled in").
POSTHOG_API_KEY=

# Sentry DSN (https://…@…ingest.de.sentry.io/…). EU region.
# Without this, Sentry init is a no-op.
SENTRY_DSN=
