<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Dimmy.Windows.Views.Controls.WaveformControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Height="18" Width="40" VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- Bars mode (7 vertical bars) -->
        <StackPanel x:Name="BarsPanel" Orientation="Horizontal" Spacing="3"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border x:Name="Bar0" Width="3" CornerRadius="1.5" Background="#E6FFFFFF" Height="3" VerticalAlignment="Bottom" />
            <Border x:Name="Bar1" Width="3" CornerRadius="1.5" Background="#E6FFFFFF" Height="5" VerticalAlignment="Bottom" />
            <Border x:Name="Bar2" Width="3" CornerRadius="1.5" Background="#E6FFFFFF" Height="8" VerticalAlignment="Bottom" />
            <Border x:Name="Bar3" Width="3" CornerRadius="1.5" Background="#E6FFFFFF" Height="16" VerticalAlignment="Bottom" />
            <Border x:Name="Bar4" Width="3" CornerRadius="1.5" Background="#E6FFFFFF" Height="8" VerticalAlignment="Bottom" />
            <Border x:Name="Bar5" Width="3" CornerRadius="1.5" Background="#E6FFFFFF" Height="5" VerticalAlignment="Bottom" />
            <Border x:Name="Bar6" Width="3" CornerRadius="1.5" Background="#E6FFFFFF" Height="3" VerticalAlignment="Bottom" />
        </StackPanel>

        <!-- Line mode (polyline canvas) -->
        <Canvas x:Name="LineCanvas" Visibility="Collapsed" />

        <!-- Dots mode (5 pulsing circles) -->
        <StackPanel x:Name="DotsPanel" Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <Ellipse x:Name="Dot0" Width="4" Height="4" Fill="#E6FFFFFF" />
            <Ellipse x:Name="Dot1" Width="5" Height="5" Fill="#E6FFFFFF" />
            <Ellipse x:Name="Dot2" Width="6" Height="6" Fill="#E6FFFFFF" />
            <Ellipse x:Name="Dot3" Width="5" Height="5" Fill="#E6FFFFFF" />
            <Ellipse x:Name="Dot4" Width="4" Height="4" Fill="#E6FFFFFF" />
        </StackPanel>
    </Grid>
</UserControl>
