<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dimmy.Windows.Views.PillWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Dimmy.Windows.Views.Controls">

    <Grid x:Name="RootGrid" Background="Transparent" Padding="20">
        <!-- Pill container: 280×56 content + 20px glow padding each side = 320×96 -->
        <Border x:Name="PillBorder" CornerRadius="14" Padding="12,8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="280" MinHeight="56"
                PointerPressed="Pill_PointerPressed"
                PointerMoved="Pill_PointerMoved"
                PointerReleased="Pill_PointerReleased">
            <Border.Background>
                <AcrylicBrush TintColor="#202020" TintOpacity="0.7" FallbackColor="#333333" />
            </Border.Background>

            <Grid>
                <!-- Idle state -->
                <StackPanel x:Name="IdlePanel" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center"
                            Visibility="Visible">
                    <!-- Style dot -->
                    <Ellipse x:Name="StyleDot" Width="8" Height="8" />
                    <!-- Device name -->
                    <TextBlock x:Name="DeviceText" FontSize="12"
                               Foreground="#99FFFFFF" VerticalAlignment="Center" />
                    <!-- Spacer -->
                    <Border Width="1" />
                    <!-- Settings gear -->
                    <Button x:Name="GearButton" Background="Transparent" Padding="4"
                            Click="Settings_Click">
                        <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="#99FFFFFF" />
                    </Button>
                </StackPanel>

                <!-- Recording state -->
                <StackPanel x:Name="RecordingPanel" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <controls:WaveformControl x:Name="Waveform" Width="50" Height="20" />
                    <TextBlock x:Name="TimerText" FontSize="14" Foreground="White"
                               VerticalAlignment="Center" Text="00:00" />
                    <!-- Stop button (toggle mode only) -->
                    <Button x:Name="StopButton" Background="Transparent" Padding="2"
                            Visibility="Collapsed" Click="Stop_Click">
                        <Border Width="12" Height="12" Background="White" CornerRadius="2.5" />
                    </Button>
                </StackPanel>

                <!-- Transcribing state -->
                <StackPanel x:Name="TranscribingPanel" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="16" Height="16" />
                    <TextBlock Text="Transcribing..." FontSize="13" Foreground="White" />
                    <TextBlock x:Name="ChunkText" FontSize="11" Foreground="#99FFFFFF" />
                </StackPanel>

                <!-- Processing state -->
                <StackPanel x:Name="ProcessingPanel" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="16" Height="16" />
                    <TextBlock Text="Processing..." FontSize="13" Foreground="White" />
                </StackPanel>

                <!-- Completing state -->
                <StackPanel x:Name="CompletingPanel" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <FontIcon x:Name="CheckIcon" Glyph="&#xE73E;" FontSize="16"
                              Foreground="#4ade80" />
                </StackPanel>

                <!-- Error state -->
                <StackPanel x:Name="ErrorPanel" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#ef4444"
                               MaxWidth="250" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
