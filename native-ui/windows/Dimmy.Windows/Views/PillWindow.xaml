<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dimmy.Windows.Views.PillWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Dimmy.Windows.Views.Controls">

    <Grid x:Name="RootGrid" Background="Transparent" Padding="10">
        <!-- RainbowBorder wraps PillBorder — its Padding creates the visible border gap.
             Recording: Padding=2 + rainbow gradient Background.
             Completing: Padding=0 + green BorderBrush/BorderThickness.
             All other states: Padding=0, no background/border — invisible wrapper. -->
        <Border x:Name="RainbowBorder" CornerRadius="20" Padding="0"
                HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Main pill content: height ~36px → CornerRadius=18 for stadium shape -->
            <Border x:Name="PillBorder" CornerRadius="18" Padding="16,8"
                    PointerPressed="Pill_PointerPressed"
                    PointerMoved="Pill_PointerMoved"
                    PointerReleased="Pill_PointerReleased"
                    PointerEntered="Pill_PointerEntered"
                    PointerExited="Pill_PointerExited">
                <Border.Background>
                    <AcrylicBrush TintColor="#1a1a1a" TintOpacity="0.85" FallbackColor="#1a1a1a" />
                </Border.Background>

                <Grid>
                    <!-- Idle state -->
                    <StackPanel x:Name="IdlePanel" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" Visibility="Visible">
                        <Ellipse x:Name="StyleDot" Width="8" Height="8" />
                        <TextBlock x:Name="DeviceText" FontSize="11"
                                   Foreground="#88FFFFFF" VerticalAlignment="Center" />
                        <TextBlock x:Name="LanguageLabel" FontSize="10"
                                   Foreground="#66FFFFFF" VerticalAlignment="Center"
                                   Visibility="Collapsed" Margin="4,0,0,0" />
                        <TextBlock x:Name="ShortcutLabel" FontSize="10"
                                   Foreground="#66FFFFFF" VerticalAlignment="Center"
                                   Visibility="Collapsed" Margin="4,0,0,0" />
                        <Button x:Name="GearButton" Background="Transparent" Padding="2"
                                BorderThickness="0" Click="Settings_Click" MinWidth="0" MinHeight="0">
                            <FontIcon Glyph="&#xE713;" FontSize="12" Foreground="#88FFFFFF" />
                        </Button>
                    </StackPanel>

                    <!-- Recording state -->
                    <StackPanel x:Name="RecordingPanel" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <controls:WaveformControl x:Name="Waveform" Width="40" Height="18" />
                        <TextBlock x:Name="TimerText" FontSize="13" Foreground="#EEFFFFFF"
                                   VerticalAlignment="Center" Text="00:00" FontWeight="SemiBold" />
                        <Button x:Name="StopButton" Background="Transparent" Padding="2"
                                BorderThickness="0" Visibility="Collapsed" Click="Stop_Click"
                                MinWidth="0" MinHeight="0">
                            <Border Width="10" Height="10" Background="#EEFFFFFF" CornerRadius="2" />
                        </Button>
                    </StackPanel>

                    <!-- Transcribing state -->
                    <StackPanel x:Name="TranscribingPanel" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <ProgressRing IsActive="True" Width="14" Height="14" />
                        <TextBlock Text="Transcribing..." FontSize="12" Foreground="#EEFFFFFF" />
                        <TextBlock x:Name="ChunkText" FontSize="10" Foreground="#88FFFFFF" />
                    </StackPanel>

                    <!-- Processing state -->
                    <StackPanel x:Name="ProcessingPanel" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <ProgressRing IsActive="True" Width="14" Height="14" />
                        <TextBlock Text="Processing..." FontSize="12" Foreground="#EEFFFFFF" />
                    </StackPanel>

                    <!-- Completing state -->
                    <StackPanel x:Name="CompletingPanel" Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <FontIcon x:Name="CheckIcon" Glyph="&#xE73E;" FontSize="14"
                                  Foreground="#4ade80" />
                    </StackPanel>

                    <!-- Error state -->
                    <StackPanel x:Name="ErrorPanel" Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText" FontSize="11" Foreground="#ef4444"
                                   MaxWidth="200" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
