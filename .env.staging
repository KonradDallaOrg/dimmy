# .env.staging — committed, public values only.
#
# These two values are paired with the staging Worker at
# license-staging.dimmy.app. Both are public:
#   - The Ed25519 PUBLIC key is by definition shareable.
#   - The Worker URL is HTTPS-served on a public DNS record.
# The matching PRIVATE key lives ONLY in Cloudflare staging secrets
# (set via `wrangler secret put DIMMY_LICENSE_PRIVKEY --env staging`)
# and a 1Password backup. NEVER commit it.
#
# Use via the wrapper scripts in scripts/build-staging.{sh,ps1} which
# `source` this file before invoking cargo. A direct `cargo build` with
# no env exported produces a debug binary in Unrestricted mode (no
# licensing UI engaged) — fine for non-license work.

# TODO(konrad, after `node generate-keypair.js` in WSL):
#   replace REPLACE_WITH_STAGING_PUBKEY with the printed pubkey value.
DIMMY_LICENSE_PUBKEY=REPLACE_WITH_STAGING_PUBKEY
DIMMY_LICENSE_SERVER_URL=https://license-staging.dimmy.app
