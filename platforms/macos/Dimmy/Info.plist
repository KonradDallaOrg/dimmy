<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSUIElement</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Dimmy needs microphone access to transcribe your voice.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Dimmy uses Apple Events to paste transcribed text into the active application.</string>
	<!--
	Custom URL scheme `dimmy://` so activation magic-link emails can
	deep-link into the app. AppDelegate.application(_:open:options:)
	receives the URL and calls into the licensing layer to redeem the
	activation code. See docs/dev/licensing-prod.md.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.dimmy.activation</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dimmy</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
		</dict>
	</array>
	<!--
	macOS Services menu entry. Users can right-click any selected text
	in any app and pick Services → "Add to Dimmy Dictionary" to boost
	that word's recognition on future transcriptions. NSMessage
	matches AppDelegate.addToDimmyDictionary — the OS pre-fills the
	pasteboard with the user's selection, so we skip the synthetic
	Cmd+C dance the global hotkey path uses. NSSendTypes restricts the
	entry to text selections (NSStringPboardType).
	-->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Add to Dimmy Dictionary</string>
			</dict>
			<key>NSMessage</key>
			<string>addToDimmyDictionary</string>
			<key>NSPortName</key>
			<string>Dimmy</string>
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
	<!--
	Sparkle 2 auto-update keys.

	SUFeedURL  — the appcast XML we publish alongside each macOS DMG
	             on GitHub releases. `latest` always points at the most
	             recent release, so the app polls a stable URL while
	             release.yml rewrites the content on each cut.

	SUPublicEDKey — the EdDSA public key matching the private key that
	             signs each DMG inside release.yml (`sign_update`). Set
	             on 2026-05-12; the matching private lives in the
	             SPARKLE_PRIVATE_KEY GitHub secret.

	SUEnableInstallerLauncherService — required by Sparkle 2 for the
	             XPC helper that swaps the .app at install time when
	             the running process can't write to its own bundle.
	-->
	<key>SUFeedURL</key>
	<string>https://github.com/KonradDallaOrg/dimmy/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>mdIhsIeyR1qlZ+MNSaWSVIaVJ2tWvLwHMZYeAGDI5i8=</string>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>21600</integer>
</dict>
</plist>
