<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.screencapture</key>
	<true/>
	<!-- Hardened runtime (required for Apple notarization) refuses to load
	     dylibs not signed by the same Team ID. Dimmy dlopens bundled ML
	     dylibs (libllama/libggml*, libonnxruntime) at runtime; this lets the
	     notarized app load them. Inert on ad-hoc / non-hardened-runtime
	     builds (entitlement only enforced under hardened runtime). -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
