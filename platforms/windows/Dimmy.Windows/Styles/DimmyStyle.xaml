<?xml version="1.0" encoding="utf-8"?>
<!-- The app style: one type scale, one spacing scale, one card. Built on the
     Fluent type ramp and theme brushes, so light, dark and high contrast keep
     working. New UI uses these keys instead of a FontSize or Padding of its own. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spacing -->
    <x:Double x:Key="DimmySpaceXS">4</x:Double>
    <x:Double x:Key="DimmySpaceS">8</x:Double>
    <x:Double x:Key="DimmySpaceM">12</x:Double>
    <x:Double x:Key="DimmySpaceL">16</x:Double>
    <x:Double x:Key="DimmySpaceXL">24</x:Double>
    <Thickness x:Key="DimmyCardPadding">20,16,20,16</Thickness>
    <CornerRadius x:Key="DimmyCardRadius">8</CornerRadius>

    <!-- Type scale -->
    <Style x:Key="DimmyPageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}" />
    <Style x:Key="DimmyHeadline" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}" />
    <Style x:Key="DimmySection" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,24,0,8" />
    </Style>
    <Style x:Key="DimmyCardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
    <Style x:Key="DimmyBody" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}" />
    <Style x:Key="DimmySecondary" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="DimmyCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="DimmyStat" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}" />
    <Style x:Key="DimmyTimestamp" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="DimmyCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource DimmyCardRadius}" />
        <Setter Property="Padding" Value="{StaticResource DimmyCardPadding}" />
    </Style>
    <Style x:Key="DimmyDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="DimmyStatusButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,6,8,6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
</ResourceDictionary>
