<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Dimmy.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\dimmy.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Unpackaged app, but MrtCore PRI generation MUST run. Without resources.pri
         the ms-appx:/// URIs used by InitializeComponent() can't resolve the XBF,
         so every Window throws XamlParseException and the process runs headless.
         EnableMsixTooling=true pulls in MrtCore even with AppxPackage=false. -->
    <AppxPackage>false</AppxPackage>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <!-- MrtCore's PRI tasks live in the VS AppxPackage workload, not the dotnet SDK.
       `dotnet publish` / `dotnet build` won't find Microsoft.Build.Packaging.Pri.Tasks.dll
       unless we point AppxMSBuildToolsPath at a VS install. This PropertyGroup probes
       the common locations; CI may also pass -p:AppxMSBuildToolsPath=... to override.
       Evaluation order matters: UsingTask in MrtCore.PriGen.targets reads this at
       import time, so it MUST be set via PropertyGroup (not Target). -->
  <PropertyGroup Condition="'$(AppxMSBuildToolsPath)' == ''">
    <_VsAppxPath17Enterprise>$(ProgramFiles)\Microsoft Visual Studio\2022\Enterprise\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</_VsAppxPath17Enterprise>
    <_VsAppxPath17Professional>$(ProgramFiles)\Microsoft Visual Studio\2022\Professional\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</_VsAppxPath17Professional>
    <_VsAppxPath17Community>$(ProgramFiles)\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</_VsAppxPath17Community>
    <_VsAppxPath17BuildTools>$(ProgramFiles)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</_VsAppxPath17BuildTools>
    <_VsAppxPath18Community>$(ProgramFiles)\Microsoft Visual Studio\18\Community\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\</_VsAppxPath18Community>
    <_VsAppxPath18Professional>$(ProgramFiles)\Microsoft Visual Studio\18\Professional\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\</_VsAppxPath18Professional>
    <_VsAppxPath18Enterprise>$(ProgramFiles)\Microsoft Visual Studio\18\Enterprise\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\</_VsAppxPath18Enterprise>
    <AppxMSBuildToolsPath Condition="Exists('$(_VsAppxPath17Enterprise)Microsoft.Build.Packaging.Pri.Tasks.dll')">$(_VsAppxPath17Enterprise)</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(_VsAppxPath17Professional)Microsoft.Build.Packaging.Pri.Tasks.dll')">$(_VsAppxPath17Professional)</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(_VsAppxPath17Community)Microsoft.Build.Packaging.Pri.Tasks.dll')">$(_VsAppxPath17Community)</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(_VsAppxPath17BuildTools)Microsoft.Build.Packaging.Pri.Tasks.dll')">$(_VsAppxPath17BuildTools)</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(_VsAppxPath18Community)Microsoft.Build.Packaging.Pri.Tasks.dll')">$(_VsAppxPath18Community)</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(_VsAppxPath18Professional)Microsoft.Build.Packaging.Pri.Tasks.dll')">$(_VsAppxPath18Professional)</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(_VsAppxPath18Enterprise)Microsoft.Build.Packaging.Pri.Tasks.dll')">$(_VsAppxPath18Enterprise)</AppxMSBuildToolsPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.2.0" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="Markdig" Version="0.40.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\dimmy.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\dimmy-taskbar.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\dimmy-tray-*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\dimmy-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Providers\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\notion-mark*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Copy dimmy_lib.dll from Rust build output to bin dir -->
  <Target Name="CopyDimmyDll" AfterTargets="Build">
    <PropertyGroup>
      <DimmyDllSource>$(MSBuildThisFileDirectory)..\..\..\core\target\release\dimmy_lib.dll</DimmyDllSource>
    </PropertyGroup>
    <Copy SourceFiles="$(DimmyDllSource)" DestinationFolder="$(OutputPath)" Condition="Exists('$(DimmyDllSource)')" SkipUnchangedFiles="true" />
    <Warning Text="dimmy_lib.dll not found at $(DimmyDllSource). Run 'cargo build --release --lib' in core first." Condition="!Exists('$(DimmyDllSource)')" />
  </Target>

  <!-- Copy onnxruntime.dll alongside dimmy_lib.dll when the Parakeet local-STT
       backend is enabled. The DLL is fetched once by scripts/download-onnxruntime.ps1
       (or downloaded manually) into core/target/onnxruntime-win-x64-<ver>/lib/.
       Conditional on Exists(): if the file isn't there (Parakeet feature off,
       or the script wasn't run), this target is a no-op and the build still
       succeeds — backward-compatible. Velopack picks the OutputPath snapshot,
       so the DLL ends up in the installer next to dimmy_lib.dll automatically. -->
  <Target Name="CopyOrtDll" AfterTargets="Build">
    <PropertyGroup>
      <!-- Pin must track the ort crate. ort 2.0.0-rc.10 → onnxruntime 1.22.0. -->
      <OrtVersion>1.22.0</OrtVersion>
      <OrtDllSource>$(MSBuildThisFileDirectory)..\..\..\core\target\onnxruntime-win-x64-$(OrtVersion)\lib\onnxruntime.dll</OrtDllSource>
      <OrtProvidersSharedSource>$(MSBuildThisFileDirectory)..\..\..\core\target\onnxruntime-win-x64-$(OrtVersion)\lib\onnxruntime_providers_shared.dll</OrtProvidersSharedSource>
    </PropertyGroup>
    <Copy SourceFiles="$(OrtDllSource)" DestinationFolder="$(OutputPath)" Condition="Exists('$(OrtDllSource)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OrtProvidersSharedSource)" DestinationFolder="$(OutputPath)" Condition="Exists('$(OrtProvidersSharedSource)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
