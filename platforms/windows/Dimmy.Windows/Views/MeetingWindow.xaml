<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dimmy.Windows.Views.MeetingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Dimmy Meeting">

  <!-- Split-pane meeting window. Sidebar with meetings list on the
       left (always visible — the "main UI" the user inhabits, not a
       hidden tab); state-driven main panel on the right.
       Recording / Processing / Done show in the main panel; selecting
       a past meeting from the sidebar opens its detail in the main
       panel. While a recording is active, sidebar clicks on past
       meetings are intercepted (toast notification) so the user
       cannot accidentally hide the Stop button — that was the
       "zombie recording" bug from the previous layout. -->
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- titlebar -->
      <RowDefinition Height="*"/>     <!-- body -->
    </Grid.RowDefinitions>

    <!-- ── TITLE BAR ── -->
    <Grid Grid.Row="0" Padding="20,12,20,12" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                  VerticalAlignment="Center">
        <FontIcon Glyph="&#xE720;" FontSize="18"
                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
        <TextBlock Text="Dimmy Meeting" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock x:Name="TitlebarTitle" Grid.Column="1"
                 Text="New meeting" FontSize="13"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 TextTrimming="CharacterEllipsis"/>
      <!-- Always-visible escape hatch: lets the user return to Idle
           from Done state (i.e. after browsing a past meeting) without
           having to find the small + button in the sidebar header. -->
      <Button Grid.Column="2" x:Name="TitlebarNewBtn" Click="NewMeeting_Click"
              ToolTipService.ToolTip="Start a new meeting"
              Padding="12,6">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE710;" FontSize="13"/>
          <TextBlock Text="New meeting" FontSize="13"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- ── BODY: split pane ── -->
    <Grid Grid.Row="1" ColumnSpacing="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>  <!-- sidebar -->
        <ColumnDefinition Width="*"/>    <!-- main -->
      </Grid.ColumnDefinitions>

      <!-- ── SIDEBAR ── -->
      <Border Grid.Column="0"
              BorderThickness="0,1,1,0"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
              Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
        <Grid RowSpacing="10" Padding="14,12,14,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="Auto"/>  <!-- new-meeting CTA -->
            <RowDefinition Height="Auto"/>  <!-- search -->
            <RowDefinition Height="*"/>     <!-- list -->
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="Meetings"
                     FontSize="16" FontWeight="SemiBold"/>

          <Button Grid.Row="1" x:Name="NewMeetingHeaderBtn"
                  Click="NewMeeting_Click"
                  Style="{ThemeResource AccentButtonStyle}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Padding="10,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE710;" FontSize="13"/>
              <TextBlock Text="New meeting" FontWeight="SemiBold"/>
            </StackPanel>
          </Button>

          <TextBox Grid.Row="2" x:Name="HistorySearchBox"
                   PlaceholderText="Search past meetings…"
                   TextChanged="HistorySearch_Changed"/>

          <ListView Grid.Row="3" x:Name="HistoryList" SelectionMode="Single"
                    SelectionChanged="HistoryList_SelectionChanged">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <!-- Left pad 12px so the WinUI-default left-edge selection
                     indicator (4px accent stripe) has room to render, AND
                     so item text doesn't kiss the sidebar edge on hover /
                     selection. Vertical pad kept at 4px to preserve density. -->
                <Setter Property="Padding" Value="12,4"/>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid ColumnSpacing="8" Padding="6,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <!-- Win11-style left-edge accent stripe. WinUI 3's
                       default ListViewItem doesn't ship one (only
                       NavigationView does); we synthesise it with an
                       absolutely-positioned Border. Negative left margin
                       bleeds into the ListViewItem's 12 px padding so
                       the bar sits flush with the sidebar edge.
                       Visibility tracks `IsActive` on the bound HistoryRow
                       — set from code-behind HistoryList_SelectionChanged
                       (WinUI 3 doesn't support RelativeSource AncestorType
                       so we can't bind ListViewItem.IsSelected directly). -->
                  <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                          HorizontalAlignment="Left" VerticalAlignment="Stretch"
                          Margin="-16,4,0,4"
                          Background="{ThemeResource AccentFillColorDefaultBrush}"
                          Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}"/>
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding RightLabel}"
                             FontSize="10" FontWeight="SemiBold"
                             Padding="6,2"
                             VerticalAlignment="Center"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <Button Grid.Column="2"
                          Click="HistoryRowDelete_Click"
                          DataContext="{Binding}"
                          Background="Transparent" BorderThickness="0"
                          Padding="4" MinWidth="0" MinHeight="0"
                          ToolTipService.ToolTip="Delete meeting">
                    <FontIcon Glyph="&#xE74D;" FontSize="11"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                  </Button>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>

      <!-- ── MAIN PANEL ── -->
      <Grid Grid.Column="1" Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>  <!-- recording bar (only during Recording) -->
          <RowDefinition Height="*"/>     <!-- content (state-driven) -->
        </Grid.RowDefinitions>

        <!-- Persistent recording-control bar — visible ONLY during
             Recording. Stays in the same spot regardless of which
             panel is shown below, so the user can't lose access to
             the Stop button by clicking around. -->
        <Border x:Name="RecordingBar" Grid.Row="0"
                Visibility="Collapsed"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,10">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center">
              <Ellipse Width="10" Height="10" Fill="Crimson"/>
              <TextBlock Text="Recording" FontSize="14" FontWeight="SemiBold"
                         VerticalAlignment="Center"/>
              <TextBlock x:Name="RecTimer" Text="00:00:00"
                         FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                         Foreground="Crimson" VerticalAlignment="Center"/>
              <TextBlock x:Name="RecChunks" Text=""
                         FontSize="11" VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <!-- Shown only when the user is browsing a past meeting
                   (state == Done) while recording is still in flight.
                   Tap to return to the live transcript view without
                   stopping the recording. -->
              <Button x:Name="BackToLiveBtn" Click="BackToLive_Click"
                      Visibility="Collapsed"
                      ToolTipService.ToolTip="Return to the live recording view">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon Glyph="&#xE76B;" FontSize="13"/>
                  <TextBlock Text="Back to live"/>
                </StackPanel>
              </Button>
              <Button x:Name="PauseBtn" Click="Pause_Click"
                      ToolTipService.ToolTip="Pause / resume the meeting recording">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon x:Name="PauseBtnIcon" Glyph="&#xE769;" FontSize="13"/>
                  <TextBlock x:Name="PauseBtnLabel" Text="Pause"/>
                </StackPanel>
              </Button>
              <Button x:Name="StopBtn" Click="Stop_Click"
                      Style="{ThemeResource AccentButtonStyle}"
                      Background="Crimson" Foreground="White">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon Glyph="&#xE71A;" FontSize="13"/>
                  <TextBlock Text="Stop &amp; finish"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Content area: 4 states stacked, Visibility-toggled. -->
        <Grid Grid.Row="1">

          <!-- IDLE: hero + start CTA -->
          <StackPanel x:Name="IdlePanel" Spacing="20"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="Visible">
            <Border Width="96" Height="96" CornerRadius="48"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource AccentFillColorTertiaryBrush}">
              <FontIcon Glyph="&#xE720;" FontSize="44"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Border>
            <StackPanel Spacing="6" HorizontalAlignment="Center">
              <TextBlock Text="Ready to capture" FontSize="22" FontWeight="SemiBold"
                         HorizontalAlignment="Center"/>
              <TextBlock TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center"
                         FontSize="13"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         Text="Long-form recording with structured recap. Pick an old meeting from the sidebar to review, or start a new one."/>
            </StackPanel>
            <Button x:Name="StartBtn" Click="Start_Click"
                    Style="{ThemeResource AccentButtonStyle}"
                    HorizontalAlignment="Center" Padding="20,10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE7C8;" FontSize="14"/>
                <TextBlock Text="Start meeting" FontSize="14" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>
            <CheckBox x:Name="GenerateRecapCheck" IsChecked="True"
                      HorizontalAlignment="Center"
                      Content="Generate recap + action items on stop"/>
          </StackPanel>

          <!-- RECORDING: app-context + waveform card + live transcript -->
          <Grid x:Name="RecordingPanel" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Waveform card -->
            <Border Grid.Row="0"
                    Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                  <Image x:Name="AppContextIcon" Width="22" Height="22"
                         Visibility="Collapsed"/>
                  <FontIcon x:Name="AppContextFallback" Glyph="&#xE720;" FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="Visible"/>
                  <TextBlock x:Name="AppContextName" Text="Microphone"
                             FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <Canvas x:Name="LiveWaveformCanvas" Grid.Column="1"
                        Background="Transparent" Height="44"
                        VerticalAlignment="Center"
                        SizeChanged="LiveWaveformCanvas_SizeChanged"/>
              </Grid>
            </Border>

            <!-- Live transcript -->
            <Border Grid.Row="1"
                    Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="14,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Live transcript"
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TranscriptMeta" Grid.Column="1"
                               Text="" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <ScrollViewer x:Name="TranscriptScroll" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Padding="14" Spacing="10">
                    <TextBlock x:Name="TranscriptText"
                               Text="🎙️ Listening… first chunk lands in ~15 s."
                               TextWrapping="Wrap" FontSize="14"
                               IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>

          <!-- PROCESSING: spinner + steps -->
          <StackPanel x:Name="ProcessingPanel" Spacing="20"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="Collapsed">
            <ProgressRing x:Name="ProcSpinner" IsActive="True"
                          Width="56" Height="56" HorizontalAlignment="Center"/>
            <TextBlock Text="Wrapping up…" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <StackPanel Spacing="6" HorizontalAlignment="Center" MinWidth="320">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon x:Name="ProcStep1Icon" Glyph="&#xE73E;" FontSize="14"
                          Foreground="ForestGreen"/>
                <TextBlock x:Name="ProcStep1Text" Text="Saved audio + transcripts"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon x:Name="ProcStep2Icon" Glyph="&#xE76C;" FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="ProcStep2Text" Text="Generating recap with LLM…"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon x:Name="ProcStep3Icon" Glyph="&#xE76C;" FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="ProcStep3Text" Text="Extracting action items"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!-- DONE: meeting detail (also reused when sidebar selects a past meeting) -->
          <ScrollViewer x:Name="DonePanel" Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="0,0,4,0">
            <!-- Right padding 14 leaves breathing room between card
                 borders and the vertical scrollbar; otherwise on
                 full-screen the rightmost borders hug the scrollbar
                 and look "snagged" on the window edge. -->
            <StackPanel Spacing="14" Padding="0,0,14,20">

              <!-- Title + meta line, no card, sits on the page surface.
                   Title is click-to-edit: tapping it swaps the TextBlock
                   for the TextBox; Enter or focus-loss commits the new
                   title to meta.json via FFI. -->
              <StackPanel Spacing="6" Padding="0,4,0,2">
                <Grid>
                  <TextBlock x:Name="DoneTitle" Text="Meeting"
                             FontSize="22" FontWeight="SemiBold"
                             Tapped="DoneTitle_Tapped"
                             ToolTipService.ToolTip="Click to rename"/>
                  <TextBox x:Name="DoneTitleEdit"
                           FontSize="22" FontWeight="SemiBold"
                           Visibility="Collapsed"
                           KeyDown="DoneTitleEdit_KeyDown"
                           LostFocus="DoneTitleEdit_LostFocus"/>
                </Grid>
                <TextBlock x:Name="DoneMeta" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text=""/>
              </StackPanel>

              <!-- Card containing the mirrored-stereo waveform + the
                   transport controls. Mic (blue) anchors UP from the
                   midline, system (green) anchors DOWN.
                   Theme-aware acrylic background: looks near-white on
                   Light theme + dark-tinted on Dark theme — keeps the
                   card visually consistent with the recap cards below
                   instead of a glaring white slab on dark systems.
                   The Canvas is intentionally lower-profile than v1 so
                   the recap content below stays the page's focus. -->
              <Border x:Name="DoneWaveCard"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="12" Padding="18,14,18,12"
                      Visibility="Collapsed">
                <Grid RowSpacing="10">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Height="74">
                    <Canvas x:Name="DoneWaveformCanvas"
                            Background="Transparent"
                            SizeChanged="DoneWaveformCanvas_SizeChanged"
                            PointerPressed="DoneWaveform_PointerPressed"/>
                  </Border>
                  <!-- Transport controls. The default MediaTransportControls
                       chrome is ~64-72px tall; capping at 56 cropped the
                       play/scrub row. RequestedTheme inherits from the
                       card / window so icons stay readable on Dark mode
                       (no hard Light theme — the card itself follows
                       the system now). -->
                  <MediaPlayerElement x:Name="DoneAudioPlayer" Grid.Row="1"
                                      AreTransportControlsEnabled="True"
                                      AutoPlay="False"
                                      MinHeight="64">
                    <MediaPlayerElement.TransportControls>
                      <MediaTransportControls IsCompact="True"
                                              IsZoomButtonVisible="False"/>
                    </MediaPlayerElement.TransportControls>
                  </MediaPlayerElement>
                </Grid>
              </Border>

              <!-- Tab strip + action icons. Tabs are flat with an
                   accent-color underline on the selected one. Action
                   icons live to the right of the tab row so they're
                   always visible regardless of which tab is selected. -->
              <Grid Padding="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="22">
                  <StackPanel x:Name="RecapTabHeader" Orientation="Vertical" Spacing="6"
                              Tag="recap" PointerPressed="DoneTab_PointerPressed">
                    <TextBlock x:Name="RecapTabLabel" Text="Recap"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <Rectangle x:Name="RecapTabUnderline" Height="2"
                               Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                  </StackPanel>
                  <StackPanel x:Name="TranscriptTabHeader" Orientation="Vertical" Spacing="6"
                              Tag="transcript" PointerPressed="DoneTab_PointerPressed">
                    <TextBlock x:Name="TranscriptTabLabel" Text="Transcript"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Opacity="0.6"/>
                    <Rectangle x:Name="TranscriptTabUnderline" Height="2"
                               Fill="{ThemeResource AccentFillColorDefaultBrush}"
                               Visibility="Collapsed"/>
                  </StackPanel>
                  <StackPanel x:Name="NotesTabHeader" Orientation="Vertical" Spacing="6"
                              Tag="notes" PointerPressed="DoneTab_PointerPressed">
                    <TextBlock x:Name="NotesTabLabel" Text="Notes"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Opacity="0.6"/>
                    <Rectangle x:Name="NotesTabUnderline" Height="2"
                               Fill="{ThemeResource AccentFillColorDefaultBrush}"
                               Visibility="Collapsed"/>
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center">
                  <Button x:Name="RegenTranscriptBtn" Click="RegenerateTranscript_Click"
                          ToolTipService.ToolTip="(Re)generate transcript from audio"
                          Background="Transparent" BorderThickness="0" Padding="8">
                    <FontIcon Glyph="&#xE720;" FontSize="14"/>
                  </Button>
                  <Button x:Name="RegenRecapBtn" Click="RegenerateRecap_Click"
                          ToolTipService.ToolTip="(Re)generate recap from transcript"
                          Background="Transparent" BorderThickness="0" Padding="8">
                    <FontIcon Glyph="&#xE8D4;" FontSize="14"/>
                  </Button>
                  <Button x:Name="CopyRecapBtn" Click="CopyRecap_Click"
                          ToolTipService.ToolTip="Copy recap to clipboard"
                          Background="Transparent" BorderThickness="0" Padding="8">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                  </Button>
                  <Button x:Name="SendToNotionBtn" Click="SendToNotion_Click"
                          ToolTipService.ToolTip="Send recap to Notion"
                          Background="Transparent" BorderThickness="0" Padding="8">
                    <Image Width="16" Height="16"
                           Source="{ThemeResource NotionMarkSource}"/>
                  </Button>
                  <!-- "Recap with Claude Desktop": open Claude with a
                       deeplink prompt that uses our MCP tools to read
                       the meeting + save the recap back. Visible only
                       when the MCP extension is installed; icon swapped
                       at runtime to the real Claude.exe MSIX brand mark
                       via ClaudeIconExtractor (NEVER a hand-drawn one). -->
                  <Button x:Name="RecapWithClaudeBtn" Click="RecapWithClaudeDesktop_Click"
                          ToolTipService.ToolTip="Recap with Claude Desktop (uses MCP)"
                          Visibility="Collapsed"
                          Background="Transparent" BorderThickness="0" Padding="8">
                    <Image x:Name="RecapWithClaudeIcon" Width="16" Height="16"/>
                  </Button>
                  <Button x:Name="OpenFolderBtn" Click="OpenFolder_Click"
                          ToolTipService.ToolTip="Open meeting folder"
                          Background="Transparent" BorderThickness="0" Padding="8">
                    <FontIcon Glyph="&#xE838;" FontSize="14"/>
                  </Button>
                </StackPanel>
              </Grid>

              <!-- Tab content: only one panel is visible at a time.
                   Code-behind DoneTab_PointerPressed swaps Visibility. -->

              <StackPanel x:Name="RecapTabPanel" Spacing="14">

              <!-- Setting / context — the LLM's read on the meeting's
                   shape (kickoff? status sync? brainstorm?). Skipped
                   in the prompt before but reintroduced as a small
                   pre-TLDR card so the user sees the LLM's framing
                   before the bullets. -->
              <Border x:Name="ContextCard" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE946;" FontSize="14"/>
                    <TextBlock Text="Context" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                  <RichTextBlock x:Name="ContextText" TextWrapping="Wrap" FontSize="13"
                                 IsTextSelectionEnabled="True"/>
                </StackPanel>
              </Border>

              <Border x:Name="TldrCard" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                      BorderThickness="2" CornerRadius="8" Padding="14">
                <StackPanel Spacing="6">
                  <TextBlock Text="TL;DR" FontSize="11" FontWeight="SemiBold"
                             CharacterSpacing="80"
                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                  <RichTextBlock x:Name="TldrText" TextWrapping="Wrap" FontSize="14"
                                 IsTextSelectionEnabled="True"/>
                  <Button x:Name="OpenRecapSettingsButton"
                          Visibility="Collapsed"
                          Margin="0,6,0,0"
                          Content="Open Recap settings"
                          Click="OpenRecapSettings_Click"/>
                </StackPanel>
              </Border>

              <!-- Pivotal moments timeline, MM:SS-anchored. Reintroduced
                   alongside TLDR so the user can jump to the inflection
                   points in the audio. -->
              <Border x:Name="HighlightsCard" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE735;" FontSize="14"/>
                    <TextBlock Text="Highlights" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                  <RichTextBlock x:Name="HighlightsText" TextWrapping="Wrap" FontSize="13"
                                 IsTextSelectionEnabled="True"/>
                </StackPanel>
              </Border>

              <!-- Long-form narrative (2-4 paragraphs of prose). This is
                   THE section senior stakeholders read instead of the
                   recording. Lives near the top because it's the
                   highest-density artefact in the recap. -->
              <Border x:Name="NarrativeCard" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                    <TextBlock Text="Narrative" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                  <RichTextBlock x:Name="NarrativeText" TextWrapping="Wrap" FontSize="13"
                                 IsTextSelectionEnabled="True"/>
                </StackPanel>
              </Border>

              <Border x:Name="DecisionsCard" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="ForestGreen"/>
                    <TextBlock Text="Key decisions" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                  <RichTextBlock x:Name="DecisionsText" TextWrapping="Wrap" FontSize="13"
                                 IsTextSelectionEnabled="True"/>
                </StackPanel>
              </Border>

              <Border x:Name="TopicsCard" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8FD;" FontSize="14"/>
                    <TextBlock Text="Topics discussed" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                  <RichTextBlock x:Name="TopicsText" TextWrapping="Wrap" FontSize="13"
                                 IsTextSelectionEnabled="True"/>
                </StackPanel>
              </Border>

              <Border x:Name="ActionsCard" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE762;" FontSize="14" Foreground="DarkOrange"/>
                    <TextBlock Text="Action items" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                  <RichTextBlock x:Name="ActionsText" TextWrapping="Wrap" FontSize="13"
                                 IsTextSelectionEnabled="True"/>
                </StackPanel>
              </Border>

              <Border x:Name="OpenQuestionsCard" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9CE;" FontSize="14"/>
                    <TextBlock Text="Open questions" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                  <RichTextBlock x:Name="OpenQuestionsText" TextWrapping="Wrap" FontSize="13"
                                 IsTextSelectionEnabled="True"/>
                </StackPanel>
              </Border>

              <Border x:Name="RisksCard" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7BA;" FontSize="14"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <TextBlock Text="Risks &amp; blockers" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                  <RichTextBlock x:Name="RisksText" TextWrapping="Wrap" FontSize="13"
                                 IsTextSelectionEnabled="True"/>
                </StackPanel>
              </Border>

              <Border x:Name="NextStepsCard" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE893;" FontSize="14"/>
                    <TextBlock Text="Next steps" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                  <RichTextBlock x:Name="NextStepsText" TextWrapping="Wrap" FontSize="13"
                                 IsTextSelectionEnabled="True"/>
                </StackPanel>
              </Border>

              <!-- Things to ASK / CLARIFY offline. Lives at the bottom
                   because it's the "after this meeting" section. -->
              <Border x:Name="FollowupsCard" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE715;" FontSize="14"/>
                    <TextBlock Text="Follow-ups" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                  <RichTextBlock x:Name="FollowupsText" TextWrapping="Wrap" FontSize="13"
                                 IsTextSelectionEnabled="True"/>
                </StackPanel>
              </Border>

              </StackPanel>
              <!-- /RecapTabPanel -->

              <!-- Transcript tab — the raw transcript that was the
                   Expander in v1, now full-height inside the tab. -->
              <Border x:Name="TranscriptTabPanel" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14">
                <RichTextBlock x:Name="RawTranscriptText" TextWrapping="Wrap"
                               FontSize="13" LineHeight="22"
                               IsTextSelectionEnabled="True"/>
              </Border>

              <!-- Notes tab — user-typed scratchpad. Local-only for
                   now; future: prepended to the recap LLM prompt so
                   the user can steer the recap with context. -->
              <StackPanel x:Name="NotesTabPanel" Visibility="Collapsed" Spacing="8">
                <TextBlock Text="Your notes for this meeting"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="NotesBox"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="180"
                         PlaceholderText="Add context, attendees, decisions you want surfaced in the recap. (Not yet sent to the LLM — UI only for now.)"
                         LostFocus="NotesBox_LostFocus"/>
                <TextBlock x:Name="NotesHint"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Text="Saved alongside the meeting in notes.md."/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>

    <!-- Toast for blocked-history-during-recording -->
    <Border x:Name="ToastBar" Grid.Row="1" Visibility="Collapsed"
            HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="0,0,0,20"
            Background="#E8000000"
            CornerRadius="6" Padding="14,8">
      <TextBlock x:Name="ToastText" Foreground="White" FontSize="13"
                 Text=""/>
    </Border>
  </Grid>
</Window>
