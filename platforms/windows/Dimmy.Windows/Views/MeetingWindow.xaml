<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dimmy.Windows.Views.MeetingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Dimmy Meeting">

  <!-- Split-pane meeting window. Sidebar with meetings list on the
       left (always visible — the "main UI" the user inhabits, not a
       hidden tab); state-driven main panel on the right.
       Recording / Processing / Done show in the main panel; selecting
       a past meeting from the sidebar opens its detail in the main
       panel. While a recording is active, sidebar clicks on past
       meetings are intercepted (toast notification) so the user
       cannot accidentally hide the Stop button — that was the
       "zombie recording" bug from the previous layout. -->
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- titlebar -->
      <RowDefinition Height="*"/>     <!-- body -->
    </Grid.RowDefinitions>

    <!-- ── TITLE BAR ── -->
    <Grid Grid.Row="0" Padding="20,12,20,12" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                  VerticalAlignment="Center">
        <FontIcon Glyph="&#xE720;" FontSize="18"
                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
        <TextBlock Text="Dimmy Meeting" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock x:Name="TitlebarTitle" Grid.Column="1"
                 Text="New meeting" FontSize="13"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 TextTrimming="CharacterEllipsis"/>
      <!-- Always-visible escape hatch: lets the user return to Idle
           from Done state (i.e. after browsing a past meeting) without
           having to find the small + button in the sidebar header. -->
      <Button Grid.Column="2" x:Name="TitlebarNewBtn" Click="NewMeeting_Click"
              ToolTipService.ToolTip="Start a new meeting"
              Padding="12,6">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE710;" FontSize="13"/>
          <TextBlock Text="New meeting" FontSize="13"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- ── BODY: split pane ── -->
    <Grid Grid.Row="1" ColumnSpacing="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>  <!-- sidebar -->
        <ColumnDefinition Width="*"/>    <!-- main -->
      </Grid.ColumnDefinitions>

      <!-- ── SIDEBAR ── -->
      <Border Grid.Column="0"
              BorderThickness="0,1,1,0"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
              Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
        <Grid RowSpacing="10" Padding="14,12,14,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="Auto"/>  <!-- new-meeting CTA -->
            <RowDefinition Height="Auto"/>  <!-- search -->
            <RowDefinition Height="*"/>     <!-- list -->
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="Meetings"
                     FontSize="16" FontWeight="SemiBold"/>

          <Button Grid.Row="1" x:Name="NewMeetingHeaderBtn"
                  Click="NewMeeting_Click"
                  Style="{ThemeResource AccentButtonStyle}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Padding="10,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE710;" FontSize="13"/>
              <TextBlock Text="New meeting" FontWeight="SemiBold"/>
            </StackPanel>
          </Button>

          <TextBox Grid.Row="2" x:Name="HistorySearchBox"
                   PlaceholderText="Search past meetings…"
                   TextChanged="HistorySearch_Changed"/>

          <ListView Grid.Row="3" x:Name="HistoryList" SelectionMode="Single"
                    SelectionChanged="HistoryList_SelectionChanged">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0,4"/>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid ColumnSpacing="8" Padding="6,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding RightLabel}"
                             FontSize="10" FontWeight="SemiBold"
                             Padding="6,2"
                             VerticalAlignment="Center"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <Button Grid.Column="2"
                          Click="HistoryRowDelete_Click"
                          DataContext="{Binding}"
                          Background="Transparent" BorderThickness="0"
                          Padding="4" MinWidth="0" MinHeight="0"
                          ToolTipService.ToolTip="Delete meeting">
                    <FontIcon Glyph="&#xE74D;" FontSize="11"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                  </Button>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>

      <!-- ── MAIN PANEL ── -->
      <Grid Grid.Column="1" Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>  <!-- recording bar (only during Recording) -->
          <RowDefinition Height="*"/>     <!-- content (state-driven) -->
        </Grid.RowDefinitions>

        <!-- Persistent recording-control bar — visible ONLY during
             Recording. Stays in the same spot regardless of which
             panel is shown below, so the user can't lose access to
             the Stop button by clicking around. -->
        <Border x:Name="RecordingBar" Grid.Row="0"
                Visibility="Collapsed"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,10">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center">
              <Ellipse Width="10" Height="10" Fill="Crimson"/>
              <TextBlock Text="Recording" FontSize="14" FontWeight="SemiBold"
                         VerticalAlignment="Center"/>
              <TextBlock x:Name="RecTimer" Text="00:00:00"
                         FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                         Foreground="Crimson" VerticalAlignment="Center"/>
              <TextBlock x:Name="RecChunks" Text=""
                         FontSize="11" VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <!-- Shown only when the user is browsing a past meeting
                   (state == Done) while recording is still in flight.
                   Tap to return to the live transcript view without
                   stopping the recording. -->
              <Button x:Name="BackToLiveBtn" Click="BackToLive_Click"
                      Visibility="Collapsed"
                      ToolTipService.ToolTip="Return to the live recording view">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon Glyph="&#xE76B;" FontSize="13"/>
                  <TextBlock Text="Back to live"/>
                </StackPanel>
              </Button>
              <Button x:Name="PauseBtn" Click="Pause_Click"
                      ToolTipService.ToolTip="Pause / resume the meeting recording">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon x:Name="PauseBtnIcon" Glyph="&#xE769;" FontSize="13"/>
                  <TextBlock x:Name="PauseBtnLabel" Text="Pause"/>
                </StackPanel>
              </Button>
              <Button x:Name="StopBtn" Click="Stop_Click"
                      Style="{ThemeResource AccentButtonStyle}"
                      Background="Crimson" Foreground="White">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon Glyph="&#xE71A;" FontSize="13"/>
                  <TextBlock Text="Stop &amp; finish"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Content area: 4 states stacked, Visibility-toggled. -->
        <Grid Grid.Row="1">

          <!-- IDLE: hero + start CTA -->
          <StackPanel x:Name="IdlePanel" Spacing="20"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="Visible">
            <Border Width="96" Height="96" CornerRadius="48"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource AccentFillColorTertiaryBrush}">
              <FontIcon Glyph="&#xE720;" FontSize="44"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Border>
            <StackPanel Spacing="6" HorizontalAlignment="Center">
              <TextBlock Text="Ready to capture" FontSize="22" FontWeight="SemiBold"
                         HorizontalAlignment="Center"/>
              <TextBlock TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center"
                         FontSize="13"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         Text="Long-form recording with structured recap. Pick an old meeting from the sidebar to review, or start a new one."/>
            </StackPanel>
            <Button x:Name="StartBtn" Click="Start_Click"
                    Style="{ThemeResource AccentButtonStyle}"
                    HorizontalAlignment="Center" Padding="20,10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE7C8;" FontSize="14"/>
                <TextBlock Text="Start meeting" FontSize="14" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>
            <CheckBox x:Name="GenerateRecapCheck" IsChecked="True"
                      HorizontalAlignment="Center"
                      Content="Generate recap + action items on stop"/>
          </StackPanel>

          <!-- RECORDING: app-context + waveform card + live transcript -->
          <Grid x:Name="RecordingPanel" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Waveform card -->
            <Border Grid.Row="0"
                    Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                  <Image x:Name="AppContextIcon" Width="22" Height="22"
                         Visibility="Collapsed"/>
                  <FontIcon x:Name="AppContextFallback" Glyph="&#xE720;" FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="Visible"/>
                  <TextBlock x:Name="AppContextName" Text="Microphone"
                             FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <Canvas x:Name="LiveWaveformCanvas" Grid.Column="1"
                        Background="Transparent" Height="44"
                        VerticalAlignment="Center"
                        SizeChanged="LiveWaveformCanvas_SizeChanged"/>
              </Grid>
            </Border>

            <!-- Live transcript -->
            <Border Grid.Row="1"
                    Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="14,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Live transcript"
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TranscriptMeta" Grid.Column="1"
                               Text="" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <ScrollViewer x:Name="TranscriptScroll" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Padding="14" Spacing="10">
                    <TextBlock x:Name="TranscriptText"
                               Text="🎙️ Listening… first chunk lands in ~15 s."
                               TextWrapping="Wrap" FontSize="14"
                               IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>

          <!-- PROCESSING: spinner + steps -->
          <StackPanel x:Name="ProcessingPanel" Spacing="20"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="Collapsed">
            <ProgressRing x:Name="ProcSpinner" IsActive="True"
                          Width="56" Height="56" HorizontalAlignment="Center"/>
            <TextBlock Text="Wrapping up…" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <StackPanel Spacing="6" HorizontalAlignment="Center" MinWidth="320">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon x:Name="ProcStep1Icon" Glyph="&#xE73E;" FontSize="14"
                          Foreground="ForestGreen"/>
                <TextBlock x:Name="ProcStep1Text" Text="Saved audio + transcripts"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon x:Name="ProcStep2Icon" Glyph="&#xE76C;" FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="ProcStep2Text" Text="Generating recap with LLM…"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon x:Name="ProcStep3Icon" Glyph="&#xE76C;" FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="ProcStep3Text" Text="Extracting action items"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!-- DONE: meeting detail (also reused when sidebar selects a past meeting) -->
          <ScrollViewer x:Name="DonePanel" Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Padding="0,0,0,20">
              <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock x:Name="DoneTitle" Text="Meeting"
                               FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DoneMeta" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text=""/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="RegenTranscriptBtn" Click="RegenerateTranscript_Click"
                            ToolTipService.ToolTip="(Re)generate transcript from audio">
                      <FontIcon Glyph="&#xE720;" FontSize="13"/>
                    </Button>
                    <Button x:Name="RegenRecapBtn" Click="RegenerateRecap_Click"
                            ToolTipService.ToolTip="(Re)generate recap from transcript">
                      <FontIcon Glyph="&#xE8D4;" FontSize="13"/>
                    </Button>
                    <Button x:Name="CopyRecapBtn" Click="CopyRecap_Click"
                            ToolTipService.ToolTip="Copy recap to clipboard">
                      <FontIcon Glyph="&#xE8C8;" FontSize="13"/>
                    </Button>
                    <Button x:Name="OpenFolderBtn" Click="OpenFolder_Click"
                            ToolTipService.ToolTip="Open meeting folder">
                      <FontIcon Glyph="&#xE838;" FontSize="13"/>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>

              <Border x:Name="DoneWaveCard"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="0"
                      Visibility="Collapsed">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Padding="6,4" Height="64">
                    <Canvas x:Name="DoneWaveformCanvas"
                            Background="Transparent"
                            SizeChanged="DoneWaveformCanvas_SizeChanged"
                            PointerPressed="DoneWaveform_PointerPressed"/>
                  </Border>
                  <MediaPlayerElement x:Name="DoneAudioPlayer" Grid.Row="1"
                                      AreTransportControlsEnabled="True"
                                      AutoPlay="False" MaxHeight="110">
                    <MediaPlayerElement.TransportControls>
                      <MediaTransportControls IsCompact="True"
                                              IsZoomButtonVisible="False"/>
                    </MediaPlayerElement.TransportControls>
                  </MediaPlayerElement>
                </Grid>
              </Border>

              <Border x:Name="TldrCard" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                      BorderThickness="2" CornerRadius="8" Padding="14">
                <StackPanel Spacing="6">
                  <TextBlock Text="TL;DR" FontSize="11" FontWeight="SemiBold"
                             CharacterSpacing="80"
                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                  <RichTextBlock x:Name="TldrText" TextWrapping="Wrap" FontSize="14"
                                 IsTextSelectionEnabled="True"/>
                </StackPanel>
              </Border>

              <Border x:Name="DecisionsCard" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="ForestGreen"/>
                    <TextBlock Text="Key decisions" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                  <RichTextBlock x:Name="DecisionsText" TextWrapping="Wrap" FontSize="13"
                                 IsTextSelectionEnabled="True"/>
                </StackPanel>
              </Border>

              <Border x:Name="TopicsCard" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8FD;" FontSize="14"/>
                    <TextBlock Text="Topics discussed" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                  <RichTextBlock x:Name="TopicsText" TextWrapping="Wrap" FontSize="13"
                                 IsTextSelectionEnabled="True"/>
                </StackPanel>
              </Border>

              <Border x:Name="ActionsCard" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE762;" FontSize="14" Foreground="DarkOrange"/>
                    <TextBlock Text="Action items" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                  <RichTextBlock x:Name="ActionsText" TextWrapping="Wrap" FontSize="13"
                                 IsTextSelectionEnabled="True"/>
                </StackPanel>
              </Border>

              <Border x:Name="OpenQuestionsCard" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9CE;" FontSize="14"/>
                    <TextBlock Text="Open questions" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                  <RichTextBlock x:Name="OpenQuestionsText" TextWrapping="Wrap" FontSize="13"
                                 IsTextSelectionEnabled="True"/>
                </StackPanel>
              </Border>

              <Border x:Name="RisksCard" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7BA;" FontSize="14"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <TextBlock Text="Risks &amp; blockers" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                  <RichTextBlock x:Name="RisksText" TextWrapping="Wrap" FontSize="13"
                                 IsTextSelectionEnabled="True"/>
                </StackPanel>
              </Border>

              <Border x:Name="NextStepsCard" Visibility="Collapsed"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE893;" FontSize="14"/>
                    <TextBlock Text="Next steps" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                  <RichTextBlock x:Name="NextStepsText" TextWrapping="Wrap" FontSize="13"
                                 IsTextSelectionEnabled="True"/>
                </StackPanel>
              </Border>

              <Expander Header="Raw transcript" IsExpanded="False">
                <Border Padding="0,8,0,0">
                  <RichTextBlock x:Name="RawTranscriptText" TextWrapping="Wrap"
                                 FontSize="13" LineHeight="22"
                                 IsTextSelectionEnabled="True"/>
                </Border>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>

    <!-- Toast for blocked-history-during-recording -->
    <Border x:Name="ToastBar" Grid.Row="1" Visibility="Collapsed"
            HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="0,0,0,20"
            Background="#E8000000"
            CornerRadius="6" Padding="14,8">
      <TextBlock x:Name="ToastText" Foreground="White" FontSize="13"
                 Text=""/>
    </Border>
  </Grid>
</Window>
