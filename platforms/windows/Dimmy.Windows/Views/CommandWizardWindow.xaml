<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dimmy.Windows.Views.CommandWizardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Dimmy.Windows.Views.Controls"
    Title="Dimmy — Command mode">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          Padding="40" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: same on every page, so the user always knows where they are -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="StepLabel" Opacity="0.6" FontSize="12" />
            <TextBlock x:Name="TitleLabel" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleLabel" Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ── Step 0: the shortcut ─────────────────────────────────── -->
        <StackPanel x:Name="Step0" Grid.Row="1" Spacing="14" Visibility="Visible">
            <controls:ShortcutRecorder x:Name="Recorder" RequireKey="True"
                                       HorizontalAlignment="Left" />
            <InfoBar x:Name="ShortcutWarn" IsOpen="False" IsClosable="False"
                     Severity="Warning" />
            <TextBlock Opacity="0.6" TextWrapping="Wrap" FontSize="12"
                       Text="Command mode needs a real key with its modifiers (for example Ctrl+Alt+C). Combinations of modifiers alone are reserved for dictation." />
        </StackPanel>

        <!-- ── Step 1: the model ────────────────────────────────────── -->
        <StackPanel x:Name="Step1" Grid.Row="1" Spacing="14" Visibility="Collapsed">
            <TextBlock x:Name="ModelSummary" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="TestModelBtn" Content="Test the model"
                        Click="TestModel_Click" Style="{StaticResource AccentButtonStyle}" />
                <ProgressRing x:Name="TestRing" IsActive="False" Width="20" Height="20" />
            </StackPanel>
            <InfoBar x:Name="TestResult" IsOpen="False" IsClosable="False" />
            <HyperlinkButton Content="Change the model in Settings"
                             Click="OpenLlmSettings_Click" />
        </StackPanel>

        <!-- ── Step 2: try it for real ──────────────────────────────── -->
        <StackPanel x:Name="Step2" Grid.Row="1" Spacing="12" Visibility="Collapsed">
            <TextBlock x:Name="TryHint" Opacity="0.75" TextWrapping="Wrap" />
            <!-- A real TextBox with a real selection: the command path reads the
                 focused element's selection through UIA, so this exercises the
                 whole chain instead of faking the input. -->
            <TextBox x:Name="SampleBox" AcceptsReturn="True" TextWrapping="Wrap"
                     Height="110" IsSpellCheckEnabled="False" />
            <!-- Sits BELOW the box on purpose. The box is a real text box, and
                 a real text box asks to be typed in; the one instruction that
                 must land here is that the command is spoken, so it is said
                 next to the thing that suggests otherwise. -->
            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE720;" FontSize="16" VerticalAlignment="Top" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Say it out loud. Don't type it here."
                                   FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                        <TextBlock x:Name="SuggestionLabel" Opacity="0.7" FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <InfoBar x:Name="TryStatus" IsOpen="True" IsClosable="False"
                     Severity="Informational" Message="Waiting for your shortcut..." />
            <ScrollViewer Height="120" x:Name="ResultScroll" Visibility="Collapsed">
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2">
            <Button x:Name="BackBtn" Content="Back" Click="Back_Click"
                    HorizontalAlignment="Left" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button x:Name="SkipBtn" Content="Skip" Click="Skip_Click" Visibility="Collapsed" />
                <Button x:Name="NextBtn" Content="Continue" Click="Next_Click"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
