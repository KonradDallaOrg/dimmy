<?xml version="1.0" encoding="utf-8"?>
<!--
  Kimi Code Desktop MCP bridge wizard. Sibling of ClaudeDesktopConnectDialog.

    Step 1 - Install : detect Kimi Code Desktop; one button installs it with
                       winget (MoonshotAI.KimiCodeDesktop) in a visible
                       terminal.
    Step 2 - Connect : register dimmy-mcp in ~/.kimi-code/mcp.json (other
                       entries kept, original backed up).
    Step 3 - Verify  : open a NEW session in Kimi Code Desktop; Dimmy sees
                       dimmy-mcp's Kimi heartbeat and turns green.
-->
<ContentDialog
    x:Class="Dimmy.Windows.Views.KimiDesktopConnectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Connect Kimi Code Desktop"
    PrimaryButtonText="Next"
    SecondaryButtonText="Back"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick"
    SecondaryButtonClick="OnSecondaryClick">

  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
  </ContentDialog.Resources>

  <Grid RowSpacing="{StaticResource DimmySpaceL}" MinHeight="300">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="{StaticResource DimmySpaceS}"
                HorizontalAlignment="Center" Margin="0,0,0,4">
      <Ellipse x:Name="Dot1" Width="10" Height="10" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
      <Ellipse x:Name="Dot2" Width="10" Height="10" Fill="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Ellipse x:Name="Dot3" Width="10" Height="10" Fill="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>

    <Grid Grid.Row="1">

      <!-- Step 1 - Install -->
      <StackPanel x:Name="Step1Panel" Spacing="{StaticResource DimmySpaceM}" Visibility="Visible">
        <TextBlock Text="1 - Install Kimi Code Desktop" Style="{StaticResource DimmyHeadline}"/>
        <TextBlock TextWrapping="Wrap" Style="{StaticResource DimmySecondary}"
                   Text="Dimmy talks to Kimi Code Desktop over MCP. You can then ask Kimi about your meetings and dictations. It needs a Kimi plan that includes Kimi Code."/>
        <Border Style="{StaticResource DimmyCard}" Padding="{StaticResource DimmyCardPaddingCompact}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}">
            <FontIcon x:Name="DetectGlyph" Glyph="&#xE9F5;" FontSize="{StaticResource DimmyIconXL}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="DetectStatus" Style="{StaticResource DimmyBody}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Text="Looking for Kimi Code Desktop..."/>
            <ProgressRing x:Name="DetectRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed"/>
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}">
          <Button x:Name="InstallBtn" Content="Install Kimi Code Desktop" Click="Install_Click"
                  Style="{ThemeResource AccentButtonStyle}"/>
          <HyperlinkButton Content="Or download it from kimi.com/code"
                           NavigateUri="https://www.kimi.com/code" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>

      <!-- Step 2 - Connect -->
      <StackPanel x:Name="Step2Panel" Spacing="{StaticResource DimmySpaceM}" Visibility="Collapsed">
        <TextBlock Text="2 - Connect Dimmy" Style="{StaticResource DimmyHeadline}"/>
        <TextBlock TextWrapping="Wrap" Style="{StaticResource DimmySecondary}"
                   Text="Dimmy adds itself to Kimi Code's MCP servers. Your other servers stay as they are, and Dimmy keeps a copy of the original file."/>
        <Border Style="{StaticResource DimmyCard}" Padding="{StaticResource DimmyCardPaddingCompact}">
          <StackPanel Spacing="{StaticResource DimmySpaceXS}">
            <TextBlock Text="Kimi Code MCP file" Style="{StaticResource DimmyCaption}"/>
            <TextBlock x:Name="ConfigPathText" FontFamily="Consolas" TextWrapping="Wrap"
                       Style="{StaticResource DimmyLabel}" IsTextSelectionEnabled="True"/>
            <TextBlock Text="Dimmy MCP server" Style="{StaticResource DimmyCaption}" Margin="0,8,0,0"/>
            <TextBlock x:Name="BinaryPathText" FontFamily="Consolas" TextWrapping="Wrap"
                       Style="{StaticResource DimmyLabel}" IsTextSelectionEnabled="True"/>
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}">
          <Button x:Name="ConnectBtn" Content="Connect" Click="Connect_Click"
                  Style="{ThemeResource AccentButtonStyle}"/>
          <FontIcon x:Name="ConnectOkGlyph" Glyph="&#xE73E;" FontSize="{StaticResource DimmyIconXL}"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed"/>
          <TextBlock x:Name="ConnectStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                     Style="{StaticResource DimmyBody}"/>
        </StackPanel>
      </StackPanel>

      <!-- Step 3 - Verify -->
      <StackPanel x:Name="Step3Panel" Spacing="{StaticResource DimmySpaceM}" Visibility="Collapsed">
        <TextBlock Text="3 - Open a new session" Style="{StaticResource DimmyHeadline}"/>
        <TextBlock TextWrapping="Wrap" Style="{StaticResource DimmySecondary}"
                   Text="Kimi Code loads MCP servers when a session starts. Open Kimi Code Desktop and start a NEW session; sessions already open do not see Dimmy."/>
        <Border Style="{StaticResource DimmyCard}" Padding="{StaticResource DimmyCardPaddingCompact}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}">
            <FontIcon x:Name="HeartbeatGlyph" Glyph="&#xE9F5;" FontSize="{StaticResource DimmyIconXL}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="HeartbeatStatus" Style="{StaticResource DimmyBody}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Text="Waiting for Kimi Code to start Dimmy..."/>
            <ProgressRing x:Name="HeartbeatRing" Width="16" Height="16" IsActive="True"/>
          </StackPanel>
        </Border>
        <Button x:Name="OpenKimiBtn" Content="Open Kimi Code Desktop" Click="OpenKimi_Click"
                HorizontalAlignment="Left"/>
        <TextBlock TextWrapping="Wrap" Style="{StaticResource DimmySecondary}"
                   Text="Then ask Kimi, for example: &quot;List my recent Dimmy meetings&quot;."/>
      </StackPanel>

    </Grid>
  </Grid>
</ContentDialog>
