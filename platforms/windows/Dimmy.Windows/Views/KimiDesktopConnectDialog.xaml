<?xml version="1.0" encoding="utf-8"?>
<!--
  Kimi (Kimi Work) wizard. Sibling of ClaudeDesktopConnectDialog.

    Step 1 - Install : the Kimi app (winget MoonshotAI.Kimi, or kimi.ai),
                       opened once and signed in.
    Step 2 - Connect : Dimmy registers its plugin in Kimi's Personal plugins
                       (and in ~/.kimi-code/mcp.json for Kimi Code); the user
                       presses Install in Kimi's Plugins page.
    Step 3 - Verify  : a Work chat starts dimmy-mcp; its kimi-work heartbeat
                       turns the step green.
-->
<ContentDialog
    x:Class="Dimmy.Windows.Views.KimiDesktopConnectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Connect Kimi"
    PrimaryButtonText="Next"
    SecondaryButtonText="Back"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick"
    SecondaryButtonClick="OnSecondaryClick">

  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
  </ContentDialog.Resources>

  <Grid RowSpacing="{StaticResource DimmySpaceL}" MinHeight="300">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="{StaticResource DimmySpaceS}"
                HorizontalAlignment="Center" Margin="0,0,0,4">
      <Ellipse x:Name="Dot1" Width="10" Height="10" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
      <Ellipse x:Name="Dot2" Width="10" Height="10" Fill="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Ellipse x:Name="Dot3" Width="10" Height="10" Fill="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>

    <Grid Grid.Row="1">

      <!-- Step 1 - Install -->
      <StackPanel x:Name="Step1Panel" Spacing="{StaticResource DimmySpaceM}" Visibility="Visible">
        <TextBlock Text="1 - Install Kimi" Style="{StaticResource DimmyHeadline}"/>
        <TextBlock TextWrapping="Wrap" Style="{StaticResource DimmySecondary}"
                   Text="Kimi Work, in the Kimi desktop app, can read your Dimmy meetings and dictations through a Dimmy plugin. Install Kimi, open it once and sign in."/>
        <Border Style="{StaticResource DimmyCard}" Padding="{StaticResource DimmyCardPaddingCompact}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}">
            <FontIcon x:Name="DetectGlyph" Glyph="&#xE9F5;" FontSize="{StaticResource DimmyIconXL}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="DetectStatus" Style="{StaticResource DimmyBody}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Text="Looking for Kimi..."/>
            <ProgressRing x:Name="DetectRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed"/>
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}">
          <Button x:Name="InstallBtn" Content="Install Kimi" Click="Install_Click"
                  Style="{ThemeResource AccentButtonStyle}"/>
          <Button x:Name="OpenKimi1Btn" Content="Open Kimi" Click="OpenKimi_Click" Visibility="Collapsed"/>
          <HyperlinkButton x:Name="DownloadLink" Content="Or download it from kimi.ai"
                           NavigateUri="https://www.kimi.ai/products/download" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>

      <!-- Step 2 - Connect -->
      <StackPanel x:Name="Step2Panel" Spacing="{StaticResource DimmySpaceM}" Visibility="Collapsed">
        <TextBlock Text="2 - Add the Dimmy plugin" Style="{StaticResource DimmyHeadline}"/>
        <TextBlock TextWrapping="Wrap" Style="{StaticResource DimmySecondary}"
                   Text="Dimmy adds its plugin to Kimi's Personal plugins. Then, in Kimi, open Plugins → Personal and press Install on Dimmy."/>
        <Border Style="{StaticResource DimmyCard}" Padding="{StaticResource DimmyCardPaddingCompact}">
          <StackPanel Spacing="{StaticResource DimmySpaceM}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}">
              <FontIcon x:Name="RegisterGlyph" Glyph="&#xE9F5;" FontSize="{StaticResource DimmyIconXL}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock x:Name="RegisterStatus" Style="{StaticResource DimmyBody}" VerticalAlignment="Center"
                         TextWrapping="Wrap" Text="Not added yet."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}">
              <FontIcon x:Name="InstalledGlyph" Glyph="&#xE9F5;" FontSize="{StaticResource DimmyIconXL}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock x:Name="InstalledStatus" Style="{StaticResource DimmyBody}" VerticalAlignment="Center"
                         TextWrapping="Wrap" Text="In Kimi: Plugins → Personal → Dimmy → Install."/>
              <ProgressRing x:Name="InstalledRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}">
          <Button x:Name="ConnectBtn" Content="Add to Kimi" Click="Connect_Click"
                  Style="{ThemeResource AccentButtonStyle}"/>
          <Button x:Name="OpenKimi2Btn" Content="Open Kimi" Click="OpenKimi_Click"/>
          <TextBlock x:Name="ConnectStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                     Style="{StaticResource DimmyBody}"/>
        </StackPanel>
      </StackPanel>

      <!-- Step 3 - Verify -->
      <StackPanel x:Name="Step3Panel" Spacing="{StaticResource DimmySpaceM}" Visibility="Collapsed">
        <TextBlock Text="3 - Try it" Style="{StaticResource DimmyHeadline}"/>
        <TextBlock TextWrapping="Wrap" Style="{StaticResource DimmySecondary}"
                   Text="In Kimi Work, start a new chat and ask: &quot;List my latest Dimmy meetings&quot;. This page turns green when Kimi starts Dimmy."/>
        <Border Style="{StaticResource DimmyCard}" Padding="{StaticResource DimmyCardPaddingCompact}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}">
            <FontIcon x:Name="HeartbeatGlyph" Glyph="&#xE9F5;" FontSize="{StaticResource DimmyIconXL}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="HeartbeatStatus" Style="{StaticResource DimmyBody}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Text="Waiting for Kimi to start Dimmy..."/>
            <ProgressRing x:Name="HeartbeatRing" Width="16" Height="16" IsActive="True"/>
          </StackPanel>
        </Border>
        <Button x:Name="OpenKimi3Btn" Content="Open Kimi Work" Click="OpenKimi_Click" HorizontalAlignment="Left"/>
      </StackPanel>

    </Grid>
  </Grid>
</ContentDialog>
