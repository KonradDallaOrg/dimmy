<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dimmy.Windows.Views.CallNudgeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Non-activating overlay card. Bottom-right primary display.
         Same transparency recipe as PillWindow / CaptionWindow:
         ExtendsContentIntoTitleBar + TransparentBackdrop applied in
         the code-behind, plus WS_EX_NOACTIVATE set in EnableTransparency
         so the card cannot become foreground (essential — otherwise
         Ctrl+V mid-prompt would land here instead of the target app). -->
    <Grid Background="Transparent">
        <Border Background="#FF1A1A1A"
                CornerRadius="12"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                Padding="16,14,12,14"
                Margin="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header row: icon glyph + title + close X -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              x:Name="HeaderIcon"
                              FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE717;"
                              FontSize="18"
                              Foreground="#FFE5E5E5"
                              Margin="0,1,10,0"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               x:Name="TitleText"
                               Text="Meeting detected"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               Foreground="#FFFFFFFF"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2"
                            x:Name="CloseButton"
                            Width="28" Height="28"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="#AAFFFFFF"
                            ToolTipService.ToolTip="Dismiss"
                            Click="OnCloseClicked">
                        <Button.Resources>
                            <ResourceDictionary>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22FFFFFF" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                            </ResourceDictionary>
                        </Button.Resources>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE894;" FontSize="11" />
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem x:Name="DontAskMenuItem"
                                                Text="Don't ask for this app again"
                                                Click="OnNeverClicked" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- Body line -->
                <TextBlock Grid.Row="1"
                           x:Name="BodyText"
                           Text="Dimmy can record + recap this call."
                           FontSize="12"
                           FontFamily="Segoe UI"
                           Foreground="#CCFFFFFF"
                           Margin="0,8,28,0"
                           TextWrapping="Wrap" />

                <!-- CTA row -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8"
                            Margin="0,14,0,0">
                    <Button x:Name="NotNowButton"
                            Content="Not now"
                            MinWidth="80"
                            Padding="12,4,12,4"
                            FontSize="12"
                            Background="#22FFFFFF"
                            BorderBrush="#33FFFFFF"
                            Foreground="#FFE5E5E5"
                            Click="OnNotNowClicked" />
                    <Button x:Name="RecordButton"
                            Content="Record now"
                            MinWidth="100"
                            Padding="12,4,12,4"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Background="#FF6B5BFF"
                            BorderBrush="#FF6B5BFF"
                            Foreground="#FFFFFFFF"
                            Click="OnRecordClicked" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
