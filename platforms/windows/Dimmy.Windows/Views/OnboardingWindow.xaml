<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dimmy.Windows.Views.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Dimmy.Windows.Views.Controls"
    Title="Dimmy">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          Padding="40" RowSpacing="{StaticResource DimmySpaceL}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Step 0: Welcome -->
        <StackPanel x:Name="Step0Panel" Spacing="{StaticResource DimmySpaceM}" VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsStep0, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Image Source="ms-appx:///Assets/dimmy-logo.png" Width="64" Height="64"
                   HorizontalAlignment="Center" />
            <TextBlock Text="Dimmy" Style="{StaticResource DimmyPageTitle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Voice dictation that stays out of your way"
                       Style="{StaticResource DimmyCardTitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Hold a shortcut, speak, release.&#x0a;Your words appear wherever you're typing."
                       Style="{StaticResource DimmySecondary}"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <CheckBox x:Name="TermsCheck"
                      AutomationProperties.AutomationId="OnboardingTermsCheckBox"
                      HorizontalAlignment="Center" Margin="0,16,0,0"
                      Checked="TermsCheck_Changed" Unchecked="TermsCheck_Changed"
                      Content="I accept the Terms of Service and End-User Licence Agreement" />
            <HyperlinkButton Content="Read the terms" HorizontalAlignment="Center"
                             NavigateUri="https://dimmy.app/terms/" />
            <Button x:Name="GetStartedBtn" Content="Get Started" HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="OnboardingGetStartedButton"
                    IsEnabled="False"
                    Style="{ThemeResource AccentButtonStyle}" Width="200"
                    Click="NextStep_Click" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Step 1: Local or Cloud -->
        <StackPanel x:Name="Step1Panel" Spacing="{StaticResource DimmySpaceL}" VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Visibility="{Binding IsStep1, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="How should Dimmy transcribe?" Style="{StaticResource DimmyPageTitle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Private and offline, or fastest with cloud"
                       Style="{StaticResource DimmySecondary}"
                       HorizontalAlignment="Center" />

            <Grid ColumnSpacing="{StaticResource DimmySpaceL}" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Local card -->
                <Border Grid.Column="0"
                        AutomationProperties.AutomationId="OnboardingLocalCard"
                        AutomationProperties.Name="Local mode"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{Binding IsLocalSelected, Mode=OneWay, Converter={StaticResource BoolToAccentBrush}}"
                        BorderThickness="2"
                        CornerRadius="10"
                        Padding="18"
                        MinHeight="220"
                        Tapped="LocalCard_Tapped">
                    <StackPanel Spacing="{StaticResource DimmySpaceS}">
                        <FontIcon Glyph="&#xE72E;" FontSize="{StaticResource DimmyIconXL}"
                                  HorizontalAlignment="Left"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="Local" Style="{StaticResource DimmyHeadline}" />
                        <TextBlock Text="Private · offline · runs on your machine"
                                   Style="{StaticResource DimmyCaption}" />
                        <TextBlock Text="Your voice never leaves your device"
                                   Style="{StaticResource DimmyCaption}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding HardwareLine, Mode=OneWay}"
                                   Visibility="{Binding HasHardwareLine, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Style="{StaticResource DimmyCaption}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource AccentTextFillColorSecondaryBrush}" />
                        <!-- Model picker. Same shape as Settings → Local model.
                             Default selection is the whisper base file (smallest,
                             fastest first run). Picking a different size or
                             Parakeet TDT v3 cancels the current download and
                             starts the new one. -->
                        <ComboBox x:Name="OnboardingLocalModelComboBox"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,8,0,0"
                                  SelectionChanged="OnboardingLocalModel_SelectionChanged" />

                        <StackPanel Spacing="{StaticResource DimmySpaceXS}" Margin="0,8,0,0"
                                    Visibility="{Binding IsLocalReady, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            <ProgressBar Value="{Binding DownloadPercent, Mode=OneWay}"
                                         Maximum="100" Height="4" />
                            <TextBlock Text="{Binding DownloadStatusText, Mode=OneWay}"
                                       Style="{StaticResource DimmyCaption}" />
                            <TextBlock Text="{Binding DownloadBytesText, Mode=OneWay}"
                                       Style="{StaticResource DimmyCaption}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding LocalErrorText, Mode=OneWay}"
                                       Style="{StaticResource DimmyCaption}" Foreground="#E06060"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsLocalFailed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceS}" Margin="0,8,0,0"
                                    Visibility="{Binding IsLocalReady, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource DimmyIconM}" Foreground="#60C060" />
                            <TextBlock Text="Ready to use" Style="{StaticResource DimmyCaption}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Cloud card -->
                <Border Grid.Column="1"
                        AutomationProperties.AutomationId="OnboardingCloudCard"
                        AutomationProperties.Name="Cloud mode"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{Binding IsCloudSelected, Mode=OneWay, Converter={StaticResource BoolToAccentBrush}}"
                        BorderThickness="2"
                        CornerRadius="10"
                        Padding="18"
                        MinHeight="220"
                        Tapped="CloudCard_Tapped">
                    <StackPanel Spacing="{StaticResource DimmySpaceS}">
                        <FontIcon Glyph="&#xE753;" FontSize="{StaticResource DimmyIconXL}"
                                  HorizontalAlignment="Left"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="Cloud (Groq)" Style="{StaticResource DimmyHeadline}" />
                        <TextBlock Text="Fastest · most accurate"
                                   Style="{StaticResource DimmyCaption}" />
                        <TextBlock Text="Free tier available · uses your API key"
                                   Style="{StaticResource DimmyCaption}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                        <PasswordBox x:Name="GroqKeyBox"
                                     AutomationProperties.AutomationId="OnboardingGroqKeyBox"
                                     PlaceholderText="gsk_..."
                                     Margin="0,8,0,0"
                                     PasswordChanged="GroqKeyBox_PasswordChanged" />

                        <HyperlinkButton NavigateUri="https://console.groq.com/keys"
                                         Padding="0,4,0,0">
                            <TextBlock Text="Get API key →" Style="{StaticResource DimmyLabel}" />
                        </HyperlinkButton>

                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceS}">
                            <ProgressRing IsActive="{Binding IsValidatingKey, Mode=OneWay}"
                                          Width="14" Height="14"
                                          Visibility="{Binding IsValidatingKey, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource DimmyIconM}" Foreground="#60C060"
                                      Visibility="{Binding IsCloudReady, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="{Binding CloudErrorText, Mode=OneWay}" Style="{StaticResource DimmyCaption}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}" HorizontalAlignment="Center"
                        Margin="0,8,0,0">
                <Button Content="Back"
                        AutomationProperties.AutomationId="OnboardingChoiceBackButton"
                        Click="PrevStep_Click" Width="90" />
                <Button Content="{Binding ChoiceContinueLabel, Mode=OneWay}"
                        AutomationProperties.AutomationId="OnboardingChoiceContinueButton"
                        IsEnabled="{Binding CanAdvanceFromChoiceStep, Mode=OneWay}"
                        Click="NextStep_Click"
                        Style="{ThemeResource AccentButtonStyle}" Width="180" />
            </StackPanel>
        </StackPanel>

        <!-- Step 2: Shortcut -->
        <StackPanel x:Name="Step2Panel" Spacing="{StaticResource DimmySpaceM}" VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsStep2, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Your Shortcut" Style="{StaticResource DimmyPageTitle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Press the keys you want to dictate with." Style="{StaticResource DimmySecondary}"
                       HorizontalAlignment="Center" />
            <Border x:Name="ShortcutCaptureBorder"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="{StaticResource DimmyCardRadius}" Padding="24,16" HorizontalAlignment="Center"
                    MinWidth="220" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" Tapped="ShortcutCapture_Tapped">
                <TextBlock x:Name="ShortcutCaptureText" Text="{Binding Shortcut, Mode=OneWay}"
                           Style="{StaticResource DimmyPageTitle}" HorizontalAlignment="Center" />
            </Border>
            <TextBlock Text="Click here, then press and hold your combo." Style="{StaticResource DimmyCaption}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceL}" HorizontalAlignment="Center"
                        Margin="0,12,0,0">
                <RadioButton Content="Push-to-Talk" GroupName="Mode"
                             IsChecked="{Binding ShortcutMode, Mode=TwoWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=hold}" />
                <RadioButton Content="Toggle" GroupName="Mode"
                             IsChecked="{Binding ShortcutMode, Mode=TwoWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=toggle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}" HorizontalAlignment="Center"
                        Margin="0,16,0,0">
                <Button Content="Back" Click="PrevStep_Click" Width="90" />
                <Button Content="Next" Click="NextStep_Click"
                        Style="{ThemeResource AccentButtonStyle}" Width="90" />
            </StackPanel>
        </StackPanel>

        <!-- Step 3: Try It -->
        <StackPanel x:Name="Step3Panel" Spacing="{StaticResource DimmySpaceM}" VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsStep3, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Visibility="{Binding IsTrialSuccess, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                        Spacing="{StaticResource DimmySpaceM}" HorizontalAlignment="Center">
                <TextBlock Text="Try it!" Style="{StaticResource DimmyPageTitle}"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TrialPromptVerb, Mode=OneWay}" Style="{StaticResource DimmySecondary}" />
                    <TextBlock Text=" " Style="{StaticResource DimmyBody}" />
                    <TextBlock Text="{Binding Shortcut, Mode=OneWay}" Style="{StaticResource DimmyCardTitle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text=" and say something" Style="{StaticResource DimmySecondary}" />
                </StackPanel>
                <TextBlock Text="Look at the pill overlay. It will animate while you speak."
                           Style="{StaticResource DimmyCaption}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="{StaticResource DimmyCardRadius}" Padding="16" MinHeight="80" MinWidth="320"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="{Binding TrialBoxPlaceholder, Mode=OneWay}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding TrialHasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                        <TextBlock Text="{Binding TrialText, Mode=OneWay}"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceS}" HorizontalAlignment="Center"
                            Visibility="{Binding TrialHasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource DimmyIconL}" Foreground="Green" />
                    <TextBlock Text="Transcribed. Looks right?" Style="{StaticResource DimmySecondary}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Content="Back" Click="PrevStep_Click" Width="90" />
                    <Button Content="Continue" Click="TrialContinue_Click"
                            Style="{ThemeResource AccentButtonStyle}" Width="140"
                            Visibility="{Binding TrialHasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Content="Skip" Click="TrialContinue_Click" Width="90"
                            Visibility="{Binding TrialHasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding IsTrialSuccess, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Spacing="{StaticResource DimmySpaceM}" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource DimmyIconHero}" Foreground="Green"
                          HorizontalAlignment="Center" />
                <TextBlock Text="You're all set!" Style="{StaticResource DimmyPageTitle}"
                           HorizontalAlignment="Center" />
                <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource DimmySpaceXS}">
                    <TextBlock Text="Dimmy lives in your system tray." Style="{StaticResource DimmySecondary}"
                               HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TrialPromptVerb, Mode=OneWay}" Style="{StaticResource DimmySecondary}" />
                        <TextBlock Text=" " Style="{StaticResource DimmyBody}" />
                        <TextBlock Text="{Binding Shortcut, Mode=OneWay}" Style="{StaticResource DimmyCardTitle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text=" anywhere to dictate." Style="{StaticResource DimmySecondary}" />
                    </StackPanel>
                </StackPanel>
                <!-- Two doors out of the wizard, for the two features whose setup is
                     more than a checkbox. Offered, not imposed: "Start Using Dimmy"
                     finishes exactly as it did before and nobody is walked through
                     something they did not ask for. -->
                <TextBlock Text="Want to set up more?" Style="{StaticResource DimmySecondary}" Margin="0,10,0,0"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}" HorizontalAlignment="Center">
                  <controls:WizardCard Glyph="&#xE8BD;" Title="Meetings"
                                       Description="Record and get a recap"
                                       Click="OpenMeetingWizard_Click" />
                  <controls:WizardCard Glyph="&#xE90F;" Title="Command mode"
                                       Description="Change selected text by voice"
                                       Click="OpenCommandWizard_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Content="Back" Click="TrialBack_Click" Width="90" />
                    <Button Content="Continue" Click="ContinueWithoutWizard_Click"
                            AutomationProperties.AutomationId="OnboardingToUpdatesButton"
                            Style="{ThemeResource AccentButtonStyle}" Width="180" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Step 4: Thank you + the one optional ask. Every way out of the
             wizard passes here; skipping is a real choice, said plainly. -->
        <StackPanel x:Name="Step4Panel" Spacing="{StaticResource DimmySpaceM}" VerticalAlignment="Center"
                    HorizontalAlignment="Center" MaxWidth="420"
                    Visibility="{Binding IsStep4, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Thank you for installing Dimmy" Style="{StaticResource DimmyPageTitle}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />

            <StackPanel Spacing="{StaticResource DimmySpaceM}"
                        Visibility="{Binding UpdatesSent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <TextBlock Style="{StaticResource DimmySecondary}" TextWrapping="Wrap" TextAlignment="Center"
                           Text="Enter your email to start the free 14-day trial and get the latest updates automatically." />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceS}" HorizontalAlignment="Center">
                    <TextBox x:Name="UpdatesEmailBox" Width="250" PlaceholderText="you@example.com"
                             AutomationProperties.AutomationId="OnboardingUpdatesEmailBox"
                             Text="{Binding UpdatesEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="UpdatesEmailBox_KeyDown" />
                    <Button Content="Start free trial" Click="UpdatesSend_Click"
                            AutomationProperties.AutomationId="OnboardingUpdatesSendButton"
                            Style="{ThemeResource AccentButtonStyle}"
                            IsEnabled="{Binding CanSendUpdatesEmail, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Text="{Binding UpdatesError, Mode=OneWay}" Style="{StaticResource DimmyCaption}" TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Visibility="{Binding HasUpdatesError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Style="{StaticResource DimmyCaption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                           Text="Or continue as you are: Dimmy stays free, on this version, until you update it yourself." />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Button Content="Back" Click="PrevStep_Click" Width="90" />
                    <Button Content="Continue without email" Click="UpdatesFinish_Click"
                            AutomationProperties.AutomationId="OnboardingUpdatesSkipButton" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="{StaticResource DimmySpaceM}"
                        Visibility="{Binding UpdatesSent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE715;" FontSize="{StaticResource DimmyIconHero}" HorizontalAlignment="Center"
                          Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock Style="{StaticResource DimmyBody}" TextWrapping="Wrap" TextAlignment="Center"
                           Text="Check your inbox. The link in the email activates Dimmy on this PC; until you open it nothing changes." />
                <Button Content="Start Using Dimmy" Click="UpdatesFinish_Click"
                        AutomationProperties.AutomationId="OnboardingUpdatesDoneButton"
                        Style="{ThemeResource AccentButtonStyle}" Width="180" HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- Progress dots -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{StaticResource DimmySpaceS}">
            <Ellipse Width="8" Height="8"
                     Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            <Ellipse Width="8" Height="8"
                     Fill="{ThemeResource AccentFillColorDefaultBrush}"
                     Opacity="{Binding Step1Reached, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}, ConverterParameter=Invert}" />
            <Ellipse Width="8" Height="8"
                     Fill="{ThemeResource AccentFillColorDefaultBrush}"
                     Opacity="{Binding Step2Reached, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}, ConverterParameter=Invert}" />
            <Ellipse Width="8" Height="8"
                     Fill="{ThemeResource AccentFillColorDefaultBrush}"
                     Opacity="{Binding Step3Reached, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}, ConverterParameter=Invert}" />
            <Ellipse Width="8" Height="8"
                     Fill="{ThemeResource AccentFillColorDefaultBrush}"
                     Opacity="{Binding Step4Reached, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}, ConverterParameter=Invert}" />
        </StackPanel>
    </Grid>
</Window>
