<?xml version="1.0" encoding="utf-8"?>
<!--
  Kimi Code (Kimi membership) setup wizard. Sibling of CodexConnectDialog.

  The user installs nothing by hand: every step is one button.

    Page 1 - Install : Git for Windows (the Kimi CLI runs its shell through
                       Git Bash) and the Kimi CLI, each with its own button
                       that opens a visible terminal running the command.
    Page 2 - Sign in : `kimi login` (device code) in a visible terminal;
                       Dimmy sees the sign-in by itself.
    Page 3 - Test    : one ping through `kimi acp` + the models this plan
                       serves.
-->
<ContentDialog
    x:Class="Dimmy.Windows.Views.KimiConnectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Set up Kimi Code"
    PrimaryButtonText="Next"
    SecondaryButtonText="Back"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick"
    SecondaryButtonClick="OnSecondaryClick">

  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
  </ContentDialog.Resources>

  <Grid RowSpacing="{StaticResource DimmySpaceL}" MinHeight="300">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="{StaticResource DimmySpaceS}"
                HorizontalAlignment="Center" Margin="0,0,0,4">
      <Ellipse x:Name="Dot1" Width="10" Height="10"
               Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
      <Ellipse x:Name="Dot2" Width="10" Height="10"
               Fill="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Ellipse x:Name="Dot3" Width="10" Height="10"
               Fill="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>

    <Grid Grid.Row="1">

      <!-- Page 1 - Install -->
      <StackPanel x:Name="Page1Panel" Spacing="{StaticResource DimmySpaceM}" Visibility="Visible">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceS}" VerticalAlignment="Center">
          <TextBlock Text="1 - Install" Style="{StaticResource DimmyHeadline}"/>
          <Button Background="Transparent" BorderThickness="0" Padding="2"
                  VerticalAlignment="Center"
                  ToolTipService.ToolTip="About installing Kimi Code">
            <FontIcon Glyph="&#xE946;" FontSize="{StaticResource DimmyIconM}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button.Flyout>
              <Flyout>
                <TextBlock Width="300" TextWrapping="Wrap" Style="{StaticResource DimmyBody}"
                           Text="Kimi Code is the official command-line app from Moonshot AI. On Windows it needs Git for Windows. Each button opens a terminal that runs the official installer. Wait until it finishes; Dimmy sees the result by itself."/>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <Border Style="{StaticResource DimmyCard}" Padding="{StaticResource DimmyCardPaddingCompact}">
          <StackPanel Spacing="{StaticResource DimmySpaceM}">
            <Grid ColumnSpacing="{StaticResource DimmySpaceM}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <FontIcon x:Name="GitGlyph" FontSize="{StaticResource DimmyIconXL}"
                        FontFamily="Segoe Fluent Icons" Glyph="&#xE9F5;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock x:Name="GitText" Grid.Column="1" VerticalAlignment="Center"
                         Style="{StaticResource DimmyBody}" TextWrapping="Wrap"
                         Text="Looking for Git for Windows..."/>
              <Button x:Name="InstallGitBtn" Grid.Column="2" Content="Install Git"
                      Click="InstallGit_Click" Visibility="Collapsed"
                      Style="{ThemeResource AccentButtonStyle}"/>
            </Grid>
            <Grid ColumnSpacing="{StaticResource DimmySpaceM}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <FontIcon x:Name="KimiGlyph" FontSize="{StaticResource DimmyIconXL}"
                        FontFamily="Segoe Fluent Icons" Glyph="&#xE9F5;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock x:Name="KimiText" Grid.Column="1" VerticalAlignment="Center"
                         Style="{StaticResource DimmyBody}" TextWrapping="Wrap"
                         Text="Looking for the Kimi Code CLI..."/>
              <Button x:Name="InstallKimiBtn" Grid.Column="2" Content="Install Kimi Code"
                      Click="InstallKimi_Click" Visibility="Collapsed"
                      Style="{ThemeResource AccentButtonStyle}"/>
            </Grid>
          </StackPanel>
        </Border>

        <HyperlinkButton Content="See Kimi's official install page"
                         NavigateUri="https://www.kimi.ai/code"
                         FontSize="{StaticResource DimmyFontCaption}" Padding="0"/>
      </StackPanel>

      <!-- Page 2 - Sign in -->
      <StackPanel x:Name="Page2Panel" Spacing="{StaticResource DimmySpaceM}" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceS}" VerticalAlignment="Center">
          <TextBlock Text="2 - Sign in" Style="{StaticResource DimmyHeadline}"/>
          <Button Background="Transparent" BorderThickness="0" Padding="2"
                  VerticalAlignment="Center"
                  ToolTipService.ToolTip="About signing in">
            <FontIcon Glyph="&#xE946;" FontSize="{StaticResource DimmyIconM}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button.Flyout>
              <Flyout>
                <TextBlock Width="300" TextWrapping="Wrap" Style="{StaticResource DimmyBody}"
                           Text="A terminal opens and shows a code. Confirm it in the browser with your Kimi account. Kimi Code is included from the Plus plan. Dimmy never sees your token."/>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <Border Style="{StaticResource DimmyCard}" Padding="{StaticResource DimmyCardPaddingCompact}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}" VerticalAlignment="Center">
            <FontIcon x:Name="SignInGlyph" FontSize="{StaticResource DimmyIconXL}"
                      FontFamily="Segoe Fluent Icons" Glyph="&#xE9F5;"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="SignInText" VerticalAlignment="Center"
                       Style="{StaticResource DimmyBody}" TextWrapping="Wrap"
                       Text="Not signed in yet."/>
            <ProgressRing x:Name="SignInRing" Width="16" Height="16"
                          IsActive="False" Visibility="Collapsed"/>
          </StackPanel>
        </Border>

        <Button x:Name="SignInBtn" Content="Sign in with Kimi"
                Click="SignIn_Click"
                Style="{ThemeResource AccentButtonStyle}"
                HorizontalAlignment="Left"/>
      </StackPanel>

      <!-- Page 3 - Test -->
      <StackPanel x:Name="Page3Panel" Spacing="{StaticResource DimmySpaceM}" Visibility="Collapsed">
        <TextBlock Text="3 - Test" Style="{StaticResource DimmyHeadline}"/>

        <Border Style="{StaticResource DimmyCard}" Padding="{StaticResource DimmyCardPaddingCompact}">
          <StackPanel Spacing="{StaticResource DimmySpaceM}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}" VerticalAlignment="Center">
              <FontIcon x:Name="TestGlyph" FontSize="{StaticResource DimmyIconXL}"
                        FontFamily="Segoe Fluent Icons" Glyph="&#xE9F5;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock x:Name="TestText" VerticalAlignment="Center"
                         Style="{StaticResource DimmyBody}" TextWrapping="Wrap"
                         Text="Sending a test message to Kimi..."/>
              <ProgressRing x:Name="TestRing" Width="16" Height="16" IsActive="True"/>
            </StackPanel>
            <TextBlock x:Name="ModelsText" Style="{StaticResource DimmySecondary}"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
          </StackPanel>
        </Border>

        <TextBlock TextWrapping="Wrap" Style="{StaticResource DimmySecondary}"
                   Text="To use it, pick Kimi Code as the rewrite or recap provider in Settings and turn on &quot;Use Kimi subscription&quot;."/>

        <Button x:Name="RetestBtn" Content="Test again" Click="Retest_Click"
                HorizontalAlignment="Left"/>
      </StackPanel>

    </Grid>
  </Grid>
</ContentDialog>
