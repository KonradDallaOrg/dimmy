<?xml version="1.0" encoding="utf-8"?>
<!--
  Claude Code subscription setup wizard.

  Two linear steps, one ContentDialog. Same shape as
  NotionConnectDialog: state machine in code-behind toggles
  Step2Panel / Step3Panel visibility, the dialog buttons
  (Primary/Secondary/Close) get relabeled per step.

  Claude Code ships as a native standalone binary now (no
  Node.js), installed via a one-line PowerShell command.

  Smart-skip on entry: when the dialog opens we probe claude +
  credentials state once and start on the FIRST step whose
  precondition is missing. Anyone already past a step doesn't
  see it.

  Flow:
    Step 1 - Install Claude Code -> copy install command + open
                                    terminal + recheck
    Step 2 - Sign in + test      -> spawn `claude /login`, poll
                                    credentials, auto-fire test ping
-->
<ContentDialog
    x:Class="Dimmy.Windows.Views.ClaudeConnectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Set up Claude subscription"
    PrimaryButtonText="Next"
    SecondaryButtonText="Back"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick"
    SecondaryButtonClick="OnSecondaryClick"
    CloseButtonClick="OnCloseClick">

  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">580</x:Double>
    <x:Double x:Key="ContentDialogMinWidth">580</x:Double>
  </ContentDialog.Resources>

  <Grid RowSpacing="14" MinHeight="420">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ── Progress dots ───────────────────────────────────────── -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Center" Margin="0,0,0,4">
      <Ellipse x:Name="Dot1" Width="10" Height="10"
               Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
      <Ellipse x:Name="Dot2" Width="10" Height="10"
               Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>
    </StackPanel>

    <Grid Grid.Row="1">

      <!-- ════ Step 1 - Install Claude Code ════ -->
      <StackPanel x:Name="Step2Panel" Spacing="12" Visibility="Visible">
        <TextBlock Text="1 - Install Claude Code"
                   FontSize="18" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Open a terminal, paste this command, and press Enter. It installs the Claude Code CLI. No Node.js needed."/>

        <Border x:Name="ClaudeStatusBorder"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="14">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <FontIcon x:Name="ClaudeStatusGlyph" FontSize="20"
                      FontFamily="Segoe Fluent Icons"
                      Glyph="&#xE9F5;"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="ClaudeStatusText" VerticalAlignment="Center"
                       FontSize="13" TextWrapping="Wrap"
                       Text="Checking for Claude CLI…"/>
          </StackPanel>
        </Border>

        <StackPanel x:Name="ClaudeActionPanel" Visibility="Collapsed" Spacing="10">
          <Border Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                  CornerRadius="4" Padding="12,8,12,8">
            <TextBlock x:Name="NpmCommandText"
                       Text="irm https://claude.ai/install.ps1 | iex"
                       FontFamily="Consolas, Menlo, monospace"
                       FontSize="13" TextWrapping="NoWrap"
                       IsTextSelectionEnabled="True"/>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="CopyCmdBtn" Content="Copy command"
                    Click="CopyInstallCommand_Click"
                    Style="{ThemeResource AccentButtonStyle}"/>
            <Button x:Name="OpenTerminalBtn" Content="Open PowerShell"
                    Click="OpenTerminal_Click"/>
            <Button x:Name="RecheckClaudeBtn" Content="Recheck"
                    Click="RecheckClaude_Click"/>
          </StackPanel>
        </StackPanel>

        <TextBlock x:Name="ClaudeHelpText" TextWrapping="Wrap" FontSize="12"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Text="After it finishes installing, click Recheck. You may need to reopen Dimmy so the new PATH is seen."
                   Visibility="Collapsed"/>
      </StackPanel>

      <!-- ════ Step 2 - Sign in + Test ════ -->
      <StackPanel x:Name="Step3Panel" Spacing="12" Visibility="Collapsed">
        <TextBlock Text="2 - Sign in to Claude"
                   FontSize="18" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Click Sign in to open a terminal window with the Claude CLI's browser-based OAuth flow. Complete it in your browser, then come back, Dimmy will detect the login and run a quick test."/>

        <Border x:Name="SignInStatusBorder"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="14">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <FontIcon x:Name="SignInGlyph" FontSize="20"
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE9F5;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock x:Name="SignInText" VerticalAlignment="Center"
                         FontSize="13" TextWrapping="Wrap"
                         Text="Checking sign-in status…"/>
              <ProgressRing x:Name="SignInRing" Width="16" Height="16"
                            IsActive="False" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                        x:Name="TestStatusRow" Visibility="Collapsed">
              <FontIcon x:Name="TestGlyph" FontSize="20"
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE9F5;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock x:Name="TestText" VerticalAlignment="Center"
                         FontSize="13" TextWrapping="Wrap"
                         Text="Test connection: waiting…"/>
              <ProgressRing x:Name="TestRing" Width="16" Height="16"
                            IsActive="False" Visibility="Collapsed"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel x:Name="SignInActionPanel" Orientation="Horizontal" Spacing="10">
          <Button x:Name="SignInBtn" Content="Sign in"
                  Click="SignIn_Click"
                  Style="{ThemeResource AccentButtonStyle}"/>
          <Button x:Name="RecheckSignInBtn" Content="Recheck"
                  Click="RecheckSignIn_Click"/>
          <Button x:Name="RetryTestBtn" Content="Retry test"
                  Click="RetryTest_Click"
                  Visibility="Collapsed"/>
        </StackPanel>

        <Border Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12,10,12,10"
                Margin="0,8,0,0">
          <TextBlock TextWrapping="Wrap" FontSize="11"
                     Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                     Text="Dimmy launches the Claude Code CLI as a local subprocess and uses its stored login. Requires your active Anthropic subscription. Subject to Anthropic's terms of service."/>
        </Border>
      </StackPanel>

    </Grid>
  </Grid>
</ContentDialog>
