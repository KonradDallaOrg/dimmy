<?xml version="1.0" encoding="utf-8"?>
<!--
  Claude Code subscription setup wizard.

  Guided 3-page flow, one ContentDialog. Code-behind state machine flips
  PageNPanel visibility + relabels the dialog buttons per page. Mirror of
  CodexConnectDialog.

    Page 1 - Install : pick an install command (winget / PowerShell / npm);
                       the command updates with the tab, a copy icon sits
                       next to it, footer "Next" advances.
    Page 2 - Run     : Install now -> opens a terminal that auto-runs the
                       command, then auto-advance.
    Page 3 - Finish  : poll for the claude binary, sign in if needed,
                       green check -> Done.

  Minimal copy on each page; the extra detail lives behind the (i) info
  buttons, like the rest of Settings. Default install command is winget: it
  runs in plain cmd (or any shell), needs neither PowerShell 7 nor Node.js.
-->
<ContentDialog
    x:Class="Dimmy.Windows.Views.ClaudeConnectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Set up Claude subscription"
    PrimaryButtonText="Next"
    SecondaryButtonText="Back"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick"
    SecondaryButtonClick="OnSecondaryClick"
    CloseButtonClick="OnCloseClick">

  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
  </ContentDialog.Resources>

  <Grid RowSpacing="{StaticResource DimmySpaceL}" MinHeight="300">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Progress dots -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="{StaticResource DimmySpaceS}"
                HorizontalAlignment="Center" Margin="0,0,0,4">
      <Ellipse x:Name="Dot1" Width="10" Height="10"
               Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
      <Ellipse x:Name="Dot2" Width="10" Height="10"
               Fill="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Ellipse x:Name="Dot3" Width="10" Height="10"
               Fill="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>

    <Grid Grid.Row="1">

      <!-- Page 1 - Install -->
      <StackPanel x:Name="Page1Panel" Spacing="{StaticResource DimmySpaceM}" Visibility="Visible">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceS}" VerticalAlignment="Center">
          <TextBlock Text="1 - Install Claude Code" Style="{StaticResource DimmyHeadline}"/>
          <Button Background="Transparent" BorderThickness="0" Padding="2"
                  VerticalAlignment="Center"
                  ToolTipService.ToolTip="About installing Claude Code">
            <FontIcon Glyph="&#xE946;" FontSize="{StaticResource DimmyIconM}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button.Flyout>
              <Flyout>
                <TextBlock Width="300" TextWrapping="Wrap" Style="{StaticResource DimmyBody}"
                           Text="Claude Code is a small standalone CLI from Anthropic. No Node.js required. winget is built into Windows and runs in any terminal (including cmd). The PowerShell installer needs PowerShell 7; npm is the legacy path."/>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <!-- Command source tabs -->
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceS}">
          <RadioButton x:Name="TabWinget" Content="winget" GroupName="CmdTab"
                       Checked="CmdTab_Checked" IsChecked="True"/>
          <RadioButton x:Name="TabPwsh" Content="PowerShell" GroupName="CmdTab"
                       Checked="CmdTab_Checked"/>
          <RadioButton x:Name="TabNpm" Content="npm" GroupName="CmdTab"
                       Checked="CmdTab_Checked"/>
        </StackPanel>

        <Border Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                CornerRadius="4" Padding="12,6,6,6">
          <Grid ColumnSpacing="{StaticResource DimmySpaceS}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CommandText"
                       Text="winget install Anthropic.ClaudeCode"
                       FontFamily="Consolas, Menlo, monospace"
                       Style="{StaticResource DimmyBody}" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       IsTextSelectionEnabled="True"/>
            <Button x:Name="CopyCmdBtn" Grid.Column="1"
                    Background="Transparent" BorderThickness="0" Padding="6"
                    VerticalAlignment="Center"
                    Click="CopyCmd_Click"
                    AutomationProperties.Name="Copy command"
                    ToolTipService.ToolTip="Copy command">
              <FontIcon x:Name="CopyCmdGlyph" Glyph="&#xE8C8;" FontSize="{StaticResource DimmyIconM}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Button>
          </Grid>
        </Border>

        <HyperlinkButton Content="See Anthropic's official install page"
                         NavigateUri="https://github.com/anthropics/claude-code"
                         FontSize="{StaticResource DimmyFontCaption}" Padding="0"/>
      </StackPanel>

      <!-- Page 2 - Run -->
      <StackPanel x:Name="Page2Panel" Spacing="{StaticResource DimmySpaceM}" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceS}" VerticalAlignment="Center">
          <TextBlock Text="2 - Run it" Style="{StaticResource DimmyHeadline}"/>
          <Button Background="Transparent" BorderThickness="0" Padding="2"
                  VerticalAlignment="Center"
                  ToolTipService.ToolTip="What happens in the terminal">
            <FontIcon Glyph="&#xE946;" FontSize="{StaticResource DimmyIconM}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button.Flyout>
              <Flyout>
                <TextBlock Width="300" TextWrapping="Wrap" Style="{StaticResource DimmyBody}"
                           Text="A terminal opens and runs the install automatically. Wait until it finishes, then come back to this window. (The command is also on your clipboard as a fallback.)"/>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Style="{StaticResource DimmySecondary}"
                   Text="A terminal opens and runs the install for you. Wait for it to finish, then come back."/>

        <Button x:Name="OpenTerminalBtn" Content="Install now"
                Click="OpenTerminal_Click"
                Style="{ThemeResource AccentButtonStyle}"
                HorizontalAlignment="Left"/>
      </StackPanel>

      <!-- Page 3 - Finish -->
      <StackPanel x:Name="Page3Panel" Spacing="{StaticResource DimmySpaceM}" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceS}" VerticalAlignment="Center">
          <TextBlock Text="3 - Finish" Style="{StaticResource DimmyHeadline}"/>
          <Button Background="Transparent" BorderThickness="0" Padding="2"
                  VerticalAlignment="Center"
                  ToolTipService.ToolTip="About this step">
            <FontIcon Glyph="&#xE946;" FontSize="{StaticResource DimmyIconM}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button.Flyout>
              <Flyout>
                <TextBlock Width="300" TextWrapping="Wrap" Style="{StaticResource DimmyBody}"
                           Text="Dimmy launches the Claude Code CLI as a local subprocess and uses its stored login. Requires your active Anthropic subscription. Dimmy never sees your token. Subject to Anthropic's terms."/>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <Border Style="{StaticResource DimmyCard}" Padding="{StaticResource DimmyCardPaddingCompact}">
          <StackPanel Spacing="{StaticResource DimmySpaceM}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}" VerticalAlignment="Center">
              <FontIcon x:Name="InstallGlyph" FontSize="{StaticResource DimmyIconXL}"
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE9F5;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock x:Name="InstallText" VerticalAlignment="Center"
                         Style="{StaticResource DimmyBody}" TextWrapping="Wrap"
                         Text="Looking for the Claude Code CLI..."/>
              <ProgressRing x:Name="InstallRing" Width="16" Height="16"
                            IsActive="True"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}" VerticalAlignment="Center"
                        x:Name="SignInRow" Visibility="Collapsed">
              <FontIcon x:Name="SignInGlyph" FontSize="{StaticResource DimmyIconXL}"
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE9F5;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock x:Name="SignInText" VerticalAlignment="Center"
                         Style="{StaticResource DimmyBody}" TextWrapping="Wrap"
                         Text="Sign in to Claude"/>
              <ProgressRing x:Name="SignInRing" Width="16" Height="16"
                            IsActive="False" Visibility="Collapsed"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="{StaticResource DimmySpaceM}">
          <Button x:Name="SignInBtn" Content="Sign in to Claude"
                  Click="SignIn_Click"
                  Style="{ThemeResource AccentButtonStyle}"
                  Visibility="Collapsed"/>
          <Button x:Name="RecheckBtn" Content="Recheck" Click="Recheck_Click"/>
        </StackPanel>
      </StackPanel>

    </Grid>
  </Grid>
</ContentDialog>
