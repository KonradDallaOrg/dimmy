<?xml version="1.0" encoding="utf-8"?>
<!--
  Claude Code subscription setup wizard.

  Three linear steps, one ContentDialog. Same shape as
  NotionConnectDialog: state machine in code-behind toggles
  Step1Panel / Step2Panel / Step3Panel visibility, the dialog
  buttons (Primary/Secondary/Close) get relabeled per step.

  Smart-skip on entry: when the dialog opens we probe node +
  claude + credentials state once and start on the FIRST step
  whose precondition is missing. Anyone already past a step
  doesn't see it.

  Flow:
    Step 1 — Install Node.js  → opens nodejs.org + recheck
    Step 2 — Install Claude CLI → copy npm command + open
                                  terminal + recheck
    Step 3 — Sign in + test    → spawn `claude /login`, poll
                                  credentials, auto-fire test ping
-->
<ContentDialog
    x:Class="Dimmy.Windows.Views.ClaudeConnectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Set up Claude subscription"
    PrimaryButtonText="Next"
    SecondaryButtonText="Back"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick"
    SecondaryButtonClick="OnSecondaryClick"
    CloseButtonClick="OnCloseClick">

  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">580</x:Double>
    <x:Double x:Key="ContentDialogMinWidth">580</x:Double>
  </ContentDialog.Resources>

  <Grid RowSpacing="14" MinHeight="420">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ── Progress dots ───────────────────────────────────────── -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Center" Margin="0,0,0,4">
      <Ellipse x:Name="Dot1" Width="10" Height="10"
               Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
      <Ellipse x:Name="Dot2" Width="10" Height="10"
               Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>
      <Ellipse x:Name="Dot3" Width="10" Height="10"
               Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>
    </StackPanel>

    <Grid Grid.Row="1">

      <!-- ════ Step 1 — Node.js ════ -->
      <StackPanel x:Name="Step1Panel" Spacing="12" Visibility="Visible">
        <TextBlock Text="1 — Install Node.js"
                   FontSize="18" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Claude Code is a Node.js CLI. We need Node 18 or newer before installing it. The official installer adds Node to your PATH automatically."/>

        <Border x:Name="NodeStatusBorder"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="14">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <FontIcon x:Name="NodeStatusGlyph" FontSize="20"
                      Glyph="&#xE9F5;"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="NodeStatusText" VerticalAlignment="Center"
                       FontSize="13" TextWrapping="Wrap"
                       Text="Checking for Node.js…"/>
          </StackPanel>
        </Border>

        <StackPanel x:Name="NodeActionPanel" Orientation="Horizontal" Spacing="10"
                    Visibility="Collapsed">
          <Button x:Name="OpenNodeJsBtn" Content="Open nodejs.org"
                  Click="OpenNodeJs_Click"
                  Style="{ThemeResource AccentButtonStyle}"/>
          <Button x:Name="RecheckNodeBtn" Content="Recheck"
                  Click="RecheckNode_Click"/>
        </StackPanel>

        <TextBlock x:Name="NodeHelpText" TextWrapping="Wrap" FontSize="12"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Text="After installing, you may need to restart Dimmy so the new PATH is picked up. If Recheck still shows 'not found' after install, close Dimmy completely and reopen."
                   Visibility="Collapsed"/>
      </StackPanel>

      <!-- ════ Step 2 — Claude CLI ════ -->
      <StackPanel x:Name="Step2Panel" Spacing="12" Visibility="Collapsed">
        <TextBlock Text="2 — Install Claude CLI"
                   FontSize="18" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="The CLI ships via npm. Open a terminal, paste the command below, press Enter — npm downloads and installs claude-code globally."/>

        <Border x:Name="ClaudeStatusBorder"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="14">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <FontIcon x:Name="ClaudeStatusGlyph" FontSize="20"
                      Glyph="&#xE9F5;"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="ClaudeStatusText" VerticalAlignment="Center"
                       FontSize="13" TextWrapping="Wrap"
                       Text="Checking for Claude CLI…"/>
          </StackPanel>
        </Border>

        <StackPanel x:Name="ClaudeActionPanel" Visibility="Collapsed" Spacing="10">
          <Border Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                  CornerRadius="4" Padding="12,8,12,8">
            <TextBlock x:Name="NpmCommandText"
                       Text="npm install -g @anthropic-ai/claude-code"
                       FontFamily="Consolas, Menlo, monospace"
                       FontSize="13" TextWrapping="NoWrap"
                       IsTextSelectionEnabled="True"/>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="CopyCmdBtn" Content="Copy command"
                    Click="CopyNpmCommand_Click"
                    Style="{ThemeResource AccentButtonStyle}"/>
            <Button x:Name="OpenTerminalBtn" Content="Open PowerShell"
                    Click="OpenTerminal_Click"/>
            <Button x:Name="RecheckClaudeBtn" Content="Recheck"
                    Click="RecheckClaude_Click"/>
          </StackPanel>
        </StackPanel>

        <TextBlock x:Name="ClaudeHelpText" TextWrapping="Wrap" FontSize="12"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Text="If npm reports a permission error, run PowerShell as administrator or set a per-user prefix: npm config set prefix %APPDATA%\npm"
                   Visibility="Collapsed"/>
      </StackPanel>

      <!-- ════ Step 3 — Sign in + Test ════ -->
      <StackPanel x:Name="Step3Panel" Spacing="12" Visibility="Collapsed">
        <TextBlock Text="3 — Sign in to Claude"
                   FontSize="18" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Click Sign in to open a terminal window with the Claude CLI's browser-based OAuth flow. Complete it in your browser, then come back — Dimmy will detect the login and run a quick test."/>

        <Border x:Name="SignInStatusBorder"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="14">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <FontIcon x:Name="SignInGlyph" FontSize="20"
                        Glyph="&#xE9F5;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock x:Name="SignInText" VerticalAlignment="Center"
                         FontSize="13" TextWrapping="Wrap"
                         Text="Checking sign-in status…"/>
              <ProgressRing x:Name="SignInRing" Width="16" Height="16"
                            IsActive="False" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                        x:Name="TestStatusRow" Visibility="Collapsed">
              <FontIcon x:Name="TestGlyph" FontSize="20"
                        Glyph="&#xE9F5;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock x:Name="TestText" VerticalAlignment="Center"
                         FontSize="13" TextWrapping="Wrap"
                         Text="Test connection: waiting…"/>
              <ProgressRing x:Name="TestRing" Width="16" Height="16"
                            IsActive="False" Visibility="Collapsed"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel x:Name="SignInActionPanel" Orientation="Horizontal" Spacing="10">
          <Button x:Name="SignInBtn" Content="Sign in"
                  Click="SignIn_Click"
                  Style="{ThemeResource AccentButtonStyle}"/>
          <Button x:Name="RecheckSignInBtn" Content="Recheck"
                  Click="RecheckSignIn_Click"/>
          <Button x:Name="RetryTestBtn" Content="Retry test"
                  Click="RetryTest_Click"
                  Visibility="Collapsed"/>
        </StackPanel>

        <Border Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12,10,12,10"
                Margin="0,8,0,0">
          <TextBlock TextWrapping="Wrap" FontSize="11"
                     Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                     Text="Dimmy launches the Claude Code CLI as a local subprocess and uses its stored login. Requires your active Anthropic subscription. Subject to Anthropic's terms of service."/>
        </Border>
      </StackPanel>

    </Grid>
  </Grid>
</ContentDialog>
