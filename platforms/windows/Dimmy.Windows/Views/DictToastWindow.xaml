<?xml version="1.0" encoding="utf-8"?>
<!--
  Short feedback ("Added to dictionary", "Shortcut conflict", "Recap
  failed") drawn as a Windows 11 notification: the window IS the card,
  acrylic, rounded and shadowed by DWM, the app named on top. Not a real
  AppNotification: unpackaged WinAppSDK apps drop those silently
  (2026-05-11). Size, place, focus and timer live in DictToastWindow.xaml.cs.
-->
<Window
    x:Class="Dimmy.Windows.Views.DictToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid x:Name="Root" Padding="16,12,16,14" Background="Transparent">
    <Grid.ChildrenTransitions>
      <TransitionCollection>
        <EntranceThemeTransition FromHorizontalOffset="40" FromVerticalOffset="0" />
      </TransitionCollection>
    </Grid.ChildrenTransitions>
    <StackPanel x:Name="Card" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
        <Image Source="ms-appx:///Assets/dimmy-logo.png" Width="16" Height="16" />
        <TextBlock Text="Dimmy" Style="{StaticResource DimmyCaption}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock x:Name="TitleText" Style="{StaticResource DimmyCardTitle}"
                 TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="BodyText" Style="{StaticResource DimmySecondary}"
                 TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </Grid>
</Window>
