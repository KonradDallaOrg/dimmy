<?xml version="1.0" encoding="utf-8"?>
<!--
  Transient "added to dictionary" feedback popup. Pure WinUI 3
  window — no COM, no AppNotificationManager, no MSIX packaging
  requirement. Unpackaged WinAppSDK apps can't surface real Win11
  toasts reliably (silent-drop to Action Center 2026-05-11), so we
  show this small floating card ourselves and auto-close it.

  Borrowless transparent backdrop matches the existing pill / caption
  windows. Positioning + dismissal timer live in DictToastWindow.xaml.cs.
-->
<Window
    x:Class="Dimmy.Windows.Views.DictToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Background="Transparent">
    <Border x:Name="ToastCard"
            Background="#FF1F1F1F"
            BorderBrush="#33FFFFFF" BorderThickness="1"
            CornerRadius="10"
            Padding="16,12"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            MinWidth="280" MaxWidth="380">
      <StackPanel Spacing="2">
        <TextBlock x:Name="TitleText"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="#FFF2F2F2"/>
        <TextBlock x:Name="BodyText"
                   FontSize="12"
                   Foreground="#FFB0B0B0"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
