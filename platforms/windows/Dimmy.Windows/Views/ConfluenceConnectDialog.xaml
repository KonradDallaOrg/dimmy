<?xml version="1.0" encoding="utf-8"?>
<!--
  Confluence connection wizard.

  TWO steps, where the Notion one needs three. Notion spends a whole step
  teaching the user to create an integration and share a page with it; an
  Atlassian API token needs no such setup and already carries the user's own
  permissions, so "prepare" and "paste" collapse into one screen.

  Step 1 asks for the three things only the user knows (site, email, token)
  and refuses to advance until they have been checked against the live API —
  a wizard that lets you past a bad credential just moves the failure to the
  first recap.

  Step 2 picks the destination. Personal spaces sort first and one is
  preselected: a recap of your own meeting belongs in your own space until
  you say otherwise, and that makes the common path zero decisions.
-->
<ContentDialog
    x:Class="Dimmy.Windows.Views.ConfluenceConnectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Connect Confluence"
    PrimaryButtonText="Next"
    SecondaryButtonText="Back"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick"
    SecondaryButtonClick="OnSecondaryClick"
    CloseButtonClick="OnCloseClick">

  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
  </ContentDialog.Resources>

  <Grid RowSpacing="14" MinHeight="340">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Center" Margin="0,0,0,4">
      <Ellipse x:Name="Dot1" Width="10" Height="10"
               Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
      <Ellipse x:Name="Dot2" Width="10" Height="10"
               Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>
    </StackPanel>

    <Grid Grid.Row="1">

      <!-- ════ Step 1 — credentials ════ -->
      <StackPanel x:Name="Step1Panel" Spacing="12" Visibility="Visible">
        <TextBlock Text="Sign in to your Confluence"
                   FontSize="16" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Dimmy writes recap pages as you, with your own permissions. It never reads anything else."/>

        <TextBox x:Name="SiteBox" Header="Confluence site"
                 PlaceholderText="yourcompany.atlassian.net"
                 TextChanged="OnCredentialChanged"/>
        <TextBox x:Name="EmailBox" Header="Atlassian account email"
                 PlaceholderText="name@company.com"
                 TextChanged="OnCredentialChanged"/>
        <PasswordBox x:Name="TokenBox" Header="API token"
                     PlaceholderText="Paste the token you just created"
                     PasswordChanged="OnCredentialChanged"/>

        <!-- Atlassian issues two kinds of token and the page offers both, so
             say which is fine rather than leaving the user to guess. Either
             works; a scoped one needs exactly these two. -->
        <TextBlock TextWrapping="Wrap" FontSize="12"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Text="A plain API token works. If you create one with scopes, it needs read:space:confluence and write:page:confluence."/>

        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Content="Create an API token" Click="OpenTokenPage_Click"/>
          <Button x:Name="VerifyBtn" Content="Check" Click="Verify_Click"
                  Style="{ThemeResource AccentButtonStyle}"/>
          <ProgressRing x:Name="VerifyRing" Width="18" Height="18"
                        IsActive="False" Visibility="Collapsed"/>
          <TextBlock x:Name="VerifyStatus" VerticalAlignment="Center"
                     FontSize="13" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>

      <!-- ════ Step 2 — destination ════ -->
      <StackPanel x:Name="Step2Panel" Spacing="12" Visibility="Collapsed">
        <TextBlock Text="Where should recaps go?"
                   FontSize="16" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Each recap becomes a new page in this space. Your personal space is picked by default."/>

        <!-- A filter, not a nicety: a real tenant returned 530 spaces, and
             when the token cannot identify the user (granular scopes have
             no user scope at all) their own space is somewhere in that
             list rather than preselected. Typing a name is the only way
             through it. -->
        <TextBox x:Name="SpaceFilterBox" Header="Space"
                 PlaceholderText="Type to filter, e.g. your name"
                 TextChanged="OnSpaceFilterChanged"/>
        <ComboBox x:Name="SpaceCombo"
                  HorizontalAlignment="Stretch"
                  SelectionChanged="OnSpaceSelectionChanged"
                  PlaceholderText="Loading spaces..."/>

        <!-- Auto-send lives in Settings, not here, exactly as Notion does it:
             it is a single switch a user flips over time, and burying it in a
             wizard means the only way to change your mind is to re-run setup. -->
        <TextBlock TextWrapping="Wrap" FontSize="12"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Text="Recaps are sent when you click Send on a meeting. You can turn on automatic sending in Settings afterwards. Every page carries a visible note saying it was generated with AI."/>

        <TextBlock x:Name="SpaceStatus" FontSize="13" TextWrapping="Wrap"/>
      </StackPanel>

    </Grid>
  </Grid>
</ContentDialog>
