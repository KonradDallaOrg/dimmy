<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dimmy.Windows.Views.TelegramNudgeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="RootBorder"
            BorderThickness="0"
            CornerRadius="8"
            Padding="14,8,14,8">
        <Grid RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0"
                          x:Name="HeaderIcon"
                          FontFamily="Segoe Fluent Icons"
                          Glyph="&#xE724;"
                          FontSize="15"
                          VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           x:Name="TitleText"
                           Text="New audio from Telegram"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2"
                        x:Name="CloseButton"
                        Width="28" Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ToolTipService.ToolTip="Dismiss"
                        Click="OnCloseClicked">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE894;" FontSize="11" />
                </Button>
            </Grid>

            <TextBlock Grid.Row="1"
                       x:Name="BodyText"
                       Text="Transcribe and recap it?"
                       FontSize="12"
                       Opacity="0.8"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="6">
                <Button x:Name="DismissButton"
                        Content="Dismiss"
                        MinWidth="78"
                        Padding="10,3,10,3"
                        FontSize="12"
                        Click="OnDismissClicked" />
                <Button x:Name="AcceptButton"
                        Content="Transcribe + recap"
                        MinWidth="130"
                        Padding="10,3,10,3"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="OnAcceptClicked" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
