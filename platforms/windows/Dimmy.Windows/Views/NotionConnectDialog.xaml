<?xml version="1.0" encoding="utf-8"?>
<!--
  Notion connection wizard.

  Three steps, one ContentDialog. The state machine in code-behind
  flips Step1Panel/Step2Panel/Step3Panel visibility and the progress
  dot colours; the dialog buttons stay constant (Back/Next/Done) and
  their Click handlers ask the state machine which way to go.

  Re-runnable: callers pass an `initialStep` to ShowAsync (1 = full
  setup, 3 = "change destination" — token already valid, jump
  straight to the picker). When relaunched at step 3 the wizard
  refreshes the list automatically; when relaunched at step 1 the
  user can either re-paste a token or skip to step 3 if a valid one
  is already on disk.
-->
<ContentDialog
    x:Class="Dimmy.Windows.Views.NotionConnectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Connect Notion"
    PrimaryButtonText="Next"
    SecondaryButtonText="Back"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick"
    SecondaryButtonClick="OnSecondaryClick"
    CloseButtonClick="OnCloseClick">

  <ContentDialog.Resources>
    <!-- Override the default ContentDialog max width so our 3-step
         wizard has room to breathe (default is ~548 px which clips
         the destination list on narrow titles). -->
    <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
  </ContentDialog.Resources>

  <Grid RowSpacing="14" MinHeight="380">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ── Progress dots ───────────────────────────────────────── -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Center" Margin="0,0,0,4">
      <Ellipse x:Name="Dot1" Width="10" Height="10"
               Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
      <Ellipse x:Name="Dot2" Width="10" Height="10"
               Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>
      <Ellipse x:Name="Dot3" Width="10" Height="10"
               Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>
    </StackPanel>

    <!-- ── Step body — one panel per step, only one Visible at a time ── -->
    <Grid Grid.Row="1">

      <!-- ════ Step 1 — prepare in Notion ════ -->
      <StackPanel x:Name="Step1Panel" Spacing="12" Visibility="Visible">
        <TextBlock Text="1 — Prepare your Notion workspace"
                   FontSize="18" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Dimmy uploads recaps via a private Notion integration. You'll do this once."/>

        <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="14">
          <StackPanel Spacing="10">
            <TextBlock TextWrapping="Wrap" FontSize="13">
              <Run FontWeight="SemiBold">a.</Run>
              <Run Text=" Open the Notion integrations page (link below)."/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="13">
              <Run FontWeight="SemiBold">b.</Run>
              <Run Text=" Click "/>
              <Run FontStyle="Italic" Text="New integration"/>
              <Run Text=", give it a name like "/>
              <Run FontStyle="Italic" Text="Dimmy"/>
              <Run Text=", pick your workspace, save."/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="13">
              <Run FontWeight="SemiBold">c.</Run>
              <Run Text=" On the integration page, copy the "/>
              <Run FontStyle="Italic" Text="Internal Integration Secret"/>
              <Run Text=" — this is your token. Keep this tab open."/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="13">
              <Run FontWeight="SemiBold">d.</Run>
              <Run Text=" Open the Notion page (or database) you want recaps to land in. Click "/>
              <Run FontStyle="Italic" Text="···"/>
              <Run Text=" → "/>
              <Run FontStyle="Italic" Text="Connections"/>
              <Run Text=" → add your new integration."/>
            </TextBlock>
          </StackPanel>
        </Border>

        <Button Content="Open Notion integrations" Click="OpenIntegrations_Click"
                HorizontalAlignment="Left"/>
        <TextBlock TextWrapping="Wrap" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="When you have the token copied and the page connected, click Next."/>
      </StackPanel>

      <!-- ════ Step 2 — paste + verify ════ -->
      <StackPanel x:Name="Step2Panel" Spacing="12" Visibility="Collapsed">
        <TextBlock Text="2 — Paste your token"
                   FontSize="18" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Tokens stay on this device, encrypted in Dimmy's local keystore. They never appear in config.json."/>

        <PasswordBox x:Name="TokenBox"
                     PlaceholderText="ntn_xxxxxxxxxxxxxxxx"
                     PasswordChanged="TokenBox_Changed"/>

        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button x:Name="VerifyBtn" Content="Verify" Click="VerifyToken_Click"
                  IsEnabled="False"/>
          <ProgressRing x:Name="VerifyRing" Width="20" Height="20"
                        IsActive="False" Visibility="Collapsed"/>
          <FontIcon x:Name="VerifyOkGlyph" Glyph="&#xE73E;"
                    FontSize="18"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Visibility="Collapsed"/>
          <TextBlock x:Name="VerifyStatus" VerticalAlignment="Center"
                     FontSize="13" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>

      <!-- ════ Step 3 — pick destination ════ -->
      <StackPanel x:Name="Step3Panel" Spacing="12" Visibility="Collapsed">
        <TextBlock Text="3 — Pick a destination"
                   FontSize="18" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Dimmy lists every page or database your integration can see. If your page isn't here, open it in Notion → ··· → Connections → add your integration, then refresh."/>

        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button x:Name="RefreshBtn" Content="Refresh list" Click="RefreshList_Click"/>
          <ProgressRing x:Name="RefreshRing" Width="20" Height="20"
                        IsActive="False" Visibility="Collapsed"/>
          <TextBlock x:Name="RefreshStatus" VerticalAlignment="Center"
                     FontSize="13" TextWrapping="Wrap"/>
        </StackPanel>

        <ComboBox x:Name="TargetCombo"
                  PlaceholderText="Select a page or database…"
                  HorizontalAlignment="Stretch"
                  SelectionChanged="TargetCombo_SelectionChanged"/>
      </StackPanel>

    </Grid>
  </Grid>
</ContentDialog>
