<?xml version="1.0" encoding="utf-8"?>
<!--
  Gemini CLI (Google account) setup wizard.

  Same 3-page shape as the Codex wizard, one ContentDialog, code-behind
  state machine flipping PageNPanel visibility and relabelling the footer.

    Page 1 - Install : pick an install command (npm / Homebrew); the
                       command follows the tab, copy icon beside it.
    Page 2 - Run     : Install now -> a terminal runs it.
    Page 3 - Finish  : poll for the binary, sign in if needed, green check.

  Two differences from Codex, both from the CLI rather than from taste:

  - There is no `gemini login`. A first run with no credentials shows the
    auth picker itself, so "Sign in" launches the CLI bare and the user
    picks "Login with Google" in the terminal.
  - The npm path needs Node 20+, unlike Codex's standalone binary. That is
    why npm is the DEFAULT tab here and the only universally available one
    on Windows: there is no winget package.
-->
<ContentDialog
    x:Class="Dimmy.Windows.Views.GeminiConnectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Set up Gemini"
    PrimaryButtonText="Next"
    SecondaryButtonText="Back"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick"
    SecondaryButtonClick="OnSecondaryClick"
    CloseButtonClick="OnCloseClick">

  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
  </ContentDialog.Resources>

  <Grid RowSpacing="14" MinHeight="300">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Progress dots -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Center" Margin="0,0,0,4">
      <Ellipse x:Name="Dot1" Width="10" Height="10"
               Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
      <Ellipse x:Name="Dot2" Width="10" Height="10"
               Fill="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Ellipse x:Name="Dot3" Width="10" Height="10"
               Fill="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>

    <Grid Grid.Row="1">

      <!-- Page 1 - Install -->
      <StackPanel x:Name="Page1Panel" Spacing="12" Visibility="Visible">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="1 - Install the Gemini CLI" FontSize="18" FontWeight="SemiBold"/>
          <Button Background="Transparent" BorderThickness="0" Padding="2"
                  VerticalAlignment="Center"
                  ToolTipService.ToolTip="About installing the Gemini CLI">
            <FontIcon Glyph="&#xE946;" FontSize="14"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button.Flyout>
              <Flyout>
                <TextBlock Width="320" TextWrapping="Wrap" FontSize="13"
                           Text="Google's official command-line tool, published on npm, so it needs Node.js 20 or newer. There is no winget package. This is NOT the Gemini desktop app: that one has no way for another program to talk to it."/>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <!-- Command source tabs -->
        <StackPanel Orientation="Horizontal" Spacing="6">
          <RadioButton x:Name="TabNpm" Content="npm" GroupName="CmdTab"
                       Checked="CmdTab_Checked" IsChecked="True"/>
          <RadioButton x:Name="TabNpx" Content="npx (no install)" GroupName="CmdTab"
                       Checked="CmdTab_Checked"/>
          <RadioButton x:Name="TabBrew" Content="Homebrew" GroupName="CmdTab"
                       Checked="CmdTab_Checked"/>
        </StackPanel>

        <Border Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                CornerRadius="4" Padding="12,6,6,6">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CommandText"
                       Text="npm install -g @google/gemini-cli"
                       FontFamily="Consolas, Menlo, monospace"
                       FontSize="13" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       IsTextSelectionEnabled="True"/>
            <Button x:Name="CopyCmdBtn" Grid.Column="1"
                    Background="Transparent" BorderThickness="0" Padding="6"
                    VerticalAlignment="Center"
                    Click="CopyCmd_Click"
                    AutomationProperties.Name="Copy command"
                    ToolTipService.ToolTip="Copy command">
              <FontIcon x:Name="CopyCmdGlyph" Glyph="&#xE8C8;" FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Button>
          </Grid>
        </Border>

        <TextBlock x:Name="TabNoteText" TextWrapping="Wrap" FontSize="12"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Text="Needs Node.js 20 or newer."/>

        <HyperlinkButton Content="See Google's official install page"
                         NavigateUri="https://github.com/google-gemini/gemini-cli"
                         FontSize="12" Padding="0"/>
      </StackPanel>

      <!-- Page 2 - Run -->
      <StackPanel x:Name="Page2Panel" Spacing="12" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="2 - Run it" FontSize="18" FontWeight="SemiBold"/>
          <Button Background="Transparent" BorderThickness="0" Padding="2"
                  VerticalAlignment="Center"
                  ToolTipService.ToolTip="What to do in the terminal">
            <FontIcon Glyph="&#xE946;" FontSize="14"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button.Flyout>
              <Flyout>
                <TextBlock Width="320" TextWrapping="Wrap" FontSize="13"
                           Text="A terminal opens and runs the install automatically. Wait until it finishes, then come back to this window. The command is also on your clipboard as a fallback."/>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <TextBlock TextWrapping="Wrap" FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="A terminal opens and runs the install for you. Wait for it to finish, then come back."/>

        <Button x:Name="OpenTerminalBtn" Content="Install now"
                Click="OpenTerminal_Click"
                Style="{ThemeResource AccentButtonStyle}"
                HorizontalAlignment="Left"/>
      </StackPanel>

      <!-- Page 3 - Finish -->
      <StackPanel x:Name="Page3Panel" Spacing="12" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="3 - Finish" FontSize="18" FontWeight="SemiBold"/>
          <Button Background="Transparent" BorderThickness="0" Padding="2"
                  VerticalAlignment="Center"
                  ToolTipService.ToolTip="About this step">
            <FontIcon Glyph="&#xE946;" FontSize="14"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button.Flyout>
              <Flyout>
                <TextBlock Width="320" TextWrapping="Wrap" FontSize="13"
                           Text="Dimmy runs the Gemini CLI as a local subprocess and uses the login it stored. Needs a Gemini Code Assist Standard or Enterprise licence: Google ended individual access (including AI Pro and Ultra) on 18 June 2026, so a personal account will fail here. Dimmy never reads your credentials."/>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="14">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <FontIcon x:Name="InstallGlyph" FontSize="20"
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE9F5;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock x:Name="InstallText" VerticalAlignment="Center"
                         FontSize="13" TextWrapping="Wrap"
                         Text="Looking for the Gemini CLI..."/>
              <ProgressRing x:Name="InstallRing" Width="16" Height="16"
                            IsActive="True"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                        x:Name="SignInRow" Visibility="Collapsed">
              <FontIcon x:Name="SignInGlyph" FontSize="20"
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE9F5;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock x:Name="SignInText" VerticalAlignment="Center"
                         FontSize="13" TextWrapping="Wrap"
                         Text="Sign in with Google"/>
              <ProgressRing x:Name="SignInRing" Width="16" Height="16"
                            IsActive="False" Visibility="Collapsed"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Said here and not only in the flyout: the terminal shows an auth
             picker with several options, and a user who expects a browser to
             just open will sit and wait for it. -->
        <TextBlock x:Name="SignInHint" TextWrapping="Wrap" FontSize="12"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Visibility="Collapsed"
                   Text="The terminal asks how you want to authenticate. Choose 'Login with Google'. If it answers 'no longer supported for Gemini Code Assist for individuals', your account is a personal one and this route is closed."/>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button x:Name="SignInBtn" Content="Sign in with Google"
                  Click="SignIn_Click"
                  Style="{ThemeResource AccentButtonStyle}"
                  Visibility="Collapsed"/>
          <Button x:Name="RecheckBtn" Content="Recheck" Click="Recheck_Click"/>
        </StackPanel>
      </StackPanel>

    </Grid>
  </Grid>
</ContentDialog>
