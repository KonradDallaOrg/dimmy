<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Dimmy.Windows.Views.Controls.WizardCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A button, not a Border with a tap handler: keyboard focus, Enter and
         Space, the hover and pressed visuals and the accessibility name all
         come for free, and a card the user cannot reach with Tab is a card
         some users cannot reach at all. -->
    <Button x:Name="Root" Click="Root_Click"
            Padding="16" MinWidth="150" MinHeight="120"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Top">
        <StackPanel Spacing="{StaticResource DimmySpaceM}" HorizontalAlignment="Center">
            <FontIcon x:Name="Icon" FontSize="{StaticResource DimmyIconXL}"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      HorizontalAlignment="Center" />
            <TextBlock x:Name="TitleText" Style="{StaticResource DimmyCardTitle}"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="DescriptionText" Opacity="0.7" Style="{StaticResource DimmyLabel}"
                       TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Button>
</UserControl>
