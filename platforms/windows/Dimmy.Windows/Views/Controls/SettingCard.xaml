<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Dimmy.Windows.Views.Controls.SettingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Win11 Settings card pattern — replicates `.scard` from the design bundle.

    Layout:
      [icon 24px] [label  (i)                        ] [control]
                  [description (optional, smaller)  ]

    The optional `(i)` info button sits inline next to the label and reveals
    a Flyout carrying the long-form explanation. Mirrors the macOS Tahoe
    redesign rule — short label + short description; verbose copy lives
    off-row. See `MacAtoms.swift` (`MacGroupFooter`, `MacNote`).

    - Min height 64 px (per design tokens).
    - Border 1 px hairline, corner radius 4 px.
    - Background card-bg theme resource.
    - Icon column fixed width 24 px so cards line up vertically.

    Public properties (set from XAML or code):
    - Glyph (string)        — Segoe Fluent codepoint, e.g. "&#xE720;"
    - Label (string)        — primary line
    - Description (string)  — short secondary line, hidden when empty
    - Hint (string)         — long-form explanation behind the (i) button,
                              hidden when empty; ALSO surfaces as the
                              ToolTip on the (i) glyph for hover-only users
    - Control (object)      — the right-side control (default Content slot)
  -->

  <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
          BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1" CornerRadius="4"
          MinHeight="64" Padding="16,12">
    <Grid ColumnSpacing="16" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Icon column. Visibility set from code-behind when Glyph changes. -->
      <FontIcon Grid.Column="0"
                x:Name="GlyphIcon"
                FontSize="16"
                Width="24" Height="24"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

      <!-- Meta: label (+ optional info button) + optional description -->
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock x:Name="LabelText"
                     FontSize="14"
                     VerticalAlignment="Center"
                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
          <!--
            Subtle inline info button. Collapsed by default; OnHintChanged
            in code-behind flips Visibility + populates the Flyout TextBlock
            and the hover ToolTip from a single `Hint` DP.
          -->
          <Button x:Name="HintButton"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="2"
                  MinHeight="0" MinWidth="0"
                  VerticalAlignment="Center"
                  Visibility="Collapsed"
                  AutomationProperties.Name="Show details">
            <FontIcon Glyph="&#xE946;"
                      FontSize="12"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button.Flyout>
              <Flyout>
                <TextBlock x:Name="HintFlyoutText"
                           TextWrapping="Wrap"
                           MaxWidth="320"
                           FontSize="13" />
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <TextBlock x:Name="DescriptionText"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- Control column — caller-provided element via Content slot -->
      <ContentPresenter Grid.Column="2"
                        x:Name="ControlPresenter"
                        VerticalAlignment="Center" />
    </Grid>
  </Border>
</UserControl>
