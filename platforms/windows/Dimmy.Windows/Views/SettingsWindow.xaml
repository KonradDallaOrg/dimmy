                  <ComboBox MinWidth="{StaticResource SettingFieldWidth}"
                            DisplayMemberPath="Value"
                            SelectedValuePath="Key"
                            SelectedValue="{Binding LlmTranslateTo, Mode=TwoWay}"
                            ItemsSource="{Binding TranslateToItems}" />
                </controls:SettingCard>
                <controls:SettingCard Glyph="&#xE82D;"
                                      Label="Custom prompt"
                                      InfoTip="Tells the LLM exactly how to rewrite. Used when the style above is set to Custom."
                                      HelpUrl="https://dimmy.app/help/custom-prompts">
                  <TextBox MinWidth="{StaticResource SettingFieldWidth}" MaxWidth="{StaticResource SettingFieldWidth}"
                           AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                           Text="{Binding LlmCustomPrompt, Mode=TwoWay}" />
                </controls:SettingCard>
              </StackPanel>
            </StackPanel>

            <!-- ═══ Pill overlay (was Overlay) ═══ -->
            <StackPanel x:Name="OverlayPanel" Spacing="4" Visibility="Collapsed">
              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Text="Pill overlay" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="The floating pill. Where it lives and how it looks."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>

              <TextBlock Text="VISIBILITY"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,20,0,8" />
              <controls:SettingCard Glyph="&#xE7E8;"
                                    Label="Show pill on app start"
                                    InfoTip="Off starts Dimmy in taskbar-only mode. The pill stays hidden and recording status shows on the taskbar icon."
                                    HelpUrl="https://dimmy.app/help/pill-overview">
                <ToggleSwitch IsOn="{Binding PillShowOnStartup, Mode=TwoWay}"
                              Toggled="PillVisibilityToggle_Toggled"
                              Style="{StaticResource CompactToggleSwitch}" />
              </controls:SettingCard>
              <controls:SettingCard Glyph="&#xE9F5;"
                                    Label="Show pill when recording"
                                    InfoTip="Off keeps the pill hidden even during recording. Status shows on the taskbar icon with a red dot and level bar."
                                    HelpUrl="https://dimmy.app/help/pill-states">
                <ToggleSwitch IsOn="{Binding PillShowOnHotkey, Mode=TwoWay}"
                              Toggled="PillVisibilityToggle_Toggled"
                              Style="{StaticResource CompactToggleSwitch}" />
              </controls:SettingCard>
              <controls:SettingCard Glyph="&#xE71D;"
                                    Label="Show Dimmy in Windows taskbar"
                                    InfoTip="Adds the icon, a live level bar while recording, and right-click shortcuts. Off keeps Dimmy in the system tray with the hotkey only."
                                    HelpUrl="https://dimmy.app/help/tray-menu">
                <ToggleSwitch IsOn="{Binding ShowTaskbarIcon, Mode=TwoWay}"
                              Toggled="PillVisibilityToggle_Toggled"
                              Style="{StaticResource CompactToggleSwitch}" />
              </controls:SettingCard>

              <TextBlock Text="POSITION"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,20,0,8" />
              <controls:SettingCard Glyph="&#xE759;"
                                    Label="Default position"
                                    InfoTip="Sets the corner the pill starts in. You can always drag it somewhere else."
                                    HelpUrl="https://dimmy.app/help/pill-position">
                <!-- Compact 3×2 grid embedded as the right-side control of the
                     SettingCard — matches the design's wallpaper-position
                     picker. Top-Center is intentionally empty. -->
                <Grid Width="78" Height="50"
                      ColumnSpacing="3" RowSpacing="3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <RadioButton GroupName="OverlayPos" Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource PositionCellStyle}"
                               ToolTipService.ToolTip="Top Left"
                               IsChecked="{Binding OverlayPosition, Mode=TwoWay,
                                            Converter={StaticResource StringToBoolConverter},
                                            ConverterParameter=Top Left}"
                               Checked="OverlayPositionCell_Checked" Tag="Top Left" />
                  <RadioButton GroupName="OverlayPos" Grid.Row="0" Grid.Column="1"
                               Style="{StaticResource PositionCellStyle}"
                               ToolTipService.ToolTip="Top Center"
                               IsChecked="{Binding OverlayPosition, Mode=TwoWay,
                                            Converter={StaticResource StringToBoolConverter},
                                            ConverterParameter=Top Center}"
                               Checked="OverlayPositionCell_Checked" Tag="Top Center" />
                  <RadioButton GroupName="OverlayPos" Grid.Row="0" Grid.Column="2"
                               Style="{StaticResource PositionCellStyle}"
                               ToolTipService.ToolTip="Top Right"
                               IsChecked="{Binding OverlayPosition, Mode=TwoWay,
                                            Converter={StaticResource StringToBoolConverter},
                                            ConverterParameter=Top Right}"
                               Checked="OverlayPositionCell_Checked" Tag="Top Right" />
                  <RadioButton GroupName="OverlayPos" Grid.Row="1" Grid.Column="0"
                               Style="{StaticResource PositionCellStyle}"
                               ToolTipService.ToolTip="Bottom Left"
                               IsChecked="{Binding OverlayPosition, Mode=TwoWay,
                                            Converter={StaticResource StringToBoolConverter},
                                            ConverterParameter=Bottom Left}"
                               Checked="OverlayPositionCell_Checked" Tag="Bottom Left" />
                  <RadioButton GroupName="OverlayPos" Grid.Row="1" Grid.Column="1"
                               Style="{StaticResource PositionCellStyle}"
                               ToolTipService.ToolTip="Bottom Center"
                               IsChecked="{Binding OverlayPosition, Mode=TwoWay,
                                            Converter={StaticResource StringToBoolConverter},
                                            ConverterParameter=Bottom Center}"
                               Checked="OverlayPositionCell_Checked" Tag="Bottom Center" />
                  <RadioButton GroupName="OverlayPos" Grid.Row="1" Grid.Column="2"
                               Style="{StaticResource PositionCellStyle}"
                               ToolTipService.ToolTip="Bottom Right"
                               IsChecked="{Binding OverlayPosition, Mode=TwoWay,
                                            Converter={StaticResource StringToBoolConverter},
                                            ConverterParameter=Bottom Right}"
                               Checked="OverlayPositionCell_Checked" Tag="Bottom Right" />
                </Grid>
              </controls:SettingCard>
              <controls:SettingCard Glyph="&#xE777;"
                                    Label="Reset position"
                                    InfoTip="Moves the pill back to the default position you set above, in case you dragged it off screen."
                                    HelpUrl="https://dimmy.app/help/pill-position">
                <Button Content="Reset" Click="ResetPosition_Click" />
              </controls:SettingCard>

              <TextBlock Text="APPEARANCE"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,20,0,8" />
              <controls:SettingCard Glyph="&#xE790;"
                                    Label="Border style"
                                    InfoTip="Pick the rainbow glow or a solid color. None hides the outline."
                                    HelpUrl="https://dimmy.app/help/pill-overview">
                <ComboBox MinWidth="{StaticResource SettingFieldWidth}"
                          SelectedItem="{Binding BorderStyle, Mode=TwoWay}"
                          SelectionChanged="BorderStyle_SelectionChanged">
                  <x:String>Rainbow</x:String>
                  <x:String>Blue</x:String>
                  <x:String>Green</x:String>
                  <x:String>Purple</x:String>
                  <x:String>Orange</x:String>
                  <x:String>None</x:String>
                </ComboBox>
              </controls:SettingCard>
              <controls:SettingCard Glyph="&#xE9F5;"
                                    Label="Waveform style"
                                    InfoTip="Sets the shape of the live audio animation while you record. Pick whichever you like best."
                                    HelpUrl="https://dimmy.app/help/pill-states">
                <ComboBox MinWidth="{StaticResource SettingFieldWidth}"
                          SelectedItem="{Binding WaveformStyle, Mode=TwoWay}"
                          SelectionChanged="WaveformStyle_SelectionChanged">
                  <x:String>Bars</x:String>
                  <x:String>Bars Center</x:String>
                  <x:String>Bars Round</x:String>
                  <x:String>Line</x:String>
                  <x:String>Dots</x:String>
                </ComboBox>
              </controls:SettingCard>
            </StackPanel>

            <!-- ═══ App rules ═══ -->
            <StackPanel x:Name="RulesPanel" Spacing="12" Visibility="Collapsed">
              <StackPanel Spacing="2" Margin="0,0,0,4">
                <TextBlock Text="App rules" FontSize="28" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Auto-switch style and translation per app." />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button x:Name="AppRuleAddBtn" Click="AppRuleAdd_Click">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock Text="Add rule" />
                  </StackPanel>
                </Button>
                <Button x:Name="AppRuleLoadDefaultsBtn" Click="AppRuleLoadDefaults_Click">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74C;" FontSize="14"/>
                    <TextBlock Text="Load defaults (v1)" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="0">
                <!-- WinUI 3 v3.1.7 ListView built-in CanReorderItems
                     hard-crashes the renderer mid-drag with E_UNEXPECTED
                     in Microsoft.UI.Xaml.dll +0x39ce55 → combase.dll
                     +0x37fc4. The same offset crashes ANY XAML drag
                     pipeline in 1.7.x (CanDrag / DragStarting / Drop on
                     children also reproduces it), not just the
                     CanReorderItems path. Matches microsoft-ui-xaml
                     issues #5607 / #7690; no fix in any shipping
                     WindowsAppSDK through 2.0.1. Bypass: skip ALL XAML
                     drag-drop on the AppRules ListView and drive
                     reorder from raw PointerPressed / PointerReleased
                     / PointerCaptureLost events on a dedicated grip —
                     a completely different input pipeline that doesn't
                     touch IDataObject / IDropTarget at all. -->
                <Grid>
                <ListView x:Name="AppRulesListView"
                          ItemsSource="{Binding AppRules}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          HorizontalContentAlignment="Stretch">
                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Padding" Value="0"/>
                    </Style>
                  </ListView.ItemContainerStyle>
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <!-- Padding cut from 14,10 to 8,4 so the row
                           shrinks from ~56 px to ~36 px. TextBox /
                           ComboBox MinHeight=28 keeps Fluent default
                           hit area without padding the row. -->
                      <Grid ColumnSpacing="8" Padding="8,4" >
                        <!-- Order: icon, pattern (compact), match type,
                             style, translate, ENABLE TOGGLE, delete.
                             Toggle near delete so the row reads
                             "what app → what to do → on/off → remove". -->
                        <!-- Match-type column dropped: this is a Win
                             build, the field is forced to
                             "process_name" at rule-add time. Showing
                             a "Process (Win) / Bundle (Mac) / WM_CLASS
                             (Linux)" combo on every row was making
                             users pick between options that never
                             applied on this OS — pure friction. The
                             field stays in the data model so a
                             Mac-shared config still round-trips. -->
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>      <!-- drag handle -->
                          <ColumnDefinition Width="Auto"/>      <!-- icon -->
                          <ColumnDefinition Width="2*"/>        <!-- pattern -->
                          <ColumnDefinition Width="2*"/>        <!-- style -->
                          <ColumnDefinition Width="1.6*"/>      <!-- translate -->
                          <ColumnDefinition Width="Auto"/>      <!-- enabled toggle -->
                          <ColumnDefinition Width="Auto"/>      <!-- delete -->
                        </Grid.ColumnDefinitions>
                        <!-- Drag handle. Pointer events ONLY — no
                             CanDrag / IDataObject; that path crashes
                             on WinUI 3 1.7.x. Border with transparent
                             background gives a reliable hit area for
                             the FontIcon. -->
                        <Border Grid.Column="0"
                                Background="Transparent"
                                Padding="4,0"
                                VerticalAlignment="Stretch"
                                ToolTipService.ToolTip="Drag to reorder"
                                PointerPressed="AppRuleHandle_PointerPressed"
                                PointerMoved="AppRuleHandle_PointerMoved"
                                PointerReleased="AppRuleHandle_PointerReleased"
                                PointerCaptureLost="AppRuleHandle_PointerCaptureLost">
                          <FontIcon Glyph="&#xE76F;"
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                        </Border>
                        <Grid Grid.Column="1" Width="22" Height="22"
                              VerticalAlignment="Center" Margin="2,0,4,0">
                          <Image Width="22" Height="22"
                                 Source="{Binding IconAssetUri, Mode=OneWay}"
                                 Visibility="{Binding IconAssetUri, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                          <FontIcon Glyph="{Binding IconGlyph, Mode=OneWay}"
                                    FontSize="14"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Visibility="{Binding IconAssetUri, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}, ConverterParameter=Invert}"/>
                        </Grid>
                        <TextBox Grid.Column="2"
                                 VerticalAlignment="Center"
                                 Text="{Binding MatchPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="slack.exe" />
                        <ComboBox Grid.Column="3" SelectedValue="{Binding LlmStyle, Mode=TwoWay}"
                                  SelectedValuePath="Tag" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center">
                          <ComboBoxItem Tag="off"            Content="Off (no LLM)"/>
                          <ComboBoxItem Tag="correct"        Content="Correct"/>
                          <ComboBoxItem Tag="summarize"      Content="Summarize"/>
                          <ComboBoxItem Tag="elaborate"      Content="Elaborate"/>
                          <ComboBoxItem Tag="comprehensible" Content="Comprehensible"/>
                          <ComboBoxItem Tag="professional"   Content="Professional"/>
                          <ComboBoxItem Tag="genz"           Content="Gen-Z"/>
                          <ComboBoxItem Tag="boomer"         Content="Boomer"/>
                          <ComboBoxItem Tag="emoji"          Content="Emoji"/>
                          <ComboBoxItem Tag="acronyms"       Content="Acronyms"/>
                          <ComboBoxItem Tag="imbruttito"     Content="Imbruttito"/>
                          <ComboBoxItem Tag="prompt"         Content="Custom prompt"/>
                        </ComboBox>
                        <ComboBox Grid.Column="4" SelectedValue="{Binding LlmTranslateTo, Mode=TwoWay}"
                                  SelectedValuePath="Tag" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center">
                          <ComboBoxItem Tag=""    Content="No translation"/>
                          <ComboBoxItem Tag="en"  Content="→ English"/>
                          <ComboBoxItem Tag="it"  Content="→ Italiano"/>
                          <ComboBoxItem Tag="es"  Content="→ Español"/>
                          <ComboBoxItem Tag="fr"  Content="→ Français"/>
                          <ComboBoxItem Tag="de"  Content="→ Deutsch"/>
                          <ComboBoxItem Tag="pt"  Content="→ Português"/>
                        </ComboBox>
                        <ToggleSwitch Grid.Column="5"
                                      IsOn="{Binding Enabled, Mode=TwoWay}"
                                      OnContent="" OffContent="" MinWidth="0"
                                      VerticalAlignment="Center"
                                      ToolTipService.ToolTip="Enable rule"/>
                        <Button Grid.Column="6"
                                Click="AppRuleDelete_Click"
                                Tag="{Binding}"
                                ToolTipService.ToolTip="Remove rule"
                                Background="Transparent"
                                BorderThickness="0">
                          <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <!-- Drop indicator: a 2-px horizontal accent line that
                     follows the cursor between rows during a drag.
                     Hit-testing disabled so it never intercepts pointer
                     events. Margin.Top is updated from PointerMoved. -->
                <Rectangle x:Name="AppRuleDropIndicator"
                           Height="2"
                           Fill="{ThemeResource AccentFillColorDefaultBrush}"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top"
                           Margin="0"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>
                </Grid>
              </Border>

              <TextBlock x:Name="AppRulesEmptyHint"
                         Text="No rules yet. Click Load defaults (v1) to populate from the curated list, or Add rule to start from scratch."
                         FontSize="12"
                         Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                         TextWrapping="Wrap"
                         Visibility="Collapsed"/>
            </StackPanel>

            <!-- ═══ About ═══ -->
            <StackPanel x:Name="AboutPanel" Spacing="4" Visibility="Collapsed">
              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Text="About" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Version, updates, and resources."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>

              <!-- Hero — text on the left, big logo on the right -->
              <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="6" Padding="28,24">
                <Grid ColumnSpacing="20">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="Voice dictation that stays out of your way."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="HeroTitleText" Text="Dimmy"
                               FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeroSubText"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                      <Button x:Name="CheckUpdatesBtn"
                              Style="{ThemeResource AccentButtonStyle}"
                              Click="CheckUpdates_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <FontIcon Glyph="&#xE777;" FontSize="14" />
                          <TextBlock Text="Check for updates" />
                        </StackPanel>
                      </Button>
                      <Button x:Name="ReleaseNotesBtn"
                              Click="ReleaseNotes_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <FontIcon Glyph="&#xE82D;" FontSize="14" />
                          <TextBlock Text="View release notes" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </StackPanel>

                  <!-- Big chat-bubble Dimmy logo on the right -->
                  <Image Grid.Column="1"
                         Source="ms-appx:///Assets/dimmy-logo.png"
                         Width="120" Height="120"
                         VerticalAlignment="Center" />
                </Grid>
              </Border>

              <!-- Hidden version text — kept so existing code-behind that
                   writes VersionText.Text doesn't NPE; HeroSubText/HeroTitleText
                   are the visible carriers now. -->
              <TextBlock x:Name="VersionText" Visibility="Collapsed" />

              <!-- Update-available banner: Velopack background loop
                   (UpdateService.StartBackgroundLoop) silently downloads
                   the update + raises UpdateReady; we flip this card
                   Visible and the user can apply now or wait for the
                   quit-time prompt. Mixed UX picked 2026-05-11. -->
              <controls:SettingCard x:Name="UpdateCard"
                                    Glyph="&#xEBD3;"
                                    Label="Update ready"
                                    InfoTip="Dimmy downloaded the update in the background. Install and restart to apply it now, or it applies next time you quit."
                                    HelpUrl="https://dimmy.app/help/about-and-updates"
                                    Visibility="Collapsed"
                                    Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="UpdateInstallBtn"
                          Content="Install &amp; restart"
                          Style="{ThemeResource AccentButtonStyle}"
                          Click="UpdateInstallNow_Click"/>
                  <HyperlinkButton x:Name="UpdateLink"
                                   Content="Release notes"
                                   ToolTipService.ToolTip="Open the release page on GitHub"/>
                </StackPanel>
              </controls:SettingCard>

              <!-- Update channel selector. "Stable" picks only the
                   GitHub "Latest" tag; "Stable + Pre-release" also
                   considers staging-native builds tagged
                   staging-latest. Persisted to UiPreferences.UpdateChannel
                   (NOT config.json — Rust core has no opinion).
                   The card is hidden for users without the
                   auto_update license scope — they see no update UI
                   at all (silent-gating UX picked 2026-05-11). -->
              <controls:SettingCard x:Name="UpdateChannelCard"
                                    Glyph="&#xE74C;"
                                    Label="Update channel"
                                    InfoTip="Stable only is the safer default. Pre-release gets new features earlier, with a higher chance of rough edges."
                                    HelpUrl="https://dimmy.app/help/about-and-updates"
                                    Visibility="Collapsed"
                                    Margin="0,8,0,0">
                <ComboBox x:Name="UpdateChannelCombo"
                          MinWidth="{StaticResource SettingFieldWidth}"
                          SelectionChanged="UpdateChannel_SelectionChanged">
                  <ComboBoxItem Content="Stable only" Tag="stable"/>
                  <ComboBoxItem Content="Stable + Pre-release" Tag="prerelease"/>
                </ComboBox>
              </controls:SettingCard>

              <TextBlock Text="RESOURCES"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,20,0,8" />
              <controls:SettingCard Glyph="&#xE71B;"
                                    Label="Website"
                                    InfoTip="dimmy.app: features, downloads, and docs.">
                <HyperlinkButton Content="Open" NavigateUri="https://dimmy.app" />
              </controls:SettingCard>
              <controls:SettingCard Glyph="&#xE943;"
                                    Label="Source code"
                                    InfoTip="Open-source on GitHub.">
                <HyperlinkButton Content="GitHub"
                                 NavigateUri="https://github.com/KonradDallaOrg/dimmy" />
              </controls:SettingCard>

            </StackPanel>

            <!-- ═══ History ═══ -->
            <StackPanel x:Name="HistoryPanel" Spacing="12" Visibility="Collapsed">
              <StackPanel Spacing="2" Margin="0,0,0,4">
                <TextBlock Text="Recordings" FontSize="28" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Search past dictations, file loads, and meetings." />
              </StackPanel>

              <Grid ColumnSpacing="8" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         x:Name="HistorySearchBox"
                         PlaceholderText="Search raw + enhanced text…"
                         Text="{Binding HistorySearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="HistorySearchBox_KeyDown"/>
                <Button Grid.Column="1" x:Name="HistorySearchBtn" Click="HistorySearch_Click">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE721;" FontSize="14"/>
                    <TextBlock Text="Search"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="2" x:Name="HistoryRefreshBtn" Click="HistoryRefresh_Click">
                  <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
              </Grid>

              <controls:SettingCard Glyph="&#xE7B8;"
                                    Label="Save audio with history"
                                    InfoTip="Off by default for privacy. When on, the audio is saved next to each transcription. Use the limits below to cap disk use."
                                    HelpUrl="https://dimmy.app/help/history-search">
                <ToggleSwitch IsOn="{Binding SaveAudioInHistory, Mode=TwoWay}"
                              Style="{StaticResource CompactToggleSwitch}" />
              </controls:SettingCard>
              <controls:SettingCard Glyph="&#xE823;"
                                    Label="Audio retention (days)"
                                    InfoTip="Old audio is removed at startup once it passes this age. Set 0 to never delete by age."
                                    HelpUrl="https://dimmy.app/help/history-search">
                <NumberBox MinWidth="120" Minimum="0" Maximum="3650"
                           Value="{Binding HistoryAudioKeepDays, Mode=TwoWay}" />
              </controls:SettingCard>
              <controls:SettingCard Glyph="&#xEDA2;"
                                    Label="Audio quota (MB)"
                                    InfoTip="When saved audio passes this size, the oldest files are removed first. Set 0 to never delete by size."
                                    HelpUrl="https://dimmy.app/help/history-search">
                <NumberBox MinWidth="120" Minimum="0" Maximum="100000"
                           Value="{Binding HistoryAudioMaxMb, Mode=TwoWay}" />
              </controls:SettingCard>

              <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="0">
                <ListView x:Name="HistoryListView"
                          ItemsSource="{Binding HistoryItems}"
                          SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                          SelectionMode="Single"
                          MaxHeight="320">
                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                  </ListView.ItemContainerStyle>
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnSpacing="12" Padding="6,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TimestampDisplay}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding AppDisplay}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   MaxWidth="100" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Preview}"
                                   FontSize="13" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <FontIcon Grid.Column="3" Glyph="&#xE7B8;" FontSize="12"
                                  Visibility="{Binding HasAudio, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Audio saved" />
                        <TextBlock Grid.Column="4" Text="{Binding DurationDisplay}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </Border>

              <!-- Detail panel: shown when a row is selected -->
              <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14"
                      Visibility="{Binding SelectedHistoryItem, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}">
                <StackPanel Spacing="8">
                  <TextBlock Text="Raw transcript" FontSize="12" FontWeight="SemiBold"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <RichTextBlock x:Name="HistoryRawTextRich"
                                 TextWrapping="Wrap" FontSize="13" LineHeight="22"
                                 IsTextSelectionEnabled="True" />
                  <TextBlock x:Name="HistoryEnhancedHeader"
                             Text="LLM-enhanced" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             Visibility="{Binding SelectedHistoryItem.EnhancedText, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}" />
                  <RichTextBlock x:Name="HistoryEnhancedTextRich"
                                 TextWrapping="Wrap" FontSize="13" LineHeight="22"
                                 IsTextSelectionEnabled="True"
                                 Visibility="{Binding SelectedHistoryItem.EnhancedText, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}" />
                  <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
                    <TextBlock Text="{Binding SelectedHistoryItem.AppDisplay, Mode=OneWay, FallbackValue=''}"
                               FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding SelectedHistoryItem.Language, Mode=OneWay}"
                               FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding SelectedHistoryItem.LlmStyle, Mode=OneWay, FallbackValue=''}"
                               FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding SelectedHistoryItem.DurationDisplay, Mode=OneWay}"
                               FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                  </StackPanel>
                  <!-- Waveform + audio playback. Canvas peaks are drawn
                       in code-behind whenever SelectedHistoryItem
                       changes (see HistoryWaveformRender). The
                       MediaPlayerElement uses the WAV's file:/// URI;
                       its built-in transport controls cover play/seek. -->
                  <Grid Margin="0,8,0,0"
                        Visibility="{Binding SelectedHistoryItem.HasAudio, Mode=OneWay,
                                     Converter={StaticResource BoolToVisibilityConverter},
                                     FallbackValue=Collapsed}">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="6,4" Height="64">
                      <Canvas x:Name="HistoryWaveformCanvas"
                              Background="Transparent"
                              PointerPressed="HistoryWaveformCanvas_PointerPressed" />
                    </Border>
                    <MediaPlayerElement x:Name="HistoryAudioPlayer"
                                        Grid.Row="1"
                                        AreTransportControlsEnabled="True"
                                        AutoPlay="False"
                                        Margin="0,4,0,0"
                                        MaxHeight="110" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                    <Button x:Name="HistoryCopyRawBtn" Click="HistoryCopyRaw_Click" Content="Copy raw" />
                    <Button x:Name="HistoryCopyEnhancedBtn" Click="HistoryCopyEnhanced_Click" Content="Copy enhanced" />
                    <Button x:Name="HistoryDeleteBtn" Click="HistoryDelete_Click" Content="Delete" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- ═══ Integrations — Notion (more to come) ═══ -->
            <StackPanel x:Name="IntegrationsPanel" Spacing="4" Visibility="Collapsed">
              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Text="Integrations" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Push your meeting recaps into the tools you already use."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>

              <!-- Group: NOTION -->
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,16,0,8">
                <TextBlock Text="NOTION"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           CharacterSpacing="40" VerticalAlignment="Center" />
                <Button Background="Transparent" BorderThickness="0" Padding="0"
                        Width="18" Height="18" MinWidth="0" MinHeight="0"
                        VerticalAlignment="Center" VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        ToolTipService.ToolTip="Free Notion accounts work fine. Your token and destination stay on this device. Only the recap text leaves, and only when you send it.">
                  <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                  <Button.Flyout>
                    <Flyout>
                      <StackPanel MaxWidth="300" Spacing="10">
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Text="Free Notion accounts work fine. Your token and destination stay on this device. Only the recap text leaves, and only when you send it." />
                        <HyperlinkButton Content="Open full guide →" Padding="0"
                                         NavigateUri="https://dimmy.app/help/integrations-notion" />
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>

              <!-- Summary card — shows current connection state. Two
                   variants: NOT CONNECTED (default, big "Connect"
                   accent button) vs CONNECTED (workspace + destination
                   + change/disconnect buttons + auto-send toggle).
                   The wizard handles all setup; this card just summarises. -->
              <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid ColumnSpacing="14" RowSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <!-- Real Notion logo — bundled SVG asset (light/dark
                       picked via ThemeDictionary in App.xaml). -->
                  <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                         Width="40" Height="40"
                         Source="{ThemeResource NotionMarkSource}"
                         VerticalAlignment="Top"/>
                  <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Notion" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="NotionStatusText"
                               Text="Not connected"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <FontIcon x:Name="NotionStatusGlyph"
                              Glyph="&#xEA39;"
                              FontSize="20"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                  </StackPanel>
                  <!-- Action button row — Connect (when disconnected)
                       or Change destination + Disconnect (when
                       connected). Visibility flipped from code-behind. -->
                  <StackPanel x:Name="NotionDisconnectedActions"
                              Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                              Orientation="Horizontal" Spacing="8"
                              Visibility="Visible">
                    <Button Content="Connect Notion"
                            Click="NotionConnect_Click"
                            Style="{ThemeResource AccentButtonStyle}"/>
                  </StackPanel>
                  <StackPanel x:Name="NotionConnectedActions"
                              Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                              Orientation="Horizontal" Spacing="8"
                              Visibility="Collapsed">
                    <Button Content="Change destination"
                            Click="NotionChangeDestination_Click"/>
                    <Button Content="Disconnect"
                            Click="NotionDisconnect_Click"/>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Auto-send toggle — only meaningful once connected.
                   Stays inline (not in wizard) because it's a single
                   binary choice and users may want to flip it on/off
                   over time without re-entering setup. -->
              <controls:SettingCard Glyph="&#xE945;"
                                    Label="Auto-send each meeting"
                                    Description="Send every recap to Notion."
                                    InfoTip="On uploads each recap as soon as it's ready. Off lets you send manually from the meeting's Done view."
                                    HelpUrl="https://dimmy.app/help/integrations-notion">
                <ToggleSwitch IsOn="{Binding NotionAutoSend, Mode=TwoWay}"
                              IsEnabled="{Binding HasNotionToken}"
                              Toggled="NotionAutoSend_Toggled"
                              Style="{StaticResource CompactToggleSwitch}" />
              </controls:SettingCard>

              <!-- Status / errors -->
              <Border x:Name="NotionMessageBar" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                      BorderThickness="0" CornerRadius="6" Padding="12,8"
                      Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock x:Name="NotionMessageText" FontSize="13" TextWrapping="Wrap" />
              </Border>

              <!-- Group: ANTHROPIC SUBSCRIPTION
                   The user's Pro / Team / Max plan, accessed via the
                   local `claude` CLI. Once "connected" (signed in)
                   the Output → LLM and Output → Recap sections
                   expose toggles to route those calls through the
                   subscription instead of through API keys. -->
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,32,0,8">
                <TextBlock Text="ANTHROPIC SUBSCRIPTION"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           CharacterSpacing="40" VerticalAlignment="Center" />
                <Button Background="Transparent" BorderThickness="0" Padding="0"
                        Width="18" Height="18" MinWidth="0" MinHeight="0"
                        VerticalAlignment="Center" VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        ToolTipService.ToolTip="Use your Anthropic Pro, Team, or Max plan through the local Claude CLI, so no API credit is spent. Dimmy never sees your token. Turn it on under Output once connected.">
                  <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                  <Button.Flyout>
                    <Flyout>
                      <StackPanel MaxWidth="300" Spacing="10">
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Text="Use your Anthropic Pro, Team, or Max plan through the local Claude CLI, so no API credit is spent. Dimmy never sees your token. Turn it on under Output once connected." />
                        <HyperlinkButton Content="Open full guide →" Padding="0"
                                         NavigateUri="https://dimmy.app/help/integrations-claude-cli" />
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>

              <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid ColumnSpacing="14" RowSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                         Width="40" Height="40"
                         VerticalAlignment="Top"
                         Source="{ThemeResource AnthropicMarkSource}" />
                  <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Anthropic" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="AnthropicIntegrationStatusText"
                               Text="Probing…"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <FontIcon x:Name="AnthropicIntegrationStatusGlyph"
                              Glyph="&#xEA39;"
                              FontSize="20"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                  </StackPanel>
                  <!-- DISCONNECTED action row. When the binary is
                       missing, primary CTA is the setup wizard (which
                       walks the user through Node.js + npm install +
                       login). When the binary IS installed but the
                       user hasn't signed in, the wizard is overkill —
                       the same row offers a direct Sign in button.
                       RefreshAuthIntegrationStatus swaps which one is
                       primary per state. -->
                  <StackPanel x:Name="AnthropicIntegrationDisconnectedActions"
                              Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                              Orientation="Horizontal" Spacing="8"
                              Visibility="Collapsed">
                    <Button x:Name="AnthropicIntegrationWizardBtn"
                            Click="AnthropicIntegrationWizard_Click"
                            Visibility="Collapsed">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9F5;" FontSize="14"/>
                        <TextBlock Text="Set up wizard"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="AnthropicIntegrationSignInBtn"
                            Click="AnthropicIntegrationSignIn_Click">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                        <TextBlock x:Name="AnthropicIntegrationSignInLabel" Text="Sign in via browser"/>
                      </StackPanel>
                    </Button>
                    <Button Content="Refresh" Click="AnthropicIntegrationRefresh_Click"
                            ToolTipService.ToolTip="Re-probe the local `claude` CLI install status"/>
                  </StackPanel>
                  <!-- CONNECTED action row: Re-sign in + Test + Refresh. -->
                  <StackPanel x:Name="AnthropicIntegrationConnectedActions"
                              Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                              Orientation="Horizontal" Spacing="8"
                              Visibility="Collapsed">
                    <Button x:Name="AnthropicIntegrationTestBtn"
                            Click="AnthropicIntegrationTest_Click"
                            ToolTipService.ToolTip="Send a tiny ping prompt through the CLI to verify end-to-end (binary + login + Anthropic API)">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE945;" FontSize="14"/>
                        <TextBlock Text="Test connection"/>
                      </StackPanel>
                    </Button>
                    <Button Content="Re-sign in" Click="AnthropicIntegrationSignIn_Click"
                            ToolTipService.ToolTip="Re-run the OAuth flow if your subscription token expired"/>
                    <Button Content="Re-run setup" Click="AnthropicIntegrationRerunWizard_Click"
                            ToolTipService.ToolTip="Re-walk the 3-step wizard (Node.js → CLI → sign in) — useful to verify the install or update Node"/>
                    <Button Content="Refresh" Click="AnthropicIntegrationRefresh_Click"/>
                  </StackPanel>
                </Grid>
              </Border>


              <!-- Status / errors. -->
              <Border x:Name="AnthropicIntegrationMessageBar" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                      BorderThickness="0" CornerRadius="6" Padding="12,8"
                      Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock x:Name="AnthropicIntegrationMessageText" FontSize="13" TextWrapping="Wrap" />
              </Border>

              <!-- Group: CLAUDE DESKTOP (MCP)
                   Two-way bridge: Claude Desktop reads our meetings +
                   writes recaps back via the dimmy-mcp stdio binary.
                   Distinct from the Anthropic CLI subscription above
                   (which is the LLM dispatch path for recap/rewrite). -->
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,32,0,8">
                <TextBlock Text="CLAUDE DESKTOP (MCP)"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           CharacterSpacing="40" VerticalAlignment="Center" />
                <Button Background="Transparent" BorderThickness="0" Padding="0"
                        Width="18" Height="18" MinWidth="0" MinHeight="0"
                        VerticalAlignment="Center" VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        ToolTipService.ToolTip="Lets Claude Desktop read your recent meetings and save recaps back. Everything runs on this device. Disconnect anytime and Dimmy removes its entry.">
                  <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                  <Button.Flyout>
                    <Flyout>
                      <StackPanel MaxWidth="300" Spacing="10">
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Text="Lets Claude Desktop read your recent meetings and save recaps back. Everything runs on this device. Disconnect anytime and Dimmy removes its entry." />
                        <HyperlinkButton Content="Open full guide →" Padding="0"
                                         NavigateUri="https://dimmy.app/help/integrations-claude-desktop" />
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>

              <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid ColumnSpacing="14" RowSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <!-- Icon source is set in code-behind by
                       RefreshMcpCard via ClaudeIconExtractor (extracts
                       the real MSIX brand mark from the installed
                       Claude package). NO fallback SVG — better empty
                       than hand-drawn approximation. -->
                  <Image x:Name="McpProviderIcon" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                         Width="40" Height="40"
                         VerticalAlignment="Top"/>
                  <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Claude Desktop" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="McpStatusText"
                               Text="Probing…"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <FontIcon x:Name="McpStatusGlyph"
                              Glyph="&#xEA39;"
                              FontSize="20"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                  </StackPanel>
                  <StackPanel x:Name="McpDisconnectedActions"
                              Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                              Orientation="Horizontal" Spacing="8"
                              Visibility="Visible">
                    <Button Content="Connect Claude Desktop"
                            Click="McpConnect_Click"
                            Style="{ThemeResource AccentButtonStyle}"/>
                  </StackPanel>
                  <StackPanel x:Name="McpConnectedActions"
                              Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                              Orientation="Horizontal" Spacing="8"
                              Visibility="Collapsed">
                    <Button Content="Re-run wizard" Click="McpConnect_Click"/>
                    <Button Content="Disconnect" Click="McpDisconnect_Click"/>
                    <Button Content="Refresh" Click="McpRefresh_Click"/>
                  </StackPanel>
                </Grid>
              </Border>

            </StackPanel>

            <!-- ═══ Privacy & data ═══ -->
            <StackPanel x:Name="PrivacyPanel" Spacing="4" Visibility="Collapsed">
              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Text="Privacy &amp; data" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="What leaves your machine, and what doesn't."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>

              <!-- Promise card — kept as full-width info card, not a setting row -->
              <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="16,12">
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <FontIcon Glyph="&#xE72E;" FontSize="16" Width="24" Height="24"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            VerticalAlignment="Top" Margin="0,2,0,0" />
                  <TextBlock TextWrapping="Wrap" FontSize="13"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             Text="Dimmy never sends your transcriptions, audio, API keys, microphone names, or anything personal. Anonymous usage data and crash reports help us spot bugs and decide what to build next." />
                </StackPanel>
              </Border>

              <!-- Telemetry + Anonymous ID — Advanced-gated per the settings map.
                   Send feedback + policy links stay in Simple. -->
              <StackPanel Visibility="{Binding IsAdvanced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
              <TextBlock Text="TELEMETRY"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,20,0,8" />
              <controls:SettingCard Glyph="&#xE9D9;"
                                    Label="Send anonymous usage data"
                                    InfoTip="Things like &quot;app started&quot; or &quot;transcription took 2.3s&quot;. Never your text, audio, or anything that identifies you."
                                    HelpUrl="https://dimmy.app/help/telemetry">
                <ToggleSwitch x:Name="AnalyticsToggle"
                              IsOn="{Binding TelemetryEnabled, Mode=TwoWay}"
                              Style="{StaticResource CompactToggleSwitch}" />
              </controls:SettingCard>
              <controls:SettingCard Glyph="&#xE730;"
                                    Label="Send crash reports"
                                    InfoTip="Sends a crash trace so we can fix the bug. No usernames, paths, or environment details are included."
                                    HelpUrl="https://dimmy.app/help/telemetry">
                <ToggleSwitch x:Name="CrashesToggle"
                              IsOn="{Binding CrashReportsEnabled, Mode=TwoWay}"
                              Style="{StaticResource CompactToggleSwitch}" />
              </controls:SettingCard>

              <TextBlock Text="ANONYMOUS IDENTIFIER"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,20,0,8" />
              <controls:SettingCard Glyph="&#xE77B;"
                                    Label="Your anonymous ID"
                                    InfoTip="Created on this device at first launch. It ties anonymous events together without identifying you. Reset applies after a restart."
                                    HelpUrl="https://dimmy.app/help/telemetry">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock x:Name="AnonymousIdText" FontSize="12"
                             FontFamily="Consolas"
                             VerticalAlignment="Center"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <Button x:Name="ResetAnonymousIdBtn"
                          Content="Reset"
                          Click="ResetAnonymousId_Click" />
                </StackPanel>
              </controls:SettingCard>
              </StackPanel>

              <TextBlock Text="SEND FEEDBACK"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,20,0,8" />
              <controls:SettingCard Glyph="&#xE939;"
                                    Label="Kind"
                                    InfoTip="Helps us route your message: a general note, a bug, or a feature idea.">
                <ComboBox x:Name="FeedbackKindCombo" SelectedIndex="0" MinWidth="{StaticResource SettingFieldWidth}">
                  <ComboBoxItem Content="General" Tag="general" />
                  <ComboBoxItem Content="Bug report" Tag="bug" />
                  <ComboBoxItem Content="Feature request" Tag="feature" />
                </ComboBox>
              </controls:SettingCard>
              <!-- Free-form fields: too tall for a single-row card; full-width form card. -->
              <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="16,12">
                <StackPanel Spacing="10">
                  <TextBox x:Name="FeedbackText"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinHeight="80"
                           PlaceholderText="What's on your mind? Bugs, ideas, anything." />
                  <TextBox x:Name="FeedbackEmail"
                           PlaceholderText="Your email (optional, only if you want a reply)" />
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="SendFeedbackBtn"
                            Content="Send"
                            Click="SendFeedback_Click"
                            Style="{ThemeResource AccentButtonStyle}" />
                    <!-- Shown only when a send returns "disabled" (rc -2):
                         one click enables feedback sending + retries. -->
                    <Button x:Name="EnableAndSendFeedbackBtn"
                            Content="Enable &amp; send"
                            Click="EnableAndSendFeedback_Click"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Feedback rides on crash reporting, which is currently off. This turns it on and sends your message in one click."
                            Style="{ThemeResource AccentButtonStyle}" />
                    <TextBlock x:Name="FeedbackStatus" FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <TextBlock Text="RESOURCES"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,20,0,8" />
              <controls:SettingCard Glyph="&#xE72E;"
                                    Label="Privacy policy"
                                    InfoTip="Opens the complete privacy policy on dimmy.app."
                                    HelpUrl="https://dimmy.app/help/telemetry">
                <HyperlinkButton Content="Open"
                                 NavigateUri="https://dimmy.app/privacy" />
              </controls:SettingCard>
              <controls:SettingCard Glyph="&#xE946;"
                                    Label="What we collect"
                                    InfoTip="A short, readable list of each anonymous event, so there are no surprises."
                                    HelpUrl="https://dimmy.app/help/telemetry">
                <HyperlinkButton Content="Open"
                                 NavigateUri="https://dimmy.app/privacy#data" />
              </controls:SettingCard>
            </StackPanel>

            <!-- ═══ License ═══ -->
            <StackPanel x:Name="LicensePanel" Spacing="4" Visibility="Collapsed">
              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Text="License" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Activate Dimmy, manage your trial, or paste an activation code from email."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>

              <!-- Status hero card. Mirrors macOS MacLicensePage statusHero:
                   tier pill (color-coded) + headline/detail + trailing
                   days counter. Tint = statusTint for the current state;
                   border pulls a 35%-opacity stroke from the same color. -->
              <Border x:Name="LicenseStatusBorder"
                      BorderThickness="1" CornerRadius="6" Padding="18,16" Margin="0,0,0,16">
                <StackPanel Spacing="10">
                  <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Tier pill — populated by RefreshLicenseStatus.
                         Empty by default so the layout doesn't shift while
                         we wait for the first FFI call. -->
                    <!-- Tier badge — Win11 Fluent style: subtle tinted
                         fill + matching solid-color text + thin border in
                         the same hue. 4px corner radius (Fluent norm). -->
                    <Border Grid.Column="0" x:Name="LicenseTierBadgeBorder"
                            CornerRadius="4" Padding="8,3"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                      <TextBlock x:Name="LicenseTierBadge"
                                 FontSize="11" FontWeight="SemiBold"
                                 CharacterSpacing="40"
                                 Text="" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock x:Name="LicenseStatusHeadline" FontSize="18" FontWeight="SemiBold"
                                 Text="Loading…" />
                      <TextBlock x:Name="LicenseStatusDetail" FontSize="12"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                 TextWrapping="Wrap"
                                 Text="Fetching status from the licensing module…" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" x:Name="LicenseTrailingPanel"
                                Spacing="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="Collapsed">
                      <TextBlock x:Name="LicenseTrailingValue"
                                 FontSize="20" FontWeight="SemiBold"
                                 HorizontalAlignment="Right"
                                 Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                 Text="" />
                      <TextBlock x:Name="LicenseTrailingLabel"
                                 FontSize="11" FontWeight="Normal"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                 HorizontalAlignment="Right"
                                 Text="" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Refresh now" Click="License_Refresh_Click" />
                    <Button Content="Sign out (this device)" Click="License_Clear_Click" />
                    <Button x:Name="LicenseManageSubButton"
                            Content="Manage subscription"
                            Visibility="Collapsed"
                            Click="License_ManageSubscription_Click" />
                  </StackPanel>
                  <InfoBar x:Name="LicenseManageSubInfoBar" IsOpen="False" IsClosable="True"
                           Margin="0,4,0,0" Severity="Error" Title="" Message="" />
                </StackPanel>
              </Border>

              <!-- Devices on this license — list + per-row "Sign out". -->
              <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="20,16" Margin="0,0,0,16">
                <StackPanel Spacing="10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="Devices" FontSize="16" FontWeight="SemiBold" />
                      <TextBlock x:Name="LicenseDeviceCountLabel" FontSize="11"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                 Text="…" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Reload" Click="License_DevicesReload_Click" />
                  </Grid>
                  <StackPanel x:Name="LicenseDevicesList" Spacing="6" />
                </StackPanel>
              </Border>

              <!-- Buy / Upgrade — three-tier picker. Visibility flips per
                   LicenseStatus.Kind in code-behind: shown for NotFound,
                   TrialActive, TrialExpired, Expired; hidden for Active /
                   Suspended / Unrestricted. Each button POSTs the tier to
                   /api/checkout/create and opens the returned Stripe URL. -->
              <Border x:Name="LicenseBuyCard"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="20,16" Margin="0,0,0,16"
                      Visibility="Collapsed">
                <StackPanel Spacing="10">
                  <TextBlock x:Name="LicenseBuyHeadline" Text="Upgrade to Pro"
                             FontSize="16" FontWeight="SemiBold" />
                  <TextBlock x:Name="LicenseBuyDetail" FontSize="12"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             TextWrapping="Wrap"
                             Text="Pick a plan. Stripe handles payment + tax; we email you a magic link the moment payment clears." />
                  <Grid x:Name="LicenseBuyButtonsGrid" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="LicenseBuyMonthlyButton"
                            Click="License_BuyMonthly_Click"
                            HorizontalAlignment="Stretch">
                      <StackPanel Spacing="2">
                        <TextBlock x:Name="LicenseBuyMonthlyLabel" Text="Monthly" FontWeight="SemiBold" />
                        <TextBlock Text="recurring" FontSize="10"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" x:Name="LicenseBuyAnnualButton"
                            Click="License_BuyAnnual_Click"
                            HorizontalAlignment="Stretch"
                            Style="{ThemeResource AccentButtonStyle}">
                      <StackPanel Spacing="2">
                        <TextBlock x:Name="LicenseBuyAnnualLabel" Text="Annual" FontWeight="SemiBold" />
                        <TextBlock Text="best value" FontSize="10" Opacity="0.85" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="2" x:Name="LicenseBuyLifetimeButton"
                            Click="License_BuyLifetime_Click"
                            HorizontalAlignment="Stretch">
                      <StackPanel Spacing="2">
                        <TextBlock x:Name="LicenseBuyLifetimeLabel" Text="Lifetime" FontWeight="SemiBold" />
                        <TextBlock Text="one-time" FontSize="10"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <!-- Visible only on Active{Monthly|Annual}: nudges the
                       user toward the Stripe Customer Portal for plan
                       changes (downgrade, cancel, payment method) so
                       they don't accidentally double-purchase by hitting
                       a Buy button thinking it switches plans. -->
                  <TextBlock x:Name="LicenseBuyPortalHint"
                             FontSize="11"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             TextWrapping="Wrap"
                             Visibility="Collapsed"
                             Text="Need to downgrade, cancel, or update payment? Use the &quot;Manage subscription&quot; button above. It opens the secure Stripe billing portal." />
                  <InfoBar x:Name="LicenseBuyInfoBar" IsOpen="False" IsClosable="True"
                           Severity="Informational" Message="" />
                </StackPanel>
              </Border>

              <!-- Capabilities grid — populated by RefreshLicenseStatus.
                   Each row = one entry in LicenseService.ScopeNames.All. -->
              <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="20,16" Margin="0,0,0,16">
                <StackPanel Spacing="10">
                  <TextBlock Text="Included with your license" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock FontSize="12"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             TextWrapping="Wrap"
                             Text="Local features (BYOK STT/LLM, history, hotkey, paste) are always free. The capabilities below are unlocked by an active license." />
                  <StackPanel x:Name="LicenseScopeGrid" Spacing="6" />
                </StackPanel>
              </Border>

              <!-- Activate / Start trial — primary path -->
              <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="20,16" Margin="0,0,0,16">
                <StackPanel Spacing="10">
                  <TextBlock Text="Activate Dimmy" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock FontSize="12"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             TextWrapping="Wrap"
                             Text="Enter your email and we send you a sign-in link." />
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="LicenseTrialEmailBox"
                             PlaceholderText="you@example.com" />
                    <Button Grid.Column="1" x:Name="LicenseTrialButton" Content="Activate"
                            Click="License_StartTrial_Click"
                            Style="{ThemeResource AccentButtonStyle}" />
                  </Grid>
                  <InfoBar x:Name="LicenseTrialInfoBar" IsOpen="False" IsClosable="True"
                           Severity="Informational" Message="" />
                </StackPanel>
              </Border>

              <!-- Fallback: paste activation code (collapsed by default).
                   Used when the magic link didn't auto-activate (corp email
                   that strips dimmy:// schemes, copy-paste from another box). -->
              <Expander Header="Activation didn't open Dimmy? Paste the code"
                        HorizontalAlignment="Stretch" Margin="0,0,0,16">
                <StackPanel Spacing="10">
                  <TextBlock FontSize="12"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             TextWrapping="Wrap"
                             Text="Some email clients (especially corporate) strip custom URL schemes. Paste the bare code or full magic-link URL from your email here." />
                  <TextBox x:Name="LicenseCodeBox" AcceptsReturn="False"
                           PlaceholderText="32-char activation code or magic-link URL" />
                  <TextBox x:Name="LicenseDeviceLabelBox"
                           PlaceholderText="Device label (optional)" />
                  <Button Content="Activate from code" Click="License_Activate_Click" />
                  <InfoBar x:Name="LicenseActivateInfoBar" IsOpen="False" IsClosable="True"
                           Severity="Informational" Message="" />
                </StackPanel>
              </Expander>

            </StackPanel>

            <!-- Orphan Stats panel — kept so existing code-behind that writes
                 SpeakingTimeText / TimeSavedText doesn't NPE. The stats are
                 now surfaced in the Home dashboard quick-stats card. This
                 panel is never made Visible by Nav_SelectionChanged. -->
            <StackPanel x:Name="StatsPanel" Spacing="12" Visibility="Collapsed">
              <TextBlock Text="{Binding StatsTotalWords, Mode=OneWay}" Visibility="Collapsed" />
              <TextBlock x:Name="SpeakingTimeText" Visibility="Collapsed" />
              <TextBlock x:Name="TimeSavedText" Visibility="Collapsed" />
            </StackPanel>

            <!-- ═══ Debug ═══ -->
            <StackPanel x:Name="DebugPanel" Spacing="4" Visibility="Collapsed">
              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Text="Debug" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Developer-leaning controls and diagnostics."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>

              <TextBlock Text="DIAGNOSTICS"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,16,0,8" />
              <controls:SettingCard Glyph="&#xE82D;"
                                    Label="LLM log enabled"
                                    InfoTip="Writes each rewrite prompt and response to llm.log. Useful when a rewrite looks wrong."
                                    HelpUrl="https://dimmy.app/help/transcription-issues">
                <ToggleSwitch IsOn="{Binding LlmLogEnabled, Mode=TwoWay}"
                              Style="{StaticResource CompactToggleSwitch}" />
              </controls:SettingCard>
              <controls:SettingCard Glyph="&#xE9F5;"
                                    Label="Audio debug"
                                    InfoTip="Keeps the raw capture and verbose audio logs so we can diagnose recording problems."
                                    HelpUrl="https://dimmy.app/help/transcription-issues">
                <ToggleSwitch IsOn="{Binding AudioDebugEnabled, Mode=TwoWay}"
                              Style="{StaticResource CompactToggleSwitch}" />
              </controls:SettingCard>
              <controls:SettingCard Glyph="&#xE7B5;"
                                    Label="ggml debug logging"
                                    InfoTip="Shows detailed startup logs from the local model engine. Turn on when a local model won't load."
                                    HelpUrl="https://dimmy.app/help/install-issues">
                <ToggleSwitch IsOn="{Binding GgmlDebugLogging, Mode=TwoWay}"
                              Style="{StaticResource CompactToggleSwitch}" />
              </controls:SettingCard>

              <TextBlock Text="GPU ACCELERATION"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,20,0,8" />
              <controls:SettingCard Glyph="&#xE950;"
                                    Label="GPU status"
                                    InfoTip="Dimmy turns the GPU off after a driver crash and falls back to CPU. Update your drivers, then press Retry."
                                    HelpUrl="https://dimmy.app/help/install-issues">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="Enabled"
                             VerticalAlignment="Center"
                             Foreground="#16a34a"
                             Visibility="{Binding GpuKnownBad, Mode=OneWay,
                                          Converter={StaticResource BoolToVisibilityConverter},
                                          ConverterParameter=Invert}" />
                  <TextBlock Text="Disabled (driver crash)"
                             VerticalAlignment="Center"
                             Foreground="#dc2626"
                             Visibility="{Binding GpuKnownBad, Mode=OneWay,
                                          Converter={StaticResource BoolToVisibilityConverter}}" />
                  <Button Content="Retry GPU"
                          Click="RetryGpu_Click"
                          Visibility="{Binding GpuKnownBad, Mode=OneWay,
                                       Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
              </controls:SettingCard>
              <!-- GPU crash detail card — full-width, only when known-bad. -->
              <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="16,12"
                      Visibility="{Binding GpuKnownBad, Mode=OneWay,
                                   Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="6">
                  <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="Last crash: " />
                    <Run Text="{Binding GpuKnownBadSince, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             TextWrapping="Wrap">
                    <Run Text="Context: " />
                    <Run Text="{Binding GpuKnownBadContext, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                             TextWrapping="Wrap"
                             Text="Driver fingerprint matches the crash. Dimmy will keep using CPU. If you've updated drivers, click Retry GPU and restart Dimmy."
                             Visibility="{Binding GpuFingerprintMatches, Mode=OneWay,
                                          Converter={StaticResource BoolToVisibilityConverter}}" />
                  <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                             TextWrapping="Wrap"
                             Text="Driver fingerprint changed since the crash. GPU will be retried automatically on next launch."
                             Visibility="{Binding GpuFingerprintMatches, Mode=OneWay,
                                          Converter={StaticResource BoolToVisibilityConverter},
                                          ConverterParameter=Invert}" />
                </StackPanel>
              </Border>
            </StackPanel>

          </StackPanel>
        </Grid>
      </ScrollViewer>
    </NavigationView>

    <!-- Footer -->
    <!-- Bottom action bar: auto-save badge as a button-height pill
         (WinUI's stock InfoBar is ~50 px tall and dwarfs Cancel/Save).
         Same 32 px height as the buttons it sits next to. -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right" Margin="16">
      <!-- All 4 colours derive from SystemAccentColor (user's Windows
           accent in Personalisation → Colours). Previous hardcoded
           Material green vanished on dark theme — dark green on dark
           surface. The accent shades below auto-track theme:
           tertiary fill = tinted bg, text-primary = readable accent text. -->
      <Border x:Name="SavedInfoBar"
              Visibility="Collapsed"
              Background="{ThemeResource AccentFillColorTertiaryBrush}"
              BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="10,0"
              Height="32"
              VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center">
          <FontIcon Glyph="&#xE73E;" FontSize="14"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
          <TextBlock Text="Saved" FontSize="13"
                     Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Button Content="Cancel" Click="Cancel_Click" />
      <Button Content="Save" Click="Save_Click" Style="{ThemeResource AccentButtonStyle}" />
    </StackPanel>

    <!-- Floating ghost preview for app-rule drag-reorder. RenderTargetBitmap
         snapshot of the source row, shown via Popup positioned at the
         pointer. Replaces what WinUI 3's drag pipeline would normally
         render — that pipeline crashes on 1.7.x (see SettingsWindow.xaml.cs
         AppRuleHandle_PointerPressed comment). -->
    <Popup x:Name="AppRuleDragGhostPopup"
           IsLightDismissEnabled="False"
           ShouldConstrainToRootBounds="False">
      <!-- Solid opaque background — the row's DataTemplate Grid is
           transparent, so RenderTargetBitmap captures element-only
           pixels; without a solid backdrop the ghost looks see-through.
           Slight 0.96 opacity keeps a "this is a ghost" cue without
           letting the desktop bleed through. -->
      <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
              Opacity="0.96">
        <Image x:Name="AppRuleDragGhostImage" Stretch="None"/>
      </Border>
    </Popup>
  </Grid>
</Window>
