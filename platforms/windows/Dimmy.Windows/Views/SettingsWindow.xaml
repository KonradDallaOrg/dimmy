                        </Image>
                        <TextBlock Text="OpenAI · GPT-4o mini" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem x:Name="RecapItemO3" Tag="o3">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
