                        <TextBlock Text="Google · Gemini 3.1 Flash (fast)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem x:Name="RecapItemGemini25Flash" Tag="gemini-2.5-flash">
