                                      Visibility="Collapsed">
                  <ToggleSwitch x:Name="RecapUseSameKeyToggle"
                                IsOn="{Binding RecapUseSameKey, Mode=TwoWay}"
                                Toggled="RecapUseSameKey_Toggled"
                                Style="{StaticResource CompactToggleSwitch}"/>
                </controls:SettingCard>
                <!-- Recap API key field. Visible when (a) the toggle
                     above is OFF, OR (b) no upstream key exists for
                     the recap vendor. Writes via
                     dimmy_save_llm_provider_key("recap", vendor, key)
                     into a dedicated Recap(<vendor>) keystore entry,
                     separate from the LLM scope. -->
                <controls:SettingCard x:Name="RecapKeyCard"
                                      Glyph="&#xE192;"
                                      Label="Recap API key"
                                      InfoTip="Saved separately for the recap provider, so your dictation key stays untouched. Stored encrypted on this device."
