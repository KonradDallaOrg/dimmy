                                      HelpUrl="https://dimmy.app/help/use-meeting-recaps">
                  <ItemsControl ItemsSource="{Binding CallDetectExcludedApps}" Margin="0,0,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#22FFFFFF"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,3,4,3">
                          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12" />
                            <Button Click="RemoveExcludedApp_Click"
