                         FontSize="12"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         TextWrapping="Wrap" Margin="2,0,0,8" />
              <StackPanel Spacing="4">
                <controls:SettingCard Glyph="&#xE717;"
                                      Label="Detect calls and offer to record"
                                      InfoTip="Suggests recording a few seconds into a call. 'Not now' snoozes that app for half an hour. 'Don't ask' skips it for good."
