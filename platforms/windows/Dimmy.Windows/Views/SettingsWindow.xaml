                                      Label="Keep in clipboard history"
                                      InfoTip="After Dimmy pastes for you, the transcript stays on the clipboard so you can paste it again."
                                      HelpUrl="https://dimmy.app/help/settings-overview">
                  <ToggleSwitch IsOn="{Binding KeepInClipboard, Mode=TwoWay}"
                                Style="{StaticResource CompactToggleSwitch}" />
                </controls:SettingCard>
              </StackPanel>

