                         (mirror of LlmApiKeyBox). No inline Save
                         button. The user types and the value is
                         drained into the Rust keystore on the next
                         Settings save (button or window close). -->
                    <PasswordBox x:Name="RecapKeyBox" Width="{StaticResource SettingFieldWidth}"
                                 PlaceholderText="{Binding HasRecapKey, Mode=OneWay, Converter={StaticResource BoolToApiKeyPlaceholder}}"/>
                  </StackPanel>
                </controls:SettingCard>
              </StackPanel>

              <!-- Clipboard — Advanced-gated per the settings map. -->
