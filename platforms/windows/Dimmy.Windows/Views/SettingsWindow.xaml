                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem x:Name="RecapItemGpt5Mini" Tag="gpt-5-mini">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/openai.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="OpenAI · GPT-5 mini (fast + cheap)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem x:Name="RecapItemGpt5Nano" Tag="gpt-5-nano">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/openai.svg"/></Image.Source>
