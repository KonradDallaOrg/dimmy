                <!-- Use Anthropic subscription for recap. Position
                     RIGHT AFTER the recap model picker (the user's
                     mental model: "I pick a model, then I decide the
                     auth"). Visible only when the picked model is
                     Anthropic AND Claude CLI is signed in. When ON,
                     hides the key UI below. -->
                <controls:SettingCard x:Name="RecapUseSubscriptionCard"
                                      Glyph="&#xE779;"
                                      Label="Use Anthropic subscription for recap"
                                      InfoTip="Sends the recap through your local Claude CLI instead of an API key. Recommended, since recaps run long and use no credit this way."
