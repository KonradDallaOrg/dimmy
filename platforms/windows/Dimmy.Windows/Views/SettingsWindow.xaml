<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dimmy.Windows.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Dimmy.Windows.Views.Controls"
    Title="Dimmy Settings">

  <!-- RequestedTheme is set at runtime by SyncThemeRadioButtons() from
       UiPreferences.Theme (Light/Dark/Default→system). Hardcoding it
       here would override the saved preference on every relayout and
       reintroduce the "Settings stays Light, jump-list/menu stays
       Dark" mismatch users complained about 2026-05-10. -->
  <Grid x:Name="RootGrid" AllowDrop="True"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <NavigationView x:Name="NavView" PaneDisplayMode="Left" OpenPaneLength="200"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False" SelectionChanged="Nav_SelectionChanged">
      <NavigationView.AutoSuggestBox>
        <AutoSuggestBox x:Name="NavSearchBox" PlaceholderText="Search settings"
                        QueryIcon="Find"
                        TextChanged="NavSearchBox_TextChanged" />
      </NavigationView.AutoSuggestBox>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Home" Tag="home">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Voice input" Tag="voice">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE720;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Output" Tag="output">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Providers &amp; keys" Tag="providers">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D7;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <!-- Pill overlay is cosmetic tuning (position, border, waveform,
             visibility) — Advanced-gated; the pill works fine out of the box. -->
        <NavigationViewItem Content="Pill overlay" Tag="pill"
                            Visibility="{Binding IsAdvanced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE7B5;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <!-- App rules is power-user territory (per-app style overrides) —
             gated behind Advanced so the Simple view stays focused. -->
        <NavigationViewItem Content="App rules" Tag="rules"
                            Visibility="{Binding IsAdvanced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xECAA;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Shortcut" Tag="shortcut">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <!-- Recordings is history review, not a setting you need to work —
             Advanced-gated. -->
        <NavigationViewItem Content="Recordings" Tag="history"
                            Visibility="{Binding IsAdvanced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE7B8;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <!-- Integrations (Notion / Claude subscription / MCP) are opt-in
             extras — Advanced-gated. -->
        <NavigationViewItem Content="Integrations" Tag="integrations"
                            Visibility="{Binding IsAdvanced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE71B;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Privacy &amp; data" Tag="privacy">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="License" Tag="license">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE192;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="About" Tag="about">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Debug" Tag="advanced"
                            Visibility="{Binding IsAdvanced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE957;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <NavigationView.PaneFooter>
        <StackPanel>
          <!-- Staging watermark — visible only on builds with
               DIMMY_BUILD_FLAVOR=staging. Code-behind flips the
               Visibility on Loaded based on BuildInfo.IsStaging. The
               yellow stripe + emoji is intentional: a tester running
               staging side-by-side with prod must spot the difference
               at a glance even on a single screen. -->
          <Border x:Name="StagingBanner" Visibility="Collapsed"
                  Padding="14,10" BorderThickness="0,1,0,1"
                  BorderBrush="#A86E00"
                  Background="#3DFFB300">
            <StackPanel Spacing="2">
              <TextBlock Text="⚠ STAGING BUILD"
                         FontWeight="SemiBold" FontSize="12"
                         Foreground="#A86E00" />
              <TextBlock Text="Test environment · Stripe TEST · payments simulated"
                         FontSize="11" TextWrapping="Wrap"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </Border>

          <!-- Advanced mode toggle in the sidebar footer (Win11 native pattern,
               matches the design bundle). Reveals the Advanced nav item for
               developer-only diagnostics + debug toggles. -->
          <Border Padding="14,8" BorderThickness="0,1,0,0"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <ToggleSwitch Header="Advanced mode"
                          IsOn="{Binding IsAdvanced, Mode=TwoWay}"
                          OnContent="On" OffContent="Off" />
          </Border>
        </StackPanel>
      </NavigationView.PaneFooter>

      <ScrollViewer Padding="24,20,24,20">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- All panels share this container. Stretch to fill the window so
               cards grow with width; cap at 1100 px so content stays readable
               on ultrawide monitors. -->
          <StackPanel Grid.Row="1" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- ═══ Home — hero + system prefs (theme, autostart) + quick stats ═══ -->
            <StackPanel x:Name="HomePanel" Spacing="4" Visibility="Visible">
              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Text="Home" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Get a quick read on Dimmy and jump to what you need."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>

              <!-- Hero card: app icon + name + tagline -->
              <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="20,18">
                <Grid ColumnSpacing="18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- App icon: rounded square with Dimmy mark -->
                  <Border Grid.Column="0" Width="56" Height="56" CornerRadius="12"
                          VerticalAlignment="Center"
                          Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE720;" FontSize="28"
                              Foreground="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>

                  <!-- Title + tagline -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Welcome to Dimmy" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Voice dictation that stays out of your way. Press your shortcut, speak, and the transcript pastes into whatever app has focus." />
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Quick stats: bordered card with two big numbers — visually
                   distinct from setting rows so it reads as a dashboard.
                   Placed right under the hero (user-requested order). -->
              <TextBlock Text="YOUR DICTATION"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,20,0,8" />
              <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="20,16">
                <Grid ColumnSpacing="24">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <!-- Words transcribed -->
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE8D2;" FontSize="20" VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Spacing="2">
                      <TextBlock FontSize="24" FontWeight="SemiBold"
                                 Text="{Binding StatsTotalWords, Mode=OneWay}" />
                      <TextBlock FontSize="12"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                 Text="words transcribed" />
                    </StackPanel>
                  </StackPanel>
                  <!-- Speaking time -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE720;" FontSize="20" VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Spacing="2">
                      <TextBlock FontSize="24" FontWeight="SemiBold"
                                 Text="{Binding SpeakingTimeDisplay, Mode=OneWay}" />
                      <TextBlock FontSize="12"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                 Text="time speaking" />
                    </StackPanel>
                  </StackPanel>
                  <!-- Time saved vs typing -->
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE823;" FontSize="20" VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Spacing="2">
                      <TextBlock FontSize="24" FontWeight="SemiBold"
                                 Text="{Binding TimeSavedDisplay, Mode=OneWay}" />
                      <TextBlock FontSize="12"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                 Text="time saved vs typing" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Meeting + Transcribe side by side to keep the cards compact. -->
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
              <!-- Meeting mode launcher — long-form recording with
                   streaming-to-disk + post-process recap + actions. -->
              <TextBlock Text="MEETING MODE"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,20,0,8" />
              <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="20,16">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Record a meeting" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                            Width="18" Height="18" MinWidth="0" MinHeight="0"
                            VerticalAlignment="Center" VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center"
                            ToolTipService.ToolTip="Long-form recording streamed to disk. On stop, the LLM writes a recap with action items when an LLM key is set.">
                      <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                      <Button.Flyout>
                        <Flyout>
                          <StackPanel MaxWidth="300" Spacing="10">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       Text="Long-form recording streamed to disk. On stop, the LLM writes a recap with action items when an LLM key is set." />
                            <HyperlinkButton Content="Open full guide →" Padding="0" NavigateUri="https://dimmy.app/help/use-meeting-recaps" />
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                  <Button x:Name="OpenMeetingBtn" Click="OpenMeeting_Click"
                          Style="{ThemeResource AccentButtonStyle}"
                          Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <FontIcon Glyph="&#xE7C8;" FontSize="14"/>
                      <TextBlock Text="Open meeting window" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
              <!-- Transcribe audio file (offline): drag a file here OR
                   pick one with the file picker. Routes through the
                   active local backend (whisper / parakeet) and saves
                   the transcript to History. -->
              <TextBlock Text="TRANSCRIBE A FILE"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,20,0,8" />
              <!-- DragOver/Drop are wired in code-behind via AddHandler
                   with handledEventsToo=true: the parent ScrollViewer's
                   built-in drag-to-scroll marks DragOver as handled,
                   so the declarative attribute path never fires. -->
              <Border x:Name="FileLoadDropTarget"
                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="20,16"
                      AllowDrop="True">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Transcribe an audio file" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                            Width="18" Height="18" MinWidth="0" MinHeight="0"
                            VerticalAlignment="Center" VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center"
                            ToolTipService.ToolTip="Drag a file here or click Pick file. Works offline with your local model. Supports wav, mp3, m4a, aac, flac, opus, and ogg. The transcript lands in Recordings.">
                      <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                      <Button.Flyout>
                        <Flyout>
                          <StackPanel MaxWidth="300" Spacing="10">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       Text="Drag a file here or click Pick file. Works offline with your local model. Supports wav, mp3, m4a, aac, flac, opus, and ogg. The transcript lands in Recordings." />
                            <HyperlinkButton Content="Open full guide →" Padding="0" NavigateUri="https://dimmy.app/help/first-dictation" />
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button x:Name="FileLoadPickBtn" Click="FileLoadPick_Click">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                        <TextBlock Text="Pick file..."/>
                      </StackPanel>
                    </Button>
                    <ProgressRing x:Name="FileLoadProgress"
                                  IsActive="False" Visibility="Collapsed"
                                  Width="20" Height="20" />
                    <TextBlock x:Name="FileLoadStatus" Text=""
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <ProgressBar x:Name="FileLoadBar"
                               Visibility="Collapsed"
                               Minimum="0" Maximum="100" Value="0"
                               Margin="0,4,0,0"/>
                  <TextBox x:Name="FileLoadResult"
                           Visibility="Collapsed"
                           IsReadOnly="True"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinHeight="120"
                           MaxHeight="240"
                           Margin="0,8,0,0" />
                  <!-- Promote to a meeting: writes a synthetic
                       meeting dir with the transcript + WAV, then
                       runs the same LLM recap pipeline used by live
                       meetings. Result lands in Meeting → History. -->
                  <StackPanel x:Name="FileLoadRecapPanel"
                              Visibility="Collapsed"
                              Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button x:Name="FileLoadRunRecapBtn" Click="FileLoadRunRecap_Click">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8FD;" FontSize="14"/>
                        <TextBlock Text="Run recap as meeting"/>
                      </StackPanel>
                    </Button>
                    <ProgressRing x:Name="FileLoadRecapProgress"
                                  IsActive="False" Visibility="Collapsed"
                                  Width="18" Height="18" />
                    <TextBlock x:Name="FileLoadRecapStatus"
                               VerticalAlignment="Center"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </StackPanel>
              </Border>
                </StackPanel>
              </Grid>

              <!-- System group: theme + launch-at-login — Advanced-gated. -->
              <StackPanel Spacing="4"
                          Visibility="{Binding IsAdvanced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="SYSTEM"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           CharacterSpacing="40" Margin="2,20,0,8" />
                <controls:SettingCard Glyph="&#xE790;"
                                      Label="Theme"
                                      InfoTip="Sets the look of the Settings window. Auto follows your Windows theme.">
                  <StackPanel x:Name="ThemeRadioPanel" Orientation="Horizontal" Spacing="12">
                    <RadioButton Content="Auto" GroupName="Theme" Tag="Default" Checked="Theme_Checked" Style="{StaticResource ChoiceRadioButton}" />
                    <RadioButton Content="Light" GroupName="Theme" Tag="Light" Checked="Theme_Checked" Style="{StaticResource ChoiceRadioButton}" />
                    <RadioButton Content="Dark" GroupName="Theme" Tag="Dark" Checked="Theme_Checked" Style="{StaticResource ChoiceRadioButton}" />
                  </StackPanel>
                </controls:SettingCard>
                <controls:SettingCard Glyph="&#xE7E8;"
                                      Label="Launch at login"
                                      InfoTip="Dimmy starts with Windows and waits quietly for your shortcut.">
                  <ToggleSwitch IsOn="{Binding AutostartEnabled, Mode=TwoWay}"
                                Style="{StaticResource CompactToggleSwitch}" />
                </controls:SettingCard>
              </StackPanel>
            </StackPanel>

            <!-- ═══ Providers & keys — one card per AI provider. Cards + the
                 advanced per-task override are built in code-behind
                 (BuildProviderCards) so there is no DataTemplate/XAML-compiler
                 surface; this panel is just the host + title. ═══ -->
            <StackPanel x:Name="ProvidersPanel" Spacing="4" Visibility="Collapsed">
              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Text="Providers &amp; keys" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Add an API key to switch a provider on. Models and settings are handled for you. On-device works with no key at all."
                           FontSize="13" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
              <StackPanel x:Name="ProviderCardsHost" Spacing="10" />
              <TextBlock x:Name="ProviderKeysFootnote"
                         Text="&#x1F512; Keys are stored encrypted on this device (AES-256) and only ever sent to the provider you choose."
                         FontSize="12" TextWrapping="Wrap" Margin="2,16,0,0"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- ═══ Voice input (was General) — STT settings ═══ -->
            <StackPanel x:Name="GeneralPanel" Spacing="4" Visibility="Collapsed">
              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Text="Voice input" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="How Dimmy hears and transcribes your voice."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>

              <!-- Group: Language -->
              <TextBlock Text="LANGUAGE"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,16,0,8" />
              <controls:SettingCard Glyph="&#xF2B7;"
                                    Label="Native language (you speak)"
                                    InfoTip="Tells the speech engine what to expect. To translate into another language, use the pill's scroll wheel instead."
                                    HelpUrl="https://dimmy.app/help/language">
                <ComboBox x:Name="LanguageComboBox" MinWidth="{StaticResource SettingFieldWidth}"
                          DisplayMemberPath="Value"
                          ItemsSource="{Binding LanguageItems}"
                          SelectionChanged="Language_SelectionChanged" />
              </controls:SettingCard>

              <!-- Group: Speech-to-text -->
              <TextBlock Text="SPEECH-TO-TEXT"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,20,0,8" />
              <controls:SettingCard Glyph="&#xE753;"
                                    Label="Mode"
                                    InfoTip="Local is fully private and works offline. Cloud sends your audio to the provider you pick and is often more accurate."
                                    HelpUrl="https://dimmy.app/help/local-mode">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <RadioButton x:Name="SttModeLocal" Content="Local" GroupName="SttMode"
                               Style="{StaticResource ChoiceRadioButton}"
                               Checked="SttMode_Checked" Tag="local" />
                  <RadioButton x:Name="SttModeCloud" Content="Cloud" GroupName="SttMode"
                               Style="{StaticResource ChoiceRadioButton}"
                               Checked="SttMode_Checked" Tag="cloud" />
                </StackPanel>
              </controls:SettingCard>
              <!-- API key card lives inside the Cloud panel below — only
                   shown when Cloud mode is selected, since Local doesn't
                   need one. -->

              <!-- Local STT (when Local selected) -->
              <StackPanel x:Name="LocalSttPanel" Spacing="4">
                <controls:SettingCard Glyph="&#xE968;"
                                      Label="Local model"
                                      InfoTip="Whisper sizes run fully offline. Parakeet TDT v3 is faster and strong on European languages, but it downloads once at about 2.5 GB."
                                      HelpUrl="https://dimmy.app/help/whisper-models">
                  <!-- Width is FIXED (not MinWidth) so long model names
                       like "ggml-large-v3-turbo-q5_0.bin" don't expand
                       the combo and shove the SettingCard layout out of
                       alignment. Header truncates with TextTrimming on
                       the item template; full text shows in the popup. -->
                  <ComboBox x:Name="LocalModelComboBox"
                            Width="{StaticResource SettingFieldWidth}" MaxWidth="{StaticResource SettingFieldWidth}"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            SelectionChanged="LocalModel_SelectionChanged" />
                </controls:SettingCard>
                <controls:SettingCard Glyph="&#xE946;"
                                      Label="Model status">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="LocalModelStatus" Text="Checking..."
                               FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" />
                    <Button x:Name="DownloadModelBtn" Content="Download"
                            Click="DownloadModel_Click" Visibility="Collapsed" />
                    <ProgressBar x:Name="DownloadProgress" Width="180"
                                 Minimum="0" Maximum="100" Visibility="Collapsed" />
                  </StackPanel>
                </controls:SettingCard>
                <controls:SettingCard Glyph="&#xE74D;"
                                      Label="Remove filler words"
                                      InfoTip="Removes common filler words in 6 languages (including Italian 'cioè', 'ecc.') after transcription."
                                      HelpUrl="https://dimmy.app/help/filler-removal">
                  <ToggleSwitch IsOn="{Binding FillerRemovalEnabled, Mode=TwoWay}"
                                Style="{StaticResource CompactToggleSwitch}" />
                </controls:SettingCard>
              </StackPanel>

              <!-- Cloud STT (when Cloud selected). Order matches the
                   Output → LLM section for visual uniformity:
                     1. Provider (the model picker — what you pick
                        determines the URL Dimmy talks to)
                     2. API key
                     3. Custom URL/Model (conditional, only when
                        Provider == Custom endpoint)
                   The "Prompt / vocabulary" card sits in its own
                   section below — it's not strictly STT auth, it's
                   recognition biasing. -->
              <StackPanel x:Name="CloudSttPanel" Spacing="4" Visibility="Collapsed">
                <controls:SettingCard Glyph="&#xE968;"
                                      Label="Provider"
                                      InfoTip="The model you pick sets where your audio is sent. Free options are marked."
                                      HelpUrl="https://dimmy.app/help/cloud-providers">
                  <ComboBox x:Name="ProviderComboBox" MinWidth="{StaticResource SettingFieldWidth}"
                            SelectionChanged="Provider_SelectionChanged">
                    <ComboBoxItem Tag="groq">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/groq.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="Groq · whisper-large-v3-turbo (free)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="groq-v3">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/groq.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="Groq · whisper-large-v3 (free)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <!-- "Groq · distil-whisper-en" removed 2026-05-15 —
                         Groq decommissioned the distil-whisper-large-v3-en
                         model (HTTP 400 model_decommissioned). Saved
                         configs that still point at it are migrated to
                         whisper-large-v3-turbo by
                         SettingsViewModel.LoadFromJson + the Rust core
                         `migrate_decommissioned_models` helper. -->
                    <ComboBoxItem Tag="openai">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/openai.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="OpenAI · whisper-1" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="openai-4o">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/openai.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="OpenAI · gpt-4o-transcribe" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="openai-4o-mini">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/openai.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="OpenAI · gpt-4o-mini-transcribe" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="deepgram">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/deepgram.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="Deepgram · nova-3" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="deepgram-nova2">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/deepgram.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="Deepgram · nova-2" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <!-- STT only shows Flash variants — Pro is slower
                         and pricier without meaningful accuracy gain
                         for transcription. Pro stays in the LLM
                         dropdown (Output → LLM) for rewrite + recap. -->
                    <ComboBoxItem Tag="gemini-3.1-flash-lite">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/gemini.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="Gemini · 3.1-flash-lite (newest fast)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="gemini-3-flash">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/gemini.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="Gemini · 3-flash-preview" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="gemini-2.5-flash">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/gemini.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="Gemini · 2.5-flash (stable fast)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="fireworks">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/fireworks.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="Fireworks · whisper-v3-turbo" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="together-parakeet">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/together.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="Together · parakeet-tdt-0.6b-v3" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="together-whisper">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/together.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="Together · whisper-large-v3" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="custom">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71B;" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Custom endpoint" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                  </ComboBox>
                </controls:SettingCard>
                <!-- Custom-endpoint key only. Catalog providers (Groq,
                     OpenAI, …) get their key from the Providers & keys page,
                     so this card is shown ONLY when Provider = Custom (the
                     one case Providers can't cover — it needs a base URL). -->
                <controls:SettingCard x:Name="SttApiKeyCard"
                                      Glyph="&#xE192;"
                                      Label="API key"
                                      InfoTip="The key for your custom speech endpoint. Stored encrypted on this device with AES-256. Catalog providers are keyed from the Providers and keys page instead."
                                      HelpUrl="https://dimmy.app/help/api-keys"
                                      Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="#4ade80"
                              VerticalAlignment="Center"
                              Visibility="{Binding HasApiKey, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <PasswordBox x:Name="CloudApiKeyBox" Width="{StaticResource SettingFieldWidth}"
                                 PlaceholderText="{Binding HasApiKey, Mode=OneWay, Converter={StaticResource BoolToApiKeyPlaceholder}}" />
                  </StackPanel>
                </controls:SettingCard>
                <controls:SettingCard x:Name="CustomUrlCard"
                                      Glyph="&#xE71B;"
                                      Label="Custom endpoint URL"
                                      InfoTip="Used only when Provider is set to Custom. Point it at any OpenAI-compatible speech endpoint."
                                      HelpUrl="https://dimmy.app/help/cloud-providers"
                                      Visibility="Collapsed">
                  <TextBox x:Name="CustomUrlBox" MinWidth="{StaticResource SettingFieldWidth}"
                           Text="{Binding ApiUrl, Mode=TwoWay}" />
                </controls:SettingCard>
                <controls:SettingCard x:Name="CustomModelCard"
                                      Glyph="&#xE950;"
                                      Label="Custom model"
                                      InfoTip="The model identifier your custom endpoint expects."
                                      HelpUrl="https://dimmy.app/help/cloud-providers"
                                      Visibility="Collapsed">
                  <TextBox x:Name="CustomModelBox" MinWidth="{StaticResource SettingFieldWidth}"
                           Text="{Binding ApiModel, Mode=TwoWay}" />
                </controls:SettingCard>
              </StackPanel>
              <!-- /CloudSttPanel -->

              <!-- Vocabulary / recognition prompt — separate section so
                   the user sees auth (Provider + key) clean and only
                   then runs into the optional biasing field. Same
                   visibility gating as CloudSttPanel (cloud-only).
                   The CustomDictionary section below this is the
                   per-word hotkey-add list — different concept. -->
              <!-- Outer wrapper = Advanced gate; inner CloudVocabularyPanel keeps
                   its cloud-only visibility (set in code-behind). Shows only when
                   Advanced AND cloud STT. -->
              <StackPanel Visibility="{Binding IsAdvanced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel x:Name="CloudVocabularyPanel" Spacing="4" Visibility="Collapsed">
                  <TextBlock Text="VOCABULARY"
                             FontSize="12" FontWeight="SemiBold"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             CharacterSpacing="40" Margin="2,20,0,8" />
                  <controls:SettingCard Glyph="&#xE82D;"
                                        Label="Recognition prompt"
                                        InfoTip="Optional. Add names, jargon, or brand spellings so they're transcribed the way you mean."
                                        HelpUrl="https://dimmy.app/help/cloud-providers">
                    <TextBox MinWidth="{StaticResource SettingFieldWidth}" MaxWidth="{StaticResource SettingFieldWidth}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                             Text="{Binding Prompt, Mode=TwoWay}" />
                  </controls:SettingCard>
                </StackPanel>
              </StackPanel>

              <!-- Microphone. The Input-device picker is ESSENTIAL (you can't
                   capture audio from the wrong mic) so it lives in Simple. The
                   tuning knobs (gain / preprocessing / chunk / captions) stay
                   behind Advanced. -->
              <StackPanel Spacing="4">
                <TextBlock Text="MICROPHONE"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           CharacterSpacing="40" Margin="2,20,0,8" />
                <!-- Audio source picker removed 2026-05-08: always-mix capture
                     (commit 3eddac3). Pill = mic-only, meeting = both, AEC3
                     degrades when loopback is silent. -->
                <controls:SettingCard Glyph="&#xE720;"
                                      Label="Input device"
                                      InfoTip="System audio loopback (used for meetings) always records from your default playback device, whatever you pick here."
                                      HelpUrl="https://dimmy.app/help/audio-input">
                  <ComboBox MinWidth="{StaticResource SettingFieldWidth}"
                            SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                            ItemsSource="{Binding Devices}" />
                </controls:SettingCard>

                <!-- Advanced mic tuning -->
                <StackPanel Spacing="4"
                            Visibility="{Binding IsAdvanced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                  <controls:SettingCard Glyph="&#xE992;"
                                        Label="Microphone volume"
                                        InfoTip="Raises your input level so soft speech is picked up. Leave it low if your mic is already loud."
                                        HelpUrl="https://dimmy.app/help/audio-input">
                    <Slider x:Name="InputGainSlider" MinWidth="{StaticResource SettingFieldWidth}"
                            Minimum="10" Maximum="100" StepFrequency="5"
                            Value="{Binding InputGainPercent, Mode=TwoWay}" />
                  </controls:SettingCard>
                  <controls:SettingCard Glyph="&#xE9F5;"
                                        Label="Preprocessing"
                                        InfoTip="Runs a high pass filter, voice activity detection, and automatic gain control. Leave it on unless you are debugging audio."
                                        HelpUrl="https://dimmy.app/help/audio-input">
                    <ToggleSwitch IsOn="{Binding PreprocessingEnabled, Mode=TwoWay}"
                                  Style="{StaticResource CompactToggleSwitch}" />
                  </controls:SettingCard>
                  <controls:SettingCard Glyph="&#xE7F2;"
                                        Label="Chunk streaming (Parakeet only)"
                                        InfoTip="Transcribes while you speak, so the final text lands about 700 ms after you release the key instead of waiting for the whole clip. Needs the Parakeet local backend.">
                    <ToggleSwitch IsOn="{Binding ChunkStreamingEnabled, Mode=TwoWay}"
                                  Style="{StaticResource CompactToggleSwitch}" />
                  </controls:SettingCard>
                  <controls:SettingCard Glyph="&#xE890;"
                                        Label="Live captions"
                                        InfoTip="Shows a floating caption while chunk streaming is on. Turn it off to keep the speed without showing text on screen.">
                    <ToggleSwitch IsOn="{Binding LiveCaptionsEnabled, Mode=TwoWay}"
                                  Style="{StaticResource CompactToggleSwitch}" />
                  </controls:SettingCard>
                </StackPanel>
              </StackPanel>

              <!-- ═══ Custom dictionary ═══ — Advanced-gated per the settings map. -->
              <StackPanel Visibility="{Binding IsAdvanced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
              <TextBlock Text="CUSTOM DICTIONARY"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,20,0,8" />
              <TextBlock Text="Teach Dimmy your names, jargon, and acronyms."
                         FontSize="12"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         TextWrapping="Wrap" Margin="2,0,0,8" />

              <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="6"
                      Padding="14" Margin="0,8,0,0">
                <StackPanel Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="DictAddTextBox"
                             PlaceholderText="word or short phrase"
                             MinWidth="240"
                             KeyDown="DictAddTextBox_KeyDown"/>
                    <Button x:Name="DictAddBtn" Content="Add"
                            Click="DictAdd_Click"
                            Style="{ThemeResource AccentButtonStyle}"/>
                    <TextBlock x:Name="DictStatusText"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </StackPanel>
                  <ListView x:Name="DictListView"
                            ItemsSource="{Binding UserDict}"
                            SelectionMode="None"
                            MaxHeight="280">
                    <ListView.ItemContainerStyle>
                      <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                      </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                      <DataTemplate>
                        <Grid Padding="8,4" ColumnSpacing="8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding}"
                                     VerticalAlignment="Center" FontSize="13"/>
                          <Button Grid.Column="1" Tag="{Binding}"
                                  Click="DictRemove_Click"
                                  ToolTipService.ToolTip="Remove from dictionary"
                                  Padding="6,4">
                            <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                  <TextBlock x:Name="DictEmptyHint"
                             Text="No words yet. Add one above or press the shortcut after selecting text anywhere."
                             FontSize="12"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             TextWrapping="Wrap"
                             Visibility="Collapsed"/>
                </StackPanel>
              </Border>
              </StackPanel>
            </StackPanel>

            <!-- ═══ Shortcut ═══ -->
            <StackPanel x:Name="ShortcutPanel" Spacing="4" Visibility="Collapsed">
              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Text="Shortcut" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="The hotkey that starts and stops recording."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>

              <TextBlock Text="HOTKEY"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,16,0,8" />
              <controls:SettingCard Glyph="&#xE765;"
                                    Label="Recording shortcut"
                                    InfoTip="Press the keys you want, then release to confirm. This is the shortcut you press to dictate."
                                    HelpUrl="https://dimmy.app/help/hotkey-change">
                <controls:ShortcutRecorder Shortcut="{Binding Shortcut, Mode=TwoWay}" />
              </controls:SettingCard>
              <controls:SettingCard Glyph="&#xE7C8;"
                                    Label="Mode"
                                    InfoTip="Push-to-Talk records only while you hold the keys. Toggle starts on one press and stops on the next."
                                    HelpUrl="https://dimmy.app/help/hotkey-modes">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <RadioButton Content="Push-to-Talk" GroupName="ShortcutMode"
                               Style="{StaticResource ChoiceRadioButton}"
                               IsChecked="{Binding ShortcutMode, Mode=TwoWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=hold}" />
                  <RadioButton Content="Toggle" GroupName="ShortcutMode"
                               Style="{StaticResource ChoiceRadioButton}"
                               IsChecked="{Binding ShortcutMode, Mode=TwoWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=toggle}" />
                </StackPanel>
              </controls:SettingCard>
              <controls:SettingCard Glyph="&#xE945;"
                                    Label="Command mode shortcut"
                                    InfoTip="Optional. A dedicated key that runs ONE command (transform the selected text, or generate and insert when nothing is selected) and then goes back to normal dictation. Leave it unset to use command mode only from the pill menu, where it stays on until you turn it off."
                                    HelpUrl="https://dimmy.app/help/hotkey-change">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Content="Clear" Click="CommandHotkeyClear_Click"
                          VerticalAlignment="Center" />
                  <controls:ShortcutRecorder Shortcut="{Binding CommandHotkey, Mode=TwoWay}" RequireKey="True" />
                </StackPanel>
              </controls:SettingCard>

              <TextBlock Text="DICTIONARY"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,20,0,8" />
              <controls:SettingCard Glyph="&#xE82D;"
                                    Label="Add-to-dictionary shortcut"
                                    InfoTip="Select text in any app and press these keys to add it to your custom dictionary. Press the keys here, then release to confirm."
                                    HelpUrl="https://dimmy.app/help/hotkey-change">
                <controls:ShortcutRecorder Shortcut="{Binding DictHotkey, Mode=TwoWay}" RequireKey="True" />
              </controls:SettingCard>
            </StackPanel>

            <!-- ═══ Output ═══ -->
            <StackPanel x:Name="OutputPanel" Spacing="4" Visibility="Collapsed">
              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Text="Output" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="How Dimmy rewrites and delivers your dictation."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>

              <TextBlock Text="LLM ENHANCEMENT"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,16,0,8" />
              <controls:SettingCard Glyph="&#xE945;"
                                    Label="Style"
                                    InfoTip="An LLM cleans up or reshapes your transcript. Off leaves it exactly as spoken."
                                    HelpUrl="https://dimmy.app/help/styles">
                <ComboBox MinWidth="{StaticResource SettingFieldWidth}"
                          SelectedItem="{Binding LlmStyle, Mode=TwoWay}"
                          ItemsSource="{Binding LlmStyleItems}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                 Fill="{Binding Converter={StaticResource StyleToColorBrush}}" />
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </controls:SettingCard>

              <TextBlock Text="LLM MODE"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         CharacterSpacing="40" Margin="2,20,0,8" />
              <controls:SettingCard Glyph="&#xE753;"
                                    Label="Mode"
                                    InfoTip="Local runs the LLM on your device and stays private. Cloud sends your transcript to the provider you pick."
                                    HelpUrl="https://dimmy.app/help/local-llm">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <RadioButton x:Name="LlmModeLocal" Content="Local" GroupName="LlmMode"
                               Style="{StaticResource ChoiceRadioButton}"
                               Checked="LlmMode_Checked" Tag="local" />
                  <RadioButton x:Name="LlmModeCloud" Content="Cloud" GroupName="LlmMode"
                               Style="{StaticResource ChoiceRadioButton}"
                               Checked="LlmMode_Checked" Tag="cloud" />
                </StackPanel>
              </controls:SettingCard>

              <!-- Local LLM cards -->
              <StackPanel x:Name="LocalLlmPanel" Spacing="4" Visibility="Collapsed">
                <controls:SettingCard Glyph="&#xE968;"
                                      Label="Local LLM model"
                                      InfoTip="Runs fully offline. Larger models read better but need more memory and time."
                                      HelpUrl="https://dimmy.app/help/local-llm">
                  <!-- Same width-locking pattern as LocalModelComboBox:
                       prevents long quantization suffixes like
                       "gemma-3-4b-it-q4_0.gguf" from expanding the row. -->
                  <ComboBox x:Name="LocalLlmModelComboBox"
                            Width="{StaticResource SettingFieldWidth}" MaxWidth="{StaticResource SettingFieldWidth}"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            SelectionChanged="LocalLlmModel_SelectionChanged" />
                </controls:SettingCard>
                <controls:SettingCard Glyph="&#xE946;"
                                      Label="Local LLM status">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="LocalLlmModelStatus" Text="Checking..."
                               FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" />
                    <Button x:Name="DownloadLlmModelBtn" Content="Download"
                            Click="DownloadLlmModel_Click" Visibility="Collapsed" />
                    <ProgressBar x:Name="DownloadLlmProgress" IsIndeterminate="True"
                                 Width="120" Visibility="Collapsed" />
                  </StackPanel>
                </controls:SettingCard>
              </StackPanel>

              <!-- Cloud LLM cards -->
              <StackPanel x:Name="CloudLlmPanel" Spacing="4">
                <controls:SettingCard Glyph="&#xE968;"
                                      Label="Cloud LLM provider"
                                      InfoTip="The model you pick sets where your transcript is sent. Free options are marked."
                                      HelpUrl="https://dimmy.app/help/cloud-providers">
                  <ComboBox x:Name="LlmProviderComboBox" MinWidth="{StaticResource SettingFieldWidth}"
                            SelectionChanged="LlmProvider_SelectionChanged">
                    <ComboBoxItem Tag="groq">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/groq.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="Groq · llama-3.3-70b (free)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="groq-gptoss120b">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/groq.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="Groq · gpt-oss-120b (top quality)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="groq-llama4scout">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/groq.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="Groq · llama-4-scout-17b (MoE, balanced)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="groq-llama8binstant">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/groq.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="Groq · llama-3.1-8b instant (fastest)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="groq-qwen3-32b">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/groq.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="Groq · qwen3-32b (multilingual)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="openai">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/openai.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="OpenAI · gpt-5-mini (fast + cheap)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="openai-gpt5">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/openai.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="OpenAI · gpt-5 (top)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="openai-gpt51">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/openai.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="OpenAI · gpt-5.1 (latest)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="openai-4o-mini">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/openai.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="OpenAI · gpt-4o-mini (legacy)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="openrouter">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/openrouter.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="OpenRouter · llama-3.3-70b (free)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="openrouter-deepseek">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/openrouter.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="OpenRouter · DeepSeek R1 (free)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="gemini-3.1-pro">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/gemini.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="Gemini · 3.1-pro-preview (newest top)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="gemini-3.1-flash-lite">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="16" Height="16">
                          <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Providers/gemini.svg"/></Image.Source>
                        </Image>
                        <TextBlock Text="Gemini · 3.1-flash-lite (newest fast)" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="gemini-3-pro">
