                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    ToolTipService.ToolTip="Remove">
                              <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE894;" FontSize="10" />
                            </Button>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </controls:SettingCard>
              </StackPanel>

              <!-- ═══ Meetings storage section ═══ -->
