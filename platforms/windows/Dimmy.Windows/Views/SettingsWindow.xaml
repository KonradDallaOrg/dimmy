              <StackPanel Spacing="4"
                          Visibility="{Binding IsAdvanced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="ADVANCED LLM"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           CharacterSpacing="40" Margin="2,20,0,8" />
                <controls:SettingCard Glyph="&#xE76C;"
                                      Label="Tone"
                                      InfoTip="Nudges the rewrite warmer or more businesslike, on top of the style you chose."
                                      HelpUrl="https://dimmy.app/help/tones">
                  <ComboBox MinWidth="{StaticResource SettingFieldWidth}"
                            SelectedItem="{Binding LlmTone, Mode=TwoWay}"
                            ItemsSource="{Binding LlmToneItems}" />
                </controls:SettingCard>
                <controls:SettingCard Glyph="&#xF2B7;"
                                      Label="Translate output to"
                                      InfoTip="Speak in your language and Dimmy pastes the translation. The pill's scroll wheel changes the same setting."
